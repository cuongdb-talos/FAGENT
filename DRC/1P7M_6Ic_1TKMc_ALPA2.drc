    (EXT M6DUM wide_M6 < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M6DUMCK_S_9 {
    @ Space between dummy metal and 45 degree edge of metal (Mn).>= 0.4um
    45d_M6_EXP = EXPAND EDGE 45d_M6 OUTSIDE BY 0.4
    (45d_M6_EXP NOT OUTSIDE (45d_M6_EXP AND M6DUM)) NOT INSIDE EXCLU
}
M6DUMCK_EN_10 {
    @ Chip edge(BORDER) enclosure of dummy metal>= 2.5um
    (ENC M6DUM BORDER < 2.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M6DUM NOT BORDER) NOT INSIDE EXCLU
}
M6DUMCK_EN_10a {
    @ Chip edge(BORDER) enclosure of dummy metal. (For MnDUMCK.W.1a)>= 10um
    (ENC M6DUM_max BORDER < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M6DUMCK_S_11 {
    @ Space between dummy metal and LOGO/FUSEMK1/MARKF/MARKS/MARKG/DUMBM/MnDUB/NODMF/INDMY/MOMDMY (For MnDUMCK.W.1a)>= 10um
    (EXT M6DUM_max LOGO < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max FUSEMK1 < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max MARKF < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max MARKS < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT M6DUM_max MARKG < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max DUMBM < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max M6DUB < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max NODMF < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max INDMY < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M6DUM_max MOMDMY < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M6DUMCK_R_12 {
    @ Mn dummy metal cannot be interacted with Mn main patterns.
    @ Noteï¼n=1, 2, 3, 4, 5, 6, 7, 8
    (M6DUM INTERACT M6) NOT INSIDE EXCLU
}
GROUP GTKMDUMCK TKMDUMCK_?
TKMDUMCK_W_1_L_2 {
    @ TKMDUMCK_W_1: Dummy metal width = 2.8um
    @ TKMDUMCK_L_2: Dummy metal length = 2.8um
    (NOT RECTANGLE TKMDUM == 2.8 BY == 2.8) NOT INSIDE EXCLU
}
TKMDUMCK_S_3 {
    @ Space between two Dummy metals>= 2.8um
    (EXT TKMDUM < 2.8 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
TKMDUMCK_S_4 {
    @ Space between dummy metal and TKM pattern>= 2.8um
    (EXT TKMDUM TKM < 2.8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
TKMDUMCK_S_6 {
    @ Space between dummy metal and the TKMDB/DUMBM/NODMF/MOMDMY.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by TKMDB/DUMBM/NODMF/MOMDMY.>= 2um
    (EXT TKMDUM TKMDB < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM DUMBM < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM NODMF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM MOMDMY < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
TKMDUMCK_S_7 {
    @ Space between dummy metal and MARKS/MARKG/FUSEMK1/MARKF/INDMY.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by MARKS/MARKG/FUSEMK1/MARKF/INDMY.>= 3um
    (EXT TKMDUM MARKS < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT TKMDUM MARKG < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM FUSEMK1 < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM MARKF < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT TKMDUM INDMY < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
TKMDUMCK_S_8 {
    @ Space between dummy metal and LOGO.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by LOGO.>= 0.1um
    (EXT TKMDUM LOGO < 0.1 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
TKMDUMCK_EN_9 {
    @ Chip edge(BORDER) enclosure of dummy metal.>= 2.5um
    (ENC TKMDUM BORDER < 2.5 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLU
}
TKMDUMCK_R_10 {
    @ TKM dummy metal cannot be interacted with TKM main patterns.
    (TKMDUM INTERACT TKM) NOT INSIDE EXCLU
}
GROUP GConvention Convention_?
#IFDEF GUIXI_SPECIAL NO
Convention_R_1 {
@ NW not interacting with N+ pickup is not allowed, except AA resistor region and 1.2V N+/Rwell diode ((NW INTERACT (DNW INTERACT DSTR)) NOT INTERACT SN).
  X = (NW INTERACT (DNW INTERACT DSTR)) NOT INTERACT SN
  NW_CHECK = (NW NOT X) NOT INTERACT RESAA
  (NW_CHECK NOT INTERACT NTAP) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
Convention_R_1a {
@ NW not interacting with N+ pickup is not allowed, except AA resistor region,poly resistor region and 1.2V N+/Rwell diode ((NW INTERACT (DNW INTERACT DSTR)) NOT INTERACT SN).
  X = (NW INTERACT (DNW INTERACT DSTR)) NOT INTERACT SN
  NW_CHECK = ((NW NOT X) NOT INTERACT RESAA)NOT INTERACT RESP1
  (NW_CHECK NOT INTERACT NTAP) NOT INSIDE EXCLU
}
#ENDIF
Convention_R_2 {
@ PMOS in PW is not allowed, except LDBK and VARMOS region.
  PGT = PACT INTERACT GATE
 (PW AND ((PGT NOT LDBK) NOT VARMOS)) NOT INSIDE EXCLU
}
Convention_R_3 {
@ AA must be fully enclosed by (SN OR SP), except NW resistor region.
  X = AA NOT INTERACT (RESNW AND NW)
  ((X NOT SN) NOT SP) NOT INSIDE EXCLU
}
GROUP GRESAA RESAA_?
AAR_SA = AAR AND SAB
AAR_NS = NOT INTERACT AAR SAB
#IFDEF GUIXI_SPECIAL NO
RESAA_W_1 {
@ Width of non-silicide AA resistor>= 0.4um
  X = (RESAA AND AA) AND SAB
  L = X INSIDE EDGE AA
  (LENGTH L < 0.4) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESAA_W_1a {
@ Width of non-silicide AA resistor>= 0.36um
  X = (RESAA AND AA) AND SAB
  L = X INSIDE EDGE AA
  (LENGTH L < 0.36) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
RESAA_R_1a_R {
    @ Suggest the Nsq >= 1 for stable Resistivity>= 1
    X = RESAA AND SAB
    Y = (AA AND RESAA) AND SAB
    L = (INSIDE EDGE AA X) OR EDGE (AA COIN EDGE X)
    W = INSIDE EDGE Y AA
    (DFM PROPERTY Y L W OVERLAP ABUT ALSO [SQUARES = LENGTH(L)/LENGTH(W)] < 1) NOT INSIDE EXCLU
}
#ENDIF
RESAA_R_2 {
@ Non-silicide AA resistor region should be covered by SAB and implanted by SN or SP.
  X = AAR INTERACT SAB
  (X NOT (OR SN SP)) NOT INSIDE EXCLU
}
RESAA_R_3 {
@ Dummy layer RESAA is drawn to block LDD implant in the resistor area according to LOTA table.
  X = RESAA INTERACT SAB
  (AND NLL X) NOT INSIDE EXCLU
  (AND NLH X) NOT INSIDE EXCLU
  (AND PLL X) NOT INSIDE EXCLU
  (AND PLH X) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
RESAA_R_4_R {
@ Dog-bone design at the end of AA resistor for contact pick-up is not suggested.
  X = AAR INTERACT SAB
  (CONVEX EDGE X ==1) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL NO
RESAA_S_5_SN {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = SN NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_SP {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = SP NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_NW {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = NW NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_VTNH {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = VTNH NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_VTPH {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = VTPH NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_LVN {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = LVN NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_LVP {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = LVP NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5_ESD1 {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.2um
    X = ESD1 NOT INTERACT RESAA
    (EXT X AAR_SA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESAA_S_5a_SN {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = SN NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_SP {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = SP NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_NW {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = NW NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_VTNH {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = VTNH NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_VTPH {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = VTPH NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_LVN {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = LVN NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_LVP {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = LVP NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
RESAA_S_5a_ESD1 {
    @ Space between non-silicide AA resistors area and other implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.18um
    X = ESD1 NOT INTERACT RESAA
    (EXT X AAR_SA < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL NO
RESAA_EX_6 {
@ Extension of RESAA outside of non-silicide AA resistor area>= 0.2um
  X = AAR_SA COIN EDGE AA
  (ENC X RESAA < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESAA_EX_6a {
@ Extension of RESAA or RESP3T outside of non-silicide AA resistor area>= 0.2um
  X = AAR_SA COIN EDGE AA
  (ENC X (OR RESAA RESP3T) < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
#ENDIF
RESAA_R_7 {
@ Non-silicide AA resistor with SP must be inside NW
  (((AAR INTERACT SAB) AND SP) NOT INSIDE NW) NOT INSIDE EXCLU
}
RESAA_R_8 {
@ For Silicide AA resistor, two sides of RESAA must be along the CT edge.
  X = CT AND AAR_NS
  Y = (RESAA NOT INTERACT SAB) INSIDE EDGE AA
  (Y NOT TOUCH EDGE X ) NOT INSIDE EDGE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RESAA_S_9 {
@ Space between SAB and CT for non-silicide AA resistor= 0.2um
  X = AAR INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.2) NOT TOUCH AAR_SA) NOT INSIDE EXCLU
}
RESAA_EN_10 {
@ SP/SN enclosure of resistor AA>= 0.16um
  X = SP OR SN
  (ENC (AA AND RESAA) X < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESAA_S_9a {
@ Space between SAB and CT for non-silicide AA resistor= 0.18um
  X = AAR INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.18) NOT TOUCH AAR_SA) NOT INSIDE EXCLU
}
RESAA_EN_10a {
@ SP/SN enclosure of resistor AA>= 0.09um
  X = SP OR SN
  (ENC (AA AND RESAA) X < 0.09 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
GROUP GRNWA RESNWAA_?
#IFDEF GUIXI_SPECIAL NO
RESNWAA_W_1 {
@ NW-Resistor width >= 1.6um
 (LENGTH (NWAA_resistor INSIDE EDGE NW) < 1.6) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESNWAA_W_1a {
@ NW-Resistor width >= 1.5um
 (LENGTH (NWAA_resistor INSIDE EDGE NW) < 1.5) NOT INSIDE EDGE EXCLU
}
#ENDIF
RESNWAA_EN_2 {
@ AA enclosure of NW-Resistor>= 0.3um
 (ENC NWAA_resistor (AA ENCLOSE NWAA_resistor) < 0.3 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWAA_EN_3 {
@ SAB enclosure of AA >= 0.2um
 Y1 = AA ENCLOSE NWAA_resistor
 Y2 = SAB NOT COIN EDGE (HOLES SAB)
 (ENC Y1 Y2 < 0.2 ABUT<90 REGION) NOT INSIDE EDGE EXCLU
}
RESNWAA_EN_4 {
@ NW enclosure of CT >= 0.2um
 (ENC (CT AND (HOLES SAB)) (NW ENCLOSE NWAA_resistor) < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWAA_EN_5 {
@ Enclosure of SAB and related NW>= 0.2um
 X1 = HOLES SAB
 X2 = SAB TOUCH X1
 (ENC NWR X1 < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (ENC NWR X2 < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (((NWR INTERACT X1) NOT X1) NOT SAB) NOT INSIDE EXCLU
}
RESNWAA_O_6 {
@ RESNW must not overlap with dummy pattern and other implant layers(SN/SP/VTNH/VTPH/LVN/LVP/ESD1) in the resistor area.
 RESNW_NWAAR = RESNW INTERACT NWAA_resistor
 (RESNW_NWAAR AND AADUM) NOT INSIDE EXCLU
 (RESNW_NWAAR AND GTDUM) NOT INSIDE EXCLU
 (RESNW_NWAAR AND VTNH) NOT INSIDE EXCLU
 (RESNW_NWAAR AND VTPH) NOT INSIDE EXCLU
 (RESNW_NWAAR AND LVN) NOT INSIDE EXCLU
 (RESNW_NWAAR AND LVP) NOT INSIDE EXCLU
 (RESNW_NWAAR AND SP) NOT INSIDE EXCLU
 (RESNW_NWAAR AND SN) NOT INSIDE EXCLU
 (RESNW_NWAAR AND ESD1) NOT INSIDE EXCLU
}
RESNWAA_S_7 {
@ Space between RESNW and silicided CT area= 0.2um
  X = HOLES (SAB INTERACT RESNW)
  ((SIZE X BY 0.2) NOT TOUCH RESNW) NOT INSIDE EXCLU
}
RESNWAA_S_8 {
@ Space between NW of NW resistors and un-related implant region (NW/SN/SP/VTNH/VTPH/LVN/LVP/ESD1)>= 0.6um
 X = NWR INTERACT (HOLES SAB)
 (EXT X (NW NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (VTNH NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (VTPH NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (LVN NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (LVP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (SN NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (SP NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 (EXT X (ESD1 NOT INTERACT NWR) < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWAA_EX_9 {
@ Extension of RESNW outside of AA>= 0.2um
  (ENC AA (RESNW INTERACT SAB) < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWAA_R_10 {
@ SAB must cover NW resistor except CT area
  X = RESNW ENCLOSE (RESNW AND AA)
  Y = (SAB OR (HOLES SAB)) INTERACT X
  (Y NOT ENCLOSE (RESNW AND NW)) NOT INSIDE EXCLU
}
RESNWAA_S_11 {
@ Space between RESNW and CT= 0.4um
  X = RESNW ENCLOSE (RESNW AND AA)
  Y = CT AND (AA INTERACT X)
  ((SIZE Y BY 0.4) NOT TOUCH X) NOT INSIDE EXCLU
}
RESNWAA_O_12 {
@ Overlap of a SN to SAB (SAB hole must be fully enclosed by SN)>= 0.2um
  SAB_NWR = SAB INTERACT NWR
  ((HOLES SAB_NWR) NOT SN) NOT INSIDE EXCLU
  (INT SN SAB_NWR < 0.2 SINGULAR REGION) NOT INSIDE EXCLU
}
GROUP GRNWS RESNWST_?
NWRSTI = NWR NOT INTERACT SAB
#IFDEF GUIXI_SPECIAL NO
RESNWST_W_1 {
@ NW-Resistor width >= 1.6um
 (LENGTH (NWSTI_resistor INSIDE EDGE NW) < 1.6) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESNWST_W_1a {
@ NW-Resistor width >= 1.5um
 (LENGTH (NWSTI_resistor INSIDE EDGE NW) < 1.5) NOT INSIDE EDGE EXCLU
}
#ENDIF
RESNWST_S_2 {
@ Space between NW and adjacent AA>= 0.5um
 (EXT NWRSTI AA < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RESNWST_EN_3 {
@ CT enclosed by silicided AA>= 0.2um
 X = CT AND NWRSTI
 Y = AA INTERACT X
 (ENC X Y < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWST_EN_4 {
@ SN implant area enclosure of silicided AA>= 0.15um
 X = AA AND NWRSTI
 Y = SN INTERACT NWRSTI
 (ENC X Y < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWST_EN_5 {
@ NW enclosure of silicided AA area>= 0.2um
 X = AA AND NWRSTI
 Y = NW INTERACT NWRSTI
 (ENC X Y < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESNWST_EN_3a {
@ CT enclosed by silicided AA>= 0.03um
 X = CT AND NWRSTI
 Y = AA INTERACT X
 (ENC X Y < 0.03 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWST_EN_4a {
@ SN implant area enclosure of silicided AA>= 0.02um
 X = AA AND NWRSTI
 Y = SN INTERACT NWRSTI
 (ENC X Y < 0.02 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESNWST_EN_5 {
@ NW enclosure of silicided AA area>= 0.17um
 X = AA AND NWRSTI
 Y = NW INTERACT NWRSTI
 (ENC X Y < 0.17 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
RESNWST_S_6 {
@ Space between RESNW to silicided AA area= 0um
 X = RESNW INTERACT NWRSTI
 (AND X AA) NOT INSIDE EXCLU
 (X NOT TOUCH AA > 1) NOT INSIDE EXCLU
 ((X INSIDE EDGE NW) NOT TOUCH EDGE AA) NOT INSIDE EDGE EXCLU
}
RESNWST_O_7 {
@ RESNW must not overlap with dummy pattern and other implant layers(SP/VTNH/VTPH/LVN/LVP/ESD1) in the resistor area.
 RESNW_NWSTI = RESNW INTERACT NWSTI_resistor
 (RESNW_NWSTI AND AADUM) NOT INSIDE EXCLU
 (RESNW_NWSTI AND GTDUM) NOT INSIDE EXCLU
 (RESNW_NWSTI AND VTNH) NOT INSIDE EXCLU
 (RESNW_NWSTI AND VTPH) NOT INSIDE EXCLU
 (RESNW_NWSTI AND LVN) NOT INSIDE EXCLU
 (RESNW_NWSTI AND LVP) NOT INSIDE EXCLU
 (RESNW_NWSTI AND SP) NOT INSIDE EXCLU
 (RESNW_NWSTI AND ESD1) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RESNWST_EX_8 {
@ Extension of RESNW outside of NW>= 0.2um
  (ENC NW RESNW < 0.2 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESNWST_EX_8a {
@ RESNW extension of NW resistor along resistor width direction.>= 0um
  (INT (RESNW INSIDE EDGE NW) < 0.005 ABUT == 90 REGION) NOT INSIDE EXCLU
}
#ENDIF
RESNWST_R_9 {
@ No silicide is allowed on NW Resistor except for CT pick-up AA area.
 (NWSTI_resistor AND (AA NOT INTERACT CT)) NOT INSIDE EXCLU
}
GROUP GRESP1 RESP1_?
GTR_SA = GTR AND SAB
GTR_NS = GTR NOT INTERACT SAB
#IFDEF GUIXI_SPECIAL NO
RESP1_W_1 {
@ Width of non-silicide poly resistor>= 0.4um
  X = (RESP1 AND GT) AND SAB
  L = X INSIDE EDGE GT
  (LENGTH L < 0.4) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESP1_W_1a {
@ Width of non-silicide poly resistor>= 0.36um
  X = (RESP1 AND GT) AND SAB
  L = X INSIDE EDGE GT
  (LENGTH L < 0.36) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
RESP1_R_1a_R {
@ Suggest the Nsq >= 1 for stable Resistivity>= 1
  X = RESP1 AND SAB
  Y = (GT AND RESP1) AND SAB
  L = (INSIDE EDGE GT X) OR EDGE (GT COIN EDGE X)
  W = INSIDE EDGE Y GT
  (DFM PROPERTY Y L W OVERLAP ABUT ALSO [SQUARES = LENGTH(L)/LENGTH(W)] < 1) NOT INSIDE EXCLU
}
#ENDIF
RESP1_R_2 {
@ For non-silicide poly resistor, make sure the poly be covered by SAB and implanted by either SN or SP.
  X = GTR INTERACT SAB
  (X NOT (SN OR SP)) NOT INSIDE EXCLU
}
RESP1_R_3 {
@ Dummy layer RESP1 is drawn to block LDD implant in the resistor area according to LOTA table.
  X = RESP1 INTERACT GTR_SA
  (AND NLL X) NOT INSIDE EXCLU
  (AND NLH X) NOT INSIDE EXCLU
  (AND PLL X) NOT INSIDE EXCLU
  (AND PLH X) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
RESP1_R_4_R {
@ Dog-bone design at the end of non-silicide poly resistor for contact pick-up is not suggested.
  X = GTR INTERACT SAB
  (CONVEX EDGE X ==1) NOT INSIDE EDGE EXCLU
}
#ENDIF
RESP1_S_5_SP {
    @ Space between non-silicide poly resistors and un-related implant region (SN/SP/ESD1) (follow GT.S.10 rule)>= 0.16um
    X = SP NOT INTERACT RESP1
    (EXT X GTR_SA < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESP1_S_5_SN {
    @ Space between non-silicide poly resistors and un-related implant region (SN/SP/ESD1) (follow GT.S.10 rule)>= 0.16um
    X = SN NOT INTERACT RESP1
    (EXT X GTR_SA < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESP1_S_5_ESD1 {
    @ Space between non-silicide poly resistors and un-related implant region (SN/SP/ESD1) (follow GT.S.10 rule)>= 0.16um
    X = ESD1 NOT INTERACT RESP1
    (EXT X GTR_SA < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RESP1_EX_6 {
@ Extension of RESP1outside of non-silicide poly resistor area>= 0.2um
  //ENC GTR_SA RESP1 < 0.2 ABUT>0 <90 SINGULAR REGION
  X = GTR_SA COIN EDGE GT
  (ENC X RESP1 < 0.2 ABUT <90 REGION) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESP1_EX_6a {
@ Extension of RESP1 or RESP3T outside of non-silicide poly resistor area>= 0.2um
  //ENC GTR_SA RESP1 < 0.2 ABUT>0 <90 SINGULAR REGION
  X = GTR_SA COIN EDGE GT
  (ENC X (OR RESP1 RESP3T) < 0.2 ABUT <90 REGION) NOT INSIDE EDGE EXCLU
}
#ENDIF
RESP1_R_7 {
@ For silicide Poly resistor, two sides of RESP1 must be along the CT edge.
  X = CT AND GTR_NS
  Y = (RESP1 NOT INTERACT SAB) INSIDE EDGE GT
 (Y NOT TOUCH EDGE X) NOT INSIDE EDGE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RESP1_EX_8 {
@ Extension of SAB outside of non-silicide poly resistor area(follow SAB.EX.6 rule)>= 0.2um
  (ENC GTR SAB < 0.2 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESP1_S_9 {
@ Space between SAB and CT for non-silicide poly resistor= 0.2um
  X = GTR INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.2) NOT TOUCH GTR_SA) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RESP1_EX_8a {
@ Extension of SAB outside of non-silicide poly resistor area(follow SAB.EX.6 rule)>= 0.17um
  (ENC GTR SAB < 0.17 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
RESP1_S_9a {
@ Space between SAB and CT for non-silicide poly resistor= 0.18um
  X = GTR INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.18) NOT TOUCH GTR_SA) NOT INSIDE EXCLU
}
#ENDIF
RESP1_EN_10 {
@ Enclosure of SP/SN outside of a Poly resistor area (following GT.EX.9 rule)>= 0.16um
@ Note:
@ RESP1.n(n=1 â 6, 8,9) is for non-silicide poly resistor, RESP1.R.7 is for silicide poly resistor.
  X = RESP1 AND GT
  (ENC X SN < 0.16 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
  (ENC X SP < 0.16 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
GROUP GHRP HRP_?
HRP_W_1 {
@ Width of HRP >= 0.21um
  (INT HRP < 0.21 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
HRP_S_2 {
@ Space between two HRP >= 0.21um
  (EXT HRP < 0.21 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
HRP_R_3_R {
    @ It is strongly suggested that the resistor square number (length/width ratio) >=5 for precise Rs.>= 5
    X = HRPDMY INTERACT SAB
    Y = X INTERACT HRP
    Z = (GT AND HRPDMY) AND SAB
    L = (INSIDE EDGE GT Y) OR EDGE (GT COIN EDGE Y)
    W = INSIDE EDGE Z GT
    (DFM PROPERTY Z L W OVERLAP ABUT ALSO [SQUARES = LENGTH(L)/LENGTH(W)] < 5) NOT INSIDE EXCLU
}
HRP_EN_4 {
@ HRP enclosure of high resistance poly>= 0.2um
  (ENC HRP_resistor HRP < 0.20 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
HRP_S_5_6 {
@ HRP_S_5:  Space between HRP region and NMOS poly>= 0.16um
@ HRP_S_6:  Space between HRP region and PMOS poly>= 0.16um
  GT_MOS = GT INTERACT GATE
  (EXT HRP GT_MOS < 0.16 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
HRP_O_7 {
@ SP overlap with SAB = 0.3um
  SP_HRP = SP INTERACT HRP
  SAB_HRP = SAB INTERACT HRP
  X = SP_HRP AND SAB_HRP
  (INT X < 0.30 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
  (SIZE X BY 0.15 UNDEROVER) NOT INSIDE EXCLU
}
HRP_EX_8 {
@ SAB extension outside of high resistance poly>= 0.22um
  (ENC (GT INTERACT HRP_resistor) SAB < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
HRP_W_9 {
@ Poly width for high resistance poly>= 2um
  X = (GT INTERACT HRP_resistor) NOT COIN EDGE SP
  (INT X < 2.0 OPPOSITE REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
HRP_O_7a {
@ SP overlap with SAB = 0.2um
  SP_HRP = SP INTERACT HRP
  SAB_HRP = SAB INTERACT HRP
  X = SP_HRP AND SAB_HRP
  (INT X < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
  (SIZE X BY 0.1 UNDEROVER) NOT INSIDE EXCLU
}
HRP_EX_8a {
@ SAB extension outside of high resistance poly>= 0.17um
  (ENC (GT INTERACT HRP_resistor) SAB < 0.17 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
HRP_W_9a {
@ Poly width for high resistance poly>= 0.44um
  X = (GT INTERACT HRP_resistor) NOT COIN EDGE SP
  (INT X < 0.44 OPPOSITE REGION) NOT INSIDE EXCLU
}
#ENDIF
HRP_R_10 {
@ Dummy layer "HRPDMY" is marker layer for LVS/ DRC to define high resistance poly resistor region.
  SAB_HRP = SAB INTERACT HRP
  (SAB_HRP NOT INTERACT HRPDMY) NOT INSIDE EXCLU
}
HRP_R_11 {
@ (SN, SP) layers are not allowed in the HRPDMY region (when checking the rule, size down the HRPDMY by 0.3um along the current direction).
 HRPR    = GT INTERACT HRP
 HRP_END = SIZE (HRPR NOT HRPDMY) BY 0.3
 HRP_MID = HRPR NOT HRP_END
 ((SN OR SP) AND HRP_MID) NOT INSIDE EXCLU
}
HRP_R_12 {
@ HRPDMY edge should align with SAB edge.
 SAB_AND_HRP = (SAB INTERACT HRP) AND GT
 DMY_AND_HRP = HRPDMY AND GT
 (SAB_AND_HRP XOR DMY_AND_HRP) NOT INSIDE EXCLU
}
HRP_S_14 {
@ Space between SAB and CT in HRP region= 0.2um
  X = HRP INTERACT SAB
  Y = CT AND X
  ((SIZE Y BY 0.2) NOT TOUCH (SAB INTERACT HRP)) NOT INSIDE EXCLU
}
#IFDEF EFU_CHECK YES
GROUP GEFU PEFU_?
EFUSE_element = GTFUSE AND GT
PEFU_R_1b_G {
@ FUSEMK1 must interact with EFUSE region.
(FUSEMK1 NOT INTERACT EFUSE)NOT EXCLU
}
PEFU_R_1c_G {
@ FUSEMK1 must fully cover EFUSE region.
(EFUSE NOT FUSEMK1)NOT EXCLU
}
PEFU_R_2b_G {
@ EFUSE must interact with GTFUSE.
(EFUSE NOT INTERACT GTFUSE)NOT EXCLU
}
PEFU_R_2c_G {
@ EFUSE must fully cover GTFUSE.
(GTFUSE NOT EFUSE)NOT EXCLU
}
#IFDEF POLY_EFUSE_ELEMENT YES
PEFU_EN_4a_G {
@ Poly Efuse element must be fully covered by SP.
@ Poly Efuse element enclosure by SP.>= 0.5um
(ENC EFUSE_element SP < 0.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO)NOT EXCLU
}
PEFU_W_4b_G {
@ Poly EFuse element GT width= 0.06um
(INT EFUSE_element < 0.06 ABUT < 90 SINGULAR REGION)NOT EXCLU
(SIZE EFUSE_element BY 0.03 UNDEROVER)NOT EXCLU
}
PEFU_L_4c_G {
@ Poly EFuse element GT length>= 0.36um
(RECTANGLE EFUSE_element == 0.06 BY < 0.36)NOT EXCLU
}
#ENDIF
#ENDIF
#IFDEF DUP_CHECK YES
DUP_padarea = DUPMK1 AND (RV OR BCB2)
GROUP GDUP DUP_?
DUP_R_1_G {
    @ For (RV+BCB2) that interacts with DUPMK1, this piece of (RV+BCB2) must be fully covered by DUPMK1.
    (((RV OR BCB2) INTERACT DUPMK1) NOT DUPMK1) NOT INSIDE EXCLU
}
DUP_R_2_G {
    @ Two metal layers (TM and TM-1) are needed between DUP pad and device, where the metal design must be solid.
    ( DUP_padarea ENCLOSE (DUP_padarea NOT TKM)) NOT INSIDE EXCLU
    ( DUP_padarea ENCLOSE (DUP_padarea NOT M6)) NOT INSIDE EXCLU
}
DUP_R_5_G {
    @ ALPAR, INDMY, MOMDMY, Resistor of TM or TM-1 must be outside of DUP pad area.
    X1 = OR MOMDMY ALPAR INDMY
    X2 = (TKMR AND TKM) OR (M6R AND M6)
    ((X1 OR X2) AND DUP_padarea) NOT INSIDE EXCLU
}
DUP_R_6_G {
    @ For one top metal process: TV-1 pattern is not allowed under the DUP pad opening area.
    @ For two top metal process: TV1 patterns are not allowed under the DUP pad opening area.
    (DUP_padarea AND V5) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF LOGO_CHECK YES
GROUP GLOGO LOGO_?
LOGO_S_1_G_AA {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO AA < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_GT {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO GT < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M1 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M1 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M2 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M2 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M3 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M3 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M4 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M4 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M5 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M5 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_M6 {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO M6 < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_S_1_G_TKM {
    @ Space between LOGO and AA, GT or Metal.>= 10um
    (EXT LOGO TKM < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LOGO_O_2_G {
    @ LOGO overlap with RV, ALPA, Metal fuse(MARKF) is not allowed.
    (LOGO AND RV) NOT INSIDE EXCLU
    (LOGO AND ALPA) NOT INSIDE EXCLU
    (LOGO AND MARKF) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF SL_CHECK YES
GROUP GSL SL_?
SL_W_L_1_2_M1_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M1SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_M2_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M2SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_M3_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M3SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_M4_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M4SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_M5_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M5SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_M6_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE M6SLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_W_L_1_2_TKM_G {
    @ SL_W_1_G: Slot width >= 0.8um
    @ SL_L_2_G: Slot length >= 1um
    (NOT RECTANGLE TKMSLOT >= 0.8 BY >= 1.0) NOT INSIDE EXCLU
}
SL_EN_5_M1_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M1SLOT M1i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M1SLOT NOT M1i) NOT INSIDE EXCLU
}
SL_EN_5_M2_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M2SLOT M2i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M2SLOT NOT M2i) NOT INSIDE EXCLU
}
SL_EN_5_M3_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M3SLOT M3i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M3SLOT NOT M3i) NOT INSIDE EXCLU
}
SL_EN_5_M4_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M4SLOT M4i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M4SLOT NOT M4i) NOT INSIDE EXCLU
}
SL_EN_5_M5_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M5SLOT M5i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M5SLOT NOT M5i) NOT INSIDE EXCLU
}
SL_EN_5_M6_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC M6SLOT M6i < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M6SLOT NOT M6i) NOT INSIDE EXCLU
}
SL_EN_5_TKM_G {
    @ Open slot must be fully enclosed by metal line.>= 2um
    (ENC TKMSLOT TKMi < 2.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (TKMSLOT NOT TKMi) NOT INSIDE EXCLU
}
SL_R_6_CT_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M1SLOT CT < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M1V1_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M1SLOT V1 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M2V1_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M2SLOT V1 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M2V2_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M2SLOT V2 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M3V2_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M3SLOT V2 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
