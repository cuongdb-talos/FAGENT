M1 = M1i NOT M1SLOT
M2 = M2i NOT M2SLOT
M3 = M3i NOT M3SLOT
M4 = M4i NOT M4SLOT
M5 = M5i NOT M5SLOT
M6 = M6i NOT M6SLOT
TKM = TKMi NOT TKMSLOT
CONNECT M1 M2 BY V1
CONNECT M2 M3 BY V2
CONNECT M3 M4 BY V3
CONNECT M4 M5 BY V4
CONNECT M5 M6 BY V5
CONNECT M6 TKM BY TV2
CONNECT TKM RV
CONNECT RV ALPA
CONNECT ALPA PA
CONNECT TKM RDL BY BCB1
CONNECT RDL BCB2
CONNECT M1 PSD BY CT
CONNECT M1 NSD BY CT
CONNECT M1 INTERGT BY CT
CONNECT M1 NTAP BY CT
CONNECT M1 PTAP BY CT
CONNECT M1 NACT_NOT_GT BY CT
CONNECT M1 PACT_NOT_GT BY CT
CONNECT NTAP PSD
CONNECT PTAP NSD
CONNECT NTAP NW
CONNECT PTAP PW
CONNECT NW DNW
DRC:1 = EXTENT DRAWN ORIGINAL
BULK = SIZE DRC:1 BY 1.0
PW = BULK NOT (NW OR PSUB)
GATE0 = (GT INTERACT CT) AND AA
AA1 = (AA INTERACT GATE0) NOT GATE0
AA2 = AA1 TOUCH GATE0 == 2 
AA3 = AA1 INTERACT CT
AA4 = AA2 OR AA3
GATE1 = GATE0 TOUCH AA4 == 2
GATE2 = GATE0 AND LDBK
GATE = GATE1 OR GATE2
GATE_L = (GATE COIN EDGE AA) NOT COIN EDGE GT
GATE_W = GATE COIN EDGE GT
NACT = AA AND SN
PACT = AA AND SP
NTAP = NACT AND NW
PTAP = PACT NOT NW
STI = BULK NOT (AA OR AADUM)
PGATE   = PACT AND GT
NGATE   = NACT AND GT
PSD     = (PACT NOT PGATE) TOUCH PGATE
NSD     = (NACT NOT NGATE) TOUCH NGATE
PMOS    = PGATE OR PSD
NMOS    = NGATE OR NSD
MOS     = PMOS OR NMOS
GATE_M = GATE NOT DG                        //1.2V MOS GATE
GATE_M_L  = (GATE_M COIN EDGE AA) NOT COIN EDGE GT  //1.2V MOS GATE LENGTH
GATE_M_W  = GATE_M COIN EDGE GT			    //1.2V MOS GATE WIDTH
GATE_D = GATE AND DG     //2.5V MOS GATE
GATE_D_L = (GATE_D COIN EDGE AA) NOT COIN EDGE GT   //2.5V MOS GATE LENGTH
GATE_D_W = GATE_D COIN EDGE GT   //2.5V MOS GATE WIDTH
device_all = OR GATE DSTR DMPNP MOMDMY VARMOS VARJUN RESP1 RESAA RESNW Metal_Resistor
Metal_Resistor = OR M1R M2R M3R M4R M5R M6R M7R M8R TM1R TM2R TKMR
GT_25DD50 = GT AND MOSOV5
LMARK = (RDL AND FUSE)AND LOGO
ALPA = SIZE RV BY 1.5
PA = COPY RV
NACT_NOT_GT = (SN AND AA) NOT GT
PACT_NOT_GT = (SP AND AA) NOT GT
EXCLU = EXCLUi OR MARKS
EXDFM = EXDFMi OR EXCLU
PBAA   	= AA AND PSUB
PBMOS   = NMOS AND PSUB
PBGT   	= GT INTERACT PSUB
AAEIGT  = AA INSIDE EDGE GT
GTEIAA  = GT INSIDE EDGE AA
INTERGT = GT NOT (SAB AND (RESP1 OR HRPDMY))
PW_INNW = DNW NOT NW
DNW_EDGE = EXPAND EDGE (DNW INSIDE EDGE NW) OUTSIDE BY 0.001
NW_DNW = NW INTERACT DNW_EDGE
LVNW    = NW NOT MVNW   //1.2V NW
MVNW    = NW NOT OUTSIDE DG   //2.5V NW
LVNW0    = NW AND LVNW   //1.2V NW for Connectivity
MVNW0    = NW AND MVNW   //2.5V NW for Connectivity
MVPW    = PW INSIDE DG   //2.5V PW
NW_NR = NW NOT RESNW
NW_RE = NW AND RESNW
LVNW_RE = NW_RE COIN EDGE LVNW
MVNW_RE = NW_RE COIN EDGE MVNW
GT_all = GT OR GTDUM
AA_all = AA OR AADUM
NWR     = NW INTERACT RESNW
AAR     = AA INTERACT RESAA
GTR     = GT INTERACT RESP1
AA_resistor = ((AA AND RESAA) AND SAB) OR ((AA AND RESAA) NOT INTERACT SAB)
GT_resistor = ((GT AND RESP1) AND SAB) OR ((GT AND RESP1) NOT INTERACT SAB)
NW_resistor = (((RESNW AND AA) AND NW) AND SAB) OR ((RESNW AND NW) NOT INTERACT SAB)
HRP_resistor = ((HRPDMY AND GT) AND HRP) AND SAB
NWAA_resistor = ((RESNW AND AA) AND NW) AND SAB
NWSTI_resistor = (RESNW AND NW) NOT INTERACT SAB
GT_VEX_0 = CONVEX EDGE GT == 0
GT_VEX_1 = CONVEX EDGE GT == 1
GT_VEX_2 = CONVEX EDGE GT == 2
GT_LS = ((GT NOT WITH EDGE GT_VEX_0) WITH EDGE GT_VEX_1 == 2) WITH EDGE GT_VEX_2 == 4
GT_TS1 = ((GT NOT WITH EDGE GT_VEX_0) WITH EDGE GT_VEX_1 == 4) WITH EDGE GT_VEX_2 == 4
GT_TS2 = EXPAND EDGE (GT_VEX_2 COIN EDGE GT_TS1) OUTSIDE BY 0.005 CORNER FILL
GT_TS3 = GT_TS2 WITH EDGE GT_VEX_2 == 3
GT_TS = GT_TS1 INTERACT GT_TS3 == 1
GT_US = ((GT WITH EDGE GT_VEX_0 == 1) WITH EDGE GT_VEX_1 == 2) WITH EDGE GT_VEX_2 == 5
GT_OS = ((GT WITH EDGE GT_VEX_0 == 4) NOT WITH EDGE GT_VEX_1) WITH EDGE GT_VEX_2 == 4
GT_HS = ((GT WITH EDGE GT_VEX_0 ==2) WITH EDGE GT_VEX_1 == 4) WITH EDGE GT_VEX_2 == 6
AA_VEX_0 = CONVEX EDGE AA == 0
AA_VEX_1 = CONVEX EDGE AA == 1
AA_VEX_2 = CONVEX EDGE AA == 2
AA_LS = ((AA NOT WITH EDGE AA_VEX_0) WITH EDGE AA_VEX_1 == 2) WITH EDGE AA_VEX_2 == 4
AA_TS1 = ((AA NOT WITH EDGE AA_VEX_0) WITH EDGE AA_VEX_1 == 4) WITH EDGE AA_VEX_2 == 4
AA_TS2 = EXPAND EDGE (AA_VEX_2 COIN EDGE AA_TS1) OUTSIDE BY 0.005 CORNER FILL
AA_TS3 = AA_TS2 WITH EDGE AA_VEX_2 == 3
AA_TS = AA_TS1 INTERACT AA_TS3 == 1
AA_US = ((AA WITH EDGE AA_VEX_0 == 1) WITH EDGE AA_VEX_1 == 2) WITH EDGE AA_VEX_2 == 5
AA_OS = ((AA WITH EDGE AA_VEX_0 == 4) NOT WITH EDGE AA_VEX_1) WITH EDGE AA_VEX_2 == 4
AA_HS = ((AA WITH EDGE AA_VEX_0 ==2) WITH EDGE AA_VEX_1 == 4) WITH EDGE AA_VEX_2 == 6
DMACRO SNP_68 LAY_IMP LAY_ACT ENC_SD ENC_GT ENC_EXTENSION {
 X = GT INSIDE EDGE LAY_ACT
 A = EXPAND EDGE X INSIDE BY ENC_EXTENSION OUTSIDE BY ENC_EXTENSION CORNER FILL
 Y = (GT AND LAY_ACT) COIN EDGE LAY_ACT
 B = EXPAND EDGE Y OUTSIDE BY ENC_GT EXTEND BY ENC_EXTENSION
 C = A OR B
 D = ENC LAY_ACT (LAY_IMP INSIDE EDGE C) < ENC_GT ABUT<90 REGION OPPOSITE
 (D NOT INSIDE INST) NOT INSIDE EXCLU
 E = ENC X LAY_IMP < ENC_SD ABUT<90 REGION OPPOSITE
 (E NOT INSIDE INST) NOT INSIDE EXCLU
}
V1N_M = V1N INTERACT st_1
st_1 = (M1 AND M2) ENCLOSE V1 == 1
V1N = V1 AND (RECTANGLE V1 == 0.09 BY == 0.09)
RV1 = V1 AND (RECTANGLE V1 ASPECT != 1)
V2N_M = V2N INTERACT st_2
st_2 = (M2 AND M3) ENCLOSE V2 == 1
V2N = V2 AND (RECTANGLE V2 == 0.09 BY == 0.09)
RV2 = V2 AND (RECTANGLE V2 ASPECT != 1)
V3N_M = V3N INTERACT st_3
st_3 = (M3 AND M4) ENCLOSE V3 == 1
V3N = V3 AND (RECTANGLE V3 == 0.09 BY == 0.09)
RV3 = V3 AND (RECTANGLE V3 ASPECT != 1)
V4N_M = V4N INTERACT st_4
st_4 = (M4 AND M5) ENCLOSE V4 == 1
V4N = V4 AND (RECTANGLE V4 == 0.09 BY == 0.09)
RV4 = V4 AND (RECTANGLE V4 ASPECT != 1)
V5N_M = V5N INTERACT st_5
st_5 = (M5 AND M6) ENCLOSE V5 == 1
V5N = V5 AND (RECTANGLE V5 == 0.09 BY == 0.09)
RV5 = V5 AND (RECTANGLE V5 ASPECT != 1)
M1M2 = M1 AND M2
SV1_metal = M1M2 INTERACT V1 == 1
M2M3 = M2 AND M3
SV2_metal = M2M3 INTERACT V2 == 1
M3M4 = M3 AND M4
SV3_metal = M3M4 INTERACT V3 == 1
M4M5 = M4 AND M5
SV4_metal = M4M5 INTERACT V4 == 1
M5M6 = M5 AND M6
SV5_metal = M5M6 INTERACT V5 == 1
M1ALL = M1 OR M1DUM
M2ALL = M2 OR M2DUM
M3ALL = M3 OR M3DUM
M4ALL = M4 OR M4DUM
M5ALL = M5 OR M5DUM
M6ALL = M6 OR M6DUM
TKMALL = TKM OR TKMDUM
TKMDUM = COPY TKMDM
V1_slot = ((ENCLOSE RECTANGLE V1i 0.1 0.3) AND MARKG) INTERACT (WITH WIDTH V1i == 0.1)
V2_slot = ((ENCLOSE RECTANGLE V2i 0.1 0.3) AND MARKG) INTERACT (WITH WIDTH V2i == 0.1)
V3_slot = ((ENCLOSE RECTANGLE V3i 0.1 0.3) AND MARKG) INTERACT (WITH WIDTH V3i == 0.1)
V4_slot = ((ENCLOSE RECTANGLE V4i 0.1 0.3) AND MARKG) INTERACT (WITH WIDTH V4i == 0.1)
V5_slot = ((ENCLOSE RECTANGLE V5i 0.1 0.3) AND MARKG) INTERACT (WITH WIDTH V5i == 0.1)
 
V1_slot_SG = (((ENCLOSE RECTANGLE V1i 0.09 0.27) AND MARKG) INTERACT (WITH WIDTH V1i == 0.09)) OR V1_slot
V2_slot_SG = (((ENCLOSE RECTANGLE V2i 0.09 0.27) AND MARKG) INTERACT (WITH WIDTH V2i == 0.09)) OR V2_slot
V3_slot_SG = (((ENCLOSE RECTANGLE V3i 0.09 0.27) AND MARKG) INTERACT (WITH WIDTH V3i == 0.09)) OR V3_slot
V4_slot_SG = (((ENCLOSE RECTANGLE V4i 0.09 0.27) AND MARKG) INTERACT (WITH WIDTH V4i == 0.09)) OR V4_slot
V5_slot_SG = (((ENCLOSE RECTANGLE V5i 0.09 0.27) AND MARKG) INTERACT (WITH WIDTH V5i == 0.09)) OR V5_slot
 
#IFDEF ALLOW_V1_CHECK YES 
V1ia = (RECTANGLE V1i == 0.1 BY == 0.1) OR V1_slot
V2ia = (RECTANGLE V2i == 0.1 BY == 0.1) OR V2_slot
V3ia = (RECTANGLE V3i == 0.1 BY == 0.1) OR V3_slot
V4ia = (RECTANGLE V4i == 0.1 BY == 0.1) OR V4_slot
V5ia = (RECTANGLE V5i == 0.1 BY == 0.1) OR V5_slot
 
V1_sd = SIZE V1ia BY -0.005
V2_sd = SIZE V2ia BY -0.005
V3_sd = SIZE V3ia BY -0.005
V4_sd = SIZE V4ia BY -0.005
V5_sd = SIZE V5ia BY -0.005
 
V1r = V1i NOT V1ia
V2r = V2i NOT V2ia
V3r = V3i NOT V3ia
V4r = V4i NOT V4ia
V5r = V5i NOT V5ia
 
V1 = V1r OR V1_sd
V2 = V2r OR V2_sd
V3 = V3r OR V3_sd
V4 = V4r OR V4_sd
V5 = V5r OR V5_sd
 
#ENDIF
 
#IFDEF ALLOW_V1_CHECK NO
V1 = COPY V1i
V2 = COPY V2i
V3 = COPY V3i
V4 = COPY V4i
V5 = COPY V5i
 
#ENDIF
TV2 = COPY TV2i
PGT = SP AND GT
NGT = SN AND GT
CTS = CT AND MARKS
CTS_SL = CT AND (ENCLOSE RECTANGLE CTS 0.09 0.27)
CTS_SQ = CTS NOT CTS_SL
AAS = AA AND (AA ENCLOSE CTS)
 
M1S = M1 AND MARKS
M1S_INNER = M1S TOUCH (HOLES M1S INNER) == 1
M1S_OUTER = HOLES M1S
M1S_RING = M1 AND (M1S INTERACT M1S_OUTER)
 
M2S = M2 AND MARKS
M2S_INNER = M2S TOUCH (HOLES M2S INNER) == 1
M2S_OUTER = HOLES M2S
M2S_RING = M2 AND (M2S INTERACT M2S_OUTER)
 
M3S = M3 AND MARKS
M3S_INNER = M3S TOUCH (HOLES M3S INNER) == 1
M3S_OUTER = HOLES M3S
M3S_RING = M3 AND (M3S INTERACT M3S_OUTER)
 
M4S = M4 AND MARKS
M4S_INNER = M4S TOUCH (HOLES M4S INNER) == 1
M4S_OUTER = HOLES M4S
M4S_RING = M4 AND (M4S INTERACT M4S_OUTER)
 
M5S = M5 AND MARKS
M5S_INNER = M5S TOUCH (HOLES M5S INNER) == 1
M5S_OUTER = HOLES M5S
M5S_RING = M5 AND (M5S INTERACT M5S_OUTER)
 
M6S = M6 AND MARKS
M6S_INNER = M6S TOUCH (HOLES M6S INNER) == 1
M6S_OUTER = HOLES M6S
M6S_RING = M6 AND (M6S INTERACT M6S_OUTER)
 
TKMS = TKM AND MARKS
TKMS_INNER = TKMS TOUCH (HOLES TKMS INNER) == 1
TKMS_OUTER = HOLES TKMS
TKMS_RING = TKM AND (TKMS INTERACT TKMS_OUTER)
 
V1S = V1 AND MARKS
V1S_SL = V1 AND (ENCLOSE RECTANGLE V1S 0.09 0.27)
V1S_SQ = V1S NOT V1S_SL
 
V2S = V2 AND MARKS
V2S_SL = V2 AND (ENCLOSE RECTANGLE V2S 0.09 0.27)
V2S_SQ = V2S NOT V2S_SL
 
V3S = V3 AND MARKS
V3S_SL = V3 AND (ENCLOSE RECTANGLE V3S 0.09 0.27)
V3S_SQ = V3S NOT V3S_SL
 
V4S = V4 AND MARKS
V4S_SL = V4 AND (ENCLOSE RECTANGLE V4S 0.09 0.27)
V4S_SQ = V4S NOT V4S_SL
 
V5S = V5 AND MARKS
V5S_SL = V5 AND (ENCLOSE RECTANGLE V5S 0.09 0.27)
V5S_SQ = V5S NOT V5S_SL
 
TV2S = TV2 AND MARKS
TV2S_SL = TV2 AND (ENCLOSE RECTANGLE TV2S 0.28 0.84)
TV2S_SQ = TV2S NOT TV2S_SL
 
BCB1S = BCB1 AND MARKS
RDLS = RDL AND MARKS
RDLS_INNER = RDLS TOUCH (HOLES RDLS INNER) == 1
RDLS_OUTER = HOLES RDLS
RDLS_RING = RDL AND (RDLS INTERACT RDLS_OUTER)
 
MS_RING_INNER = ((((((RDLS_INNER OR M1S_INNER) OR M2S_INNER) OR M3S_INNER) OR M4S_INNER) OR M5S_INNER) OR M6S_INNER) OR TKMS_INNER
CONNECT AAS M1S_RING BY CTS
CONNECT M1S_RING M2S_RING BY V1S
CONNECT M2S_RING M3S_RING BY V2S
CONNECT M3S_RING M4S_RING BY V3S
CONNECT M4S_RING M5S_RING BY V4S
CONNECT M5S_RING M6S_RING BY V5S
CONNECT M6S_RING TKMS_RING BY TV2S
CONNECT MARKS TKMS_RING
CONNECT TKMS_RING RDLS_RING BY BCB1S
ISOLATION = ((((((MARKS AND (HOLES M1S_INNER INNER)) AND (MARKS AND (HOLES M2S_INNER INNER))) AND (MARKS AND (HOLES M3S_INNER INNER))) AND (MARKS AND (HOLES M4S_INNER INNER))) AND (MARKS AND (HOLES M5S_INNER INNER))) AND (MARKS AND (HOLES M6S_INNER INNER))) AND (MARKS AND (HOLES TKMS_INNER INNER))
HRDL = (HOLES RDL inner ) INTERACT FUSE
GRDL = (RDL TOUCH HRDL) AND MARKG
HM1 = (HOLES M1 INNER) INTERACT FUSE
GM1 = (M1 TOUCH HM1) AND MARKG
GM2 = M2 INTERACT GM1
M2FUSE = M2 INSIDE HM1
 
HM3 = (HOLES M3 INNER) INTERACT FUSE
GM3 = (M3 TOUCH HM3) AND MARKG
GM4 = M4 INTERACT GM3
M4FUSE = M4 INSIDE HM3
 
HM5 = (HOLES M5 INNER) INTERACT FUSE
GM5 = (M5 TOUCH HM5) AND MARKG
GM6 = M6 INTERACT GM5
M6FUSE = M6 INSIDE HM5
 
Stack_MR = GM1 OR (GM2 OR (GM3 OR (GM4 OR (GM5 OR (GM6 OR GRDL)))))
LDAA = AA AND LDBK
LDPAA = LDAA AND SP
LDNAA = LDAA AND SN
LDPGATE = LDPAA AND GT
LDNGATE = LDNAA AND GT
LDPD = (LDPAA NOT INTERACT GT) TOUCH STIDMY
LDND = (LDNAA NOT INTERACT GT) TOUCH STIDMY
LDPS = (LDPAA INTERACT GT) NOT LDPGATE
LDNS = (LDNAA INTERACT GT) NOT LDNGATE
SD_LDMOS = OR LDPD LDND LDPS LDNS
GT_LDMOS = LDPGATE OR LDNGATE
AA_LDMOS = SD_LDMOS OR GT_LDMOS
EGATE = (AA AND GT) AND ESDMOS
ENGATE = EGATE AND ENACT
EPGATE = EGATE AND EPACT
ENACT = NACT AND ESDMOS
EPACT = PACT AND ESDMOS
ENTAP = ENACT AND NW
EPTAP = EPACT NOT NW
EGATEMV = ((EGATE AND DG)NOT OVERPL)NOT ESDCAS //2.5V GATE
EGATELV = ((EGATE NOT DG)NOT OVERPL)NOT ESDCAS //1.2V GATE
EGATE_2_5V_O_3_3V = ((EGATE AND DG)AND OVERPL)NOT ESDCAS //2.5V overdrive 3.3V ESD GATE
EGATE_1_2V_CASCODED = ((EGATE AND ESDCAS) NOT DG) NOT OVERPL //1.2V ESD cascoded GATE
EGATE_CASCODED = (EGATE AND ESDMOS) AND ESDCAS //high voltage tolerant I/O using Cascoded 2.5V/3.3V NMOS
2_5V_ESD_CASCODED = ((ESDMOS AND ESDCAS)AND DG)NOT OVERPL
1_2V_ESD_MOS = ((ESDMOS NOT DG)NOT OVERPL)NOT ESDCAS //1.2V ESDMOS
2_5V_ESD_MOS = ((ESDMOS AND DG)NOT OVERPL)NOT ESDCAS //2.5V ESDMOS
ESD_2_5V_O_3_3V = ((ESDMOS AND DG)AND OVERPL)NOT ESDCAS //2.5V overdrive 3.3V ESD MOS
1_2V_ESD_CASCODED = ((ESDMOS AND ESDCAS)NOT DG)NOT OVERPL //1.2V ESD cascoded ESD MOS
EGATE_W = EGATE COIN EDGE GT
EGATE_L = EGATE COIN EDGE AA
ENMOS = ENACT ENCLOSE EGATE
EPMOS = EPACT ENCLOSE EGATE
ENMOS_SD = ENMOS NOT EGATE
EPMOS_SD = EPMOS NOT EGATE
ENMOS_S = ENMOS_SD ENCLOSE ECT_S
EPMOS_S = EPMOS_SD ENCLOSE ECT_S
ECT = CT AND ESDMOS
ESAB = SAB AND ESDMOS
ESAB_HO = HOLES ESAB INNER EMPTY
ECT_S = ECT OUTSIDE ESAB_HO
ECT_D = ECT INSIDE ESAB_HO
ENMOS_D = ENMOS_SD ENCLOSE ECT_D
EPMOS_D = EPMOS_SD ENCLOSE ECT_D
ENMOS_D_temp = ENMOS NOT ENMOS_S
EPMOS_D_temp = EPMOS NOT EPMOS_S
EMOS_S = ENMOS_S OR EPMOS_S
NESDCLP_NOSAB = (NACT AND ESDMOS) NOT INTERACT SAB
NESDCLP_SAB = (NACT AND ESDMOS) INTERACT SAB
PESDCLP_NOSAB = (PACT AND ESDMOS) NOT INTERACT SAB
PESDCLP_SAB = (PACT AND ESDMOS) INTERACT SAB
ENGATE_NOSAB = GATE AND NESDCLP_NOSAB
ENGATE_SAB = GATE AND NESDCLP_SAB
EPGATE_NOSAB = GATE AND PESDCLP_NOSAB
EPGATE_SAB = GATE AND PESDCLP_SAB
EGATE_NOSAB = ENGATE_NOSAB OR EPGATE_NOSAB
EGATE_SAB = ENGATE_SAB OR EPGATE_SAB
ESD3C_1 = EXPAND EDGE ((EGATE NOT EGATE_CASCODED) INSIDE EDGE AA) INSIDE BY 0.001
ESD3C_2 = EXPAND EDGE ((EGATE_CASCODED NOT INSIDE SAB) INSIDE EDGE AA) INSIDE BY 0.001
ESD3C = ESD3C_1 OR ESD3C_2
LAYER MAP 998 DATATYPE 1234 5432
LAYER EMPTY1 5432
LAYER MAP 999 DATATYPE 1235 5433
LAYER EMPTY2 5433
ENGATE_D_EMPTY = EMPTY1 OR (ESDMOS AND ENMOS_D)
EPGATE_D_EMPTY = EMPTY1 OR (ESDMOS AND EPMOS_D)
ENMOS_D_temp_EMPTY2 = EMPTY2 OR (ESDMOS AND ENMOS_D_temp)
EPMOS_D_temp_EMPTY2 = EMPTY2 OR (ESDMOS AND EPMOS_D_temp)
ESD3C_EMPTY = EMPTY1 OR ESD3C
ESD3C_EMPTY2 = EMPTY2 OR ESD3C
ECT_EMPTY = EMPTY1 OR ECT
EM1_EMPTY = EMPTY1 OR M1
EV1_EMPTY = EMPTY1 OR V1
EM2_EMPTY = EMPTY1 OR M2
EV2_EMPTY = EMPTY1 OR V2
EM3_EMPTY = EMPTY1 OR M3
EV3_EMPTY = EMPTY1 OR V3
EM4_EMPTY = EMPTY1 OR M4
EV4_EMPTY = EMPTY1 OR V4
EM5_EMPTY = EMPTY1 OR M5
EV5_EMPTY = EMPTY1 OR V5
EM6_EMPTY = EMPTY1 OR M6
ETV2_EMPTY = EMPTY1 OR TV2
ETKM_EMPTY = EMPTY1 OR TKM
CONNECT EM1_EMPTY EM2_EMPTY BY EV1_EMPTY
CONNECT EM2_EMPTY EM3_EMPTY BY EV2_EMPTY
CONNECT EM3_EMPTY EM4_EMPTY BY EV3_EMPTY
CONNECT EM4_EMPTY EM5_EMPTY BY EV4_EMPTY
CONNECT EM5_EMPTY EM6_EMPTY BY EV5_EMPTY
CONNECT EM6_EMPTY ETKM_EMPTY BY ETV2_EMPTY
CONNECT ENGATE_D_EMPTY ESD3C_EMPTY
CONNECT EPGATE_D_EMPTY ESD3C_EMPTY
CONNECT ENMOS_D_temp_EMPTY2 ESD3C_EMPTY2
CONNECT EPMOS_D_temp_EMPTY2 ESD3C_EMPTY2
CONNECT ENGATE_D_EMPTY EM1_EMPTY BY ECT_EMPTY
CONNECT EPGATE_D_EMPTY EM1_EMPTY BY ECT_EMPTY
CONNECT ENMOS_D_temp_EMPTY2 EM1_EMPTY BY ECT_EMPTY
CONNECT EPMOS_D_temp_EMPTY2 EM1_EMPTY BY ECT_EMPTY
EPA_EMPTY = EMPTY1 OR PA
ERDL_EMPTY = EMPTY1 OR RDL
ERV_EMPTY = EMPTY1 OR RV
EALPA_EMPTY = EMPTY1 OR ALPA
ERDL = EMPTY1 OR RDL
EBCB1 = EMPTY1 OR BCB1
EBCB2 = EMPTY1 OR BCB2
CONNECT ETKM_EMPTY ERV_EMPTY
CONNECT ERV_EMPTY EALPA_EMPTY
CONNECT EALPA_EMPTY EPA_EMPTY
CONNECT ETKM_EMPTY ERDL BY EBCB1
CONNECT ERDL EBCB2
ESDNDIO_FINGER = RECTANGLE((NACT AND ESDDIO)NOT NW)
ESDPDIO_FINGER = RECTANGLE((PACT AND ESDDIO)AND NW)
ESDDIO_FINGER = OR ESDNDIO_FINGER ESDPDIO_FINGER
ESDDIO_NTAP_RING = DONUT(NTAP AND ESDDIO)
ESDDIO_PTAP_RING = DONUT(PTAP AND ESDDIO)
ESDDIO_NTAP_HOLE = HOLES (NTAP AND ESDDIO) INNER
ESDDIO_PTAP_HOLE = HOLES (PTAP AND ESDDIO) INNER
ESDDIO_BULK_RING = DONUT ((SP AND AA)NOT NW)
ESDDIO_FINGER_EDGE = EXPAND EDGE ESDDIO_FINGER OUTSIDE BY 0.001
ESDDIO_FINGER_EMPTY = ESDDIO_FINGER OR EMPTY1
ESDDIO_FINGER_EDGE_EMPTY = OR ESDDIO_FINGER_EDGE EMPTY1
ESDDIO_CT_EMPTY = (CT AND ESDDIO) OR EMPTY1
CONNECT ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY
CONNECT ESDDIO_FINGER_EMPTY EM1_EMPTY BY ESDDIO_CT_EMPTY
DGR_3 {
@ Only shapes of geometry that are orthogonal or 45-degree (0.1d tolerance) angle are allowed,excluding Inductor region.
  X = DFM COPY (DRAWN SKEW) EDGE
  (X NOT COIN EDGE (ANGLE X >= 44.9 <= 45.1)) NOT INSIDE EDGE INDMY
}
DGR_12 {
@ The layout of designs should not have these layers including PW, PWH, NWH, NC, HR, NLH, PLH, NLL, PLL, ALPA and PA.
  X = COPY DRC:1
  Y = OR PWi PWH NWH NC HR NLH PLH NLL PLL ALPAi PAi
  X AND Y
}
GROUP GDNW DNW_?
DNW_W_1 {
    @ DNW width >= 3um
    (INT DNW < 3.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DNW_S_2 {
    @ Space between two DNWs >= 3.5um
    (EXT DNW < 3.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DNW_EN_3 {
    @ NW Enclosure of DNW >= 1um
    (ENC DNW NW < 1.0 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (DNW COINCIDENT EDGE NW) NOT INSIDE EDGE EXCLU
    (DNW OUTSIDE EDGE NW) NOT INSIDE EDGE EXCLU
}
DNW_O_4 {
    @ Overlap of NW and DNW. >= 0.4um
    X = SIZE DNW BY -0.4
    ((DNW NOT X) NOT NW) NOT INSIDE EXCLU
}
DNW_S_5a {
    @ Space between DNW and NW >= 2.5um
    X = NW NOT COIN EDGE DNW
    (EXT X DNW < 2.5 ABUT<90 REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
DNW_S_5b {
    @ Space between DNW and NW at different net>= 3um
    (EXT DNW NW < 3.0 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
DNW_S_5c {
    @ Space between DNW and NW at different net>= 1.9um
    (EXT DNW NW < 1.9 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_ON YES
DNW_EN_6_R {
    @ DNW is enclosed by NW
    ((DNW NOT INSIDE EDGE NW_DNW) NOT COIN EDGE NW_DNW) NOT INSIDE EDGE EXCLU
}
#ENDIF
DNW_R_7 {
    @ DNW is not allowed in native device region.
    (DNW AND PSUB) NOT INSIDE EXCLU
}
DNW_S_8 {
    @ Space between ((PW INSIDE DNW) NOT INTERACT DG) and (PW NOT INTERACT DG) at different nets (except the LDBK region).
    @ This rule purpose is defined for different potential application.>= 1um
    X = (PW INSIDE DNW) NOT INTERACT DG
    Y = PW NOT INTERACT DG
    ((EXT X Y < 1.0 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
DNW_S_9 {
    @ Space between ((PW INSIDE DNW) INTERACT DG) and (PW INTERACT DG) at different nets (except the LDBK region).This rule purpose is defined for different potential application.>= 1.2um
    X = (PW INSIDE DNW) INTERACT DG
    Y = PW INTERACT DG
    ((EXT X Y < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
DNW_EN_10 {
    @ Enclosure of N+ active AA(exclude pick-up AA)>= 0.55um
    (ENC (NACT NOT (NTAP OR PTAP)) DNW < 0.55 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
GROUP GAA AA_?
AA_W_1 {
    @ Width of interconnect AA >= 0.08um
    (INT AA < 0.08 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
AA_W_2a {
    @ Channel width for 1.2V NMOS/PMOS transistors (except the INST region).>= 0.11um
    Y = LENGTH GATE_M_W < 0.11
    ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_W_2b {
    @ Channel width for 2.5V NMOS/PMOS transistors, including GT_25UD18, GT_25OD33 and GT_25DD50. (except the INST region).>= 0.21um
    X = GT INSIDE EDGE ((AA AND DG) AND(OR UNDEPL OVERPL MOSOV5))
    Y1 = LENGTH X < 0.21
    Y2 = LENGTH GATE_D_W < 0.21
    ((EXPAND EDGE Y1 INSIDE BY 0.001) NOT INSIDE INST) NOT INSIDE EXCLU
    ((EXPAND EDGE Y2 INSIDE BY 0.001) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_S_3a {
    @ Space between two AAs in the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP). DRC waive check 45-degree spaces(1degree tolerance) in the INDMY region. DRC waive check the INST region.>= 0.1um
    Y = OR NW DNW VTNH VTPH LVN LVP PW
    ((((EXT AA < 0.10 ABUT<90 SINGULAR REGION) INSIDE Y) NOT INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
    ((((EXT AA < 0.10 ABUT<44 SINGULAR REGION) INSIDE Y) AND INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
    ((((EXT AA < 0.10 ABUT>46<90 SINGULAR REGION) INSIDE Y) AND INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_S_3b {
    @ Space between AAs when one or both AA width greater than 0.15um in the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP). DRC waive check the INDMY and INST covered region.>= 0.11um
    Y = OR NW DNW VTNH VTPH LVN LVP PW
    X = AA WITH WIDTH > 0.15
    ((((EXT X AA < 0.11 SINGULAR REGION) INSIDE Y) NOT INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_EN_4 {
    @ N+AA enclosed by NW (excluding NW interacting with RESNW, and the INST region)>= 0.12um
    ((ENC NACT (NW NOT INTERACT RESNW) < 0.12 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_S_5a {
    @ Space between NW and N+AA inside PW except NW resistor region (except the INST region).>= 0.15um
    ((EXT (NW NOT INTERACT RESNW) (NACT INSIDE PW) < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_S_5b {
    @ Space between 2.5V NW and N+AA inside PW except NW resistor region>= 0.25um
    (EXT (MVNW NOT INTERACT RESNW) (NACT INSIDE PW) < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
AA_S_5c {
    @ Space between NW and N+AA inside 2.5V PW except NW resistor region>= 0.25um
    (EXT (NW NOT INTERACT RESNW) (NACT INSIDE MVPW) < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
AA_EN_6 {
    @ P+AA enclosed by NW (except the INST region).>= 0.15um
    ((ENC PACT NW < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_S_7 {
    @ Space between NW and P+AA inside PW (except the INST and LDBK region).>= 0.12um
    (((EXT NW (PACT INSIDE PW) < 0.12 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
AA_A_8a {
    @ AA area (except the INST region).>= 0.038um2
    ((AREA AA < 0.038) NOT INSIDE INST) NOT INSIDE EXCLU
}
AA_A_8b {
    @ Enclosed area >= 0.07um2
    (AREA ((HOLES AA INNER) NOT AA) < 0.07) NOT INSIDE EXCLU
}
AA_S_9 {
    @ Space between N+AA, which is not enclosed by DNW, and NW which encloses a DNW>= 0.32um
    X = EXT NACT NW_DNW < 0.32 ABUT<90 SINGULAR REGION
    (X NOT DNW) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
#IFDEF GUIXI_SPECIAL NO
AA_D_10a_Min {
    @ Local AA density (including dummy AA) in 200umX200um window with step size 100um>= 0.19
    @ <= 0.9
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10a_Min.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10a_Min.rdb"
}
AA_D_10a_Max {
    @ Local AA density (including dummy AA) in 200umX200um window with step size 100um>= 0.19
    @ <= 0.9
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window1)))] > 0.9 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window2)))] > 0.9 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.9 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10a_Max.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10a_Max.rdb"
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
AA_D_10a1_Min {
    @ Local AA density (including dummy AA) in 150umX150um window with step size 50um>= 0.19
    @ <= 0.8
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 150.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(150.0*150.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 150.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(150.0*150.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 150.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(150.0*150.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.19 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10a1_Min.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10a1_Min.rdb"
}
AA_D_10a1_Max {
    @ Local AA density (including dummy AA) in 150umX150um window with step size 50um>= 0.19
    @ <= 0.8
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 150.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(150.0*150.0/4-AREA(Check_window1)))] > 0.8 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 150.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(150.0*150.0/4-AREA(Check_window2)))] > 0.8 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 150.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(150.0*150.0/4-AREA(Check_window3)))] > 0.8 WINDOW 150.0 STEP 50.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10a1_Max.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10a1_Max.rdb"
}
#ENDIF
AA_D_10b_Min {
    @ Global AA density for fully chip (including dummy AA)>= 0.23
    @ <= 0.75
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [(!AREA(Check_pattern)+AREA(Check_pattern)/AREA(Check_region))] < 0.23
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10b_Min.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10b_Min.rdb"
}
AA_D_10b_Max {
    @ Global AA density for fully chip (including dummy AA)>= 0.23
    @ <= 0.75
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [!!AREA(Check_pattern)*(AREA(Check_pattern))/AREA(Check_region)] > 0.75
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10b_Max.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10b_Max.rdb"
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
AA_D_10c_R {
    @ AA density inside of dummy block area (DUMBA OR NODMF),while the area of dummy block layer is larger than 2500um2 (50umX50um)>= 0.23
    X = AREA (DUMBA OR NODMF) > 2500
    Check_region = X NOT EXCLUi
    Check_pattern = (AA_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [(!AREA(Check_pattern)+AREA(Check_pattern)/AREA(Check_region))] < 0.23
    PRINT "./Process_CALDRC_logfile/density_report_AA_D_10c_R.log"
    RDB "./Process_CALDRC_logfile/density_report_AA_D_10c_R.rdb"
}
#ENDIF
#ENDIF
AA_R_11 {
    @ N+ active AA(exclude pick-up AA) is not allowed to be straddle on the boundary of DNW except LDBK, RESNW areas.
    X = NACT NOT (NTAP OR PTAP)
    (((X CUT DNW) NOT INSIDE RESNW) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
AA_R_12_R {
    @ N+ AA is not allowed to be straddle on the boundary of NW except LDBK, RESNW areas.
    X = COPY NACT
    (X CUT (NW NOT INTERACT (RESNW OR LDBK))) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_ON YES
AA_W_13_R {
    @ Width of 45 degree bent AA>= 0.18um
    X = ANGLE AA >= 44.9 <= 45.1
    (INT X < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
AA_S_14_R {
    @ Space to 45 degree bent AA, except the INDMY covered region.>= 0.18um
    X = ANGLE AA >= 44.9 <= 45.1
    ((EXT X AA < 0.18 ABUT<90 REGION) NOT INDMY) NOT INSIDE EXCLU
}
#ENDIF
AA_S_15 {
    @ Space between U-shape (or O-shape) AA inner edges>= 0.15um
    (CONVEX EDGE AA_OS == 0 WITH LENGTH < 0.15) NOT INSIDE EDGE EXCLU
    (CONVEX EDGE AA_US == 0 WITH LENGTH < 0.15) NOT INSIDE EDGE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
AA_L_16_R {
    @ Maximum AA length between two contacts, or between one contact and AA line end when AA width < 0.15 Âµm<= 25um
    AA_CHECK = WITH WIDTH AA < 0.15
    Z0 = SIZE CT BY 12.5 INSIDE OF AA_CHECK STEP 0.02
    Z1 = Z0 INTERACT CT < 2
    Z2 = (AA_CHECK INTERACT Z1) NOT (AA_CHECK INTERACT CT == 1)
    Z2 NOT INSIDE EXCLU
    X = CONVEX EDGE AA ANGLE1>=89.9<=90.1 ANGLE2>=89.9<=90.1 WITH LENGTH<0.15
    Y = (AA WITH WIDTH <0.15) INTERACT CT
    Z = Y TOUCH EDGE X
    Z3 = SIZE CT BY 25 INSIDE OF Y STEP 0.02
    ((Z NOT INSIDE EDGE Z3) NOT TOUCH EDGE Z3) NOT INSIDE EDGE EXCLU
}
#ENDIF
GROUP GNW NW_?
NW_W_1 {
    @ NW width >= 0. 36um
    (INT NW < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
NW_W_2 {
    @ NW width for NW resistor >= 1.6um
    (INT NWR < 1.60 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
NW_W_2a {
    @ NW width for NW resistor >= 1.5um
    (INT NWR < 1.50 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
NW_S_3 {
    @ Space between 1.2V NWs at the same nets>= 0. 36um
    (EXT LVNW0 < 0.36 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
NW_S_4 {
    @ Space between 1.2V NWs at different nets>= 0.47um
    (EXT LVNW0 < 0.47 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
NW_S_4a {
    @ Space between 1.2V NWs at different nets>= 0.45um
    (EXT LVNW0 < 0.45 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
#ENDIF
NW_S_5 {
    @ Space between 1.2V and 2.5V NW at the same nets.>= 0.47um
    (EXT LVNW0 MVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE EXCLU
}
NW_S_6 {
    @ Space between 1.2V NW and 2.5V NW at different nets.>= 0.72um
    (EXT LVNW0 MVNW0 < 0.72 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
NW_S_7a {
    @ Space between 2.5V NW at same nets.>= 0.47um
    (EXT MVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE EXCLU
}
NW_S_7b {
    @ Space between 2.5V NW at different nets.>= 0.72um
    (EXT MVNW0 < 0.72 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXCLU
}
NW_A_8 {
    @ NW area >= 0.3um2
    (AREA NW < 0.3) NOT INSIDE EXCLU
}
NW_EN_9 {
    @ Enclosed area >= 0.3um2
    (AREA ((HOLES NW INNER) NOT NW) < 0.30) NOT INSIDE EXCLU
}
GROUP GPSUB PSUB_?
PSUB_W_1 {
    @ PSUB width >= 0.36um
    (INT PSUB < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
PSUB_W_2 {
    @ 1.2/2.5V native NMOS channel width>= 0.5um
    X = LENGTH GATE_W < 0.5
    ((EXPAND EDGE X INSIDE BY 0.001) AND PSUB) NOT INSIDE EXCLU
}
PSUB_L_3a {
    @ 1.2V native NMOS channel length>= 0.2um
    X = PBGT INSIDE EDGE (PBAA NOT INTERACT DG)
    (INT X < 0.20 ABUT<90 REGION) NOT INSIDE EXCLU
}
PSUB_L_3c {
    @ 2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length >= 1um
    X = PBGT INSIDE EDGE (PBAA INTERACT DG)
    (INT X < 1.0 ABUT<90 REGION) NOT INSIDE EXCLU
}
PSUB_S_4 {
    @ Space between two PSUBs >= 0.36um
    (EXT PSUB < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
PSUB_EN_5 {
    @ Native NMOS AA enclosure by PSUB= 0.285um
    X = SIZE PBMOS BY 0.285
    Y = PSUB INTERACT PBMOS
    (XOR X Y) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
PSUB_EN_5a {
    @ Native NMOS AA enclosure by PSUB,except LDBK region= 0.28um
    X = SIZE PBMOS BY 0.28
    Y = PSUB INTERACT PBMOS
    ((XOR X Y) NOT INSIDE EXCLU) NOT LDBK
}
#ENDIF
PSUB_S_6 {
    @ Space between PSUB and MOS AA >= 0.37um
    (EXT PSUB MOS < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
PSUB_S_7 {
    @ Space between PSUB and NW>= 1.2um
    (EXT PSUB NW < 1.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
PSUB_EX_8 {
    @ Extension of native NMOS poly GATE outside of AA. DRC doesnât flag INDMY covered regions.>= 0.31um
    ((ENC PBAA PBGT < 0.31 ABUT<90 REGION OPPOSITE) NOT INSIDE INDMY) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
PSUB_S_7a {
    @ Space between PSUB and NW>= 0.9um
    (EXT PSUB NW < 0.9 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
PSUB_EX_8a {
    @ Extension of native NMOS poly GATE outside of AA. DRC doesnât flag INDMY covered regions.except LDBK regiion>= 0.31um
    ((ENC PBAA PBGT < 0.31 ABUT<90 REGION OPPOSITE) NOT INSIDE (OR LDBK INDMY)) NOT INSIDE EXCLU
}
#ENDIF
PSUB_R_9 {
    @ PSUB inside, overlapping with, or crossing over a DNW area is not allowed
    (PSUB AND DNW) NOT INSIDE EXCLU
}
PSUB_O_10 {
    @ PSUB must not overlap NW.
    (PSUB AND NW) NOT INSIDE EXCLU
}
PSUB_R_11 {
    @ Only one AA pattern is allowed in one PSUB region, except for NMOS capacitors and AAs in INDMY.
    (PSUB INTERACT (AA NOT INTERACT (CAPBP OR INDMY)) > 1) NOT INSIDE EXCLU
}
PSUB_R_12 {
    @ SP is not allowed to exist in a PSUB region and P+ pickup can be waived.DRC waive check INDMY covered region, and P+ pickup can be waived.
    X = (SP AND PSUB) NOT INSIDE INDMY
    Y = ((AA OR GT) INTERACT GATE) AND PSUB
    (X NOT INTERACT Y) NOT INSIDE EXCLU
}
PSUB_A_13 {
    @ PSUB area >= 0.3um2
    (AREA PSUB < 0.3) NOT INSIDE EXCLU
}
PSUB_A_14 {
    @ Enclosed area >= 0.3um2
    (AREA ((HOLES PSUB INNER) NOT PSUB) < 0.30) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_ON YES
PSUB_A_15_R {
    @ (R) Area when one of the edge length <0.8um>= 0.3um2
    X = LENGTH PSUB < 0.8
    Y = PSUB WITH EDGE X
    (AREA Y < 0.3) NOT INSIDE EXCLU
}
PSUB_A_16_R {
    @ (R) Enclosed area when one of the edge length <0.8um>= 0.3um2
    X = (HOLES PSUB INNER) NOT PSUB
    Y = LENGTH (X TOUCH EDGE PSUB) < 0.8
    (AREA (X WITH EDGE Y) < 0.30) NOT INSIDE EXCLU
}
#ENDIF
GROUP GVTNH VTNH_?
VTNH_W_1 {
@ VTNH width. Single-point-interaction is allowed.>= 0.18um
  (INT VTNH < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
VTNH_S_2 {
@ Space between two VTNHs. Single-point-interaction is allowed.>= 0.18um
  (EXT VTNH < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE EXCLU
}
VTNH_O_3 {
@ VTNH overlap with PSUB, P+ active AA(exclude pick-up AA), VTPH, DG are not allowed.
  (AND VTNH PSUB) NOT INSIDE EXCLU
  (AND VTNH (PACT NOT PTAP)) NOT INSIDE EXCLU
  (AND VTNH VTPH) NOT INSIDE EXCLU
  (AND VTNH DG) NOT INSIDE EXCLU
}
VTNH_EN_4 {
@ VTNH extension outside of MOS AA along GATE poly length direction (except the SRAM region).>= 0.12um
  X = (NACT AND VTNH) TOUCH EDGE GATE
  Y = ENC X VTNH < 0.12 ABUT<90 OPPOSITE REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
 }
VTNH_S_5 {
@ Space between VTNH and MOS AA of other device along other deviceâs GATE poly length direction, excluding SRAM region>= 0.12um
  X1 = NACT TOUCH EDGE (AA INSIDE EDGE GT)
  X2 = PACT TOUCH EDGE (AA INSIDE EDGE GT)
  X = X1 OR EDGE X2
  ((EXT X VTNH < 0.12 ABUT<90 REGION OPPOSITE) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
VTNH_EX_6 {
