}
DFM_D_20_Max {
    @ Local GT density (including dummy): Density check window size 200um*200um, step size 100um>= 0.15
    @ <= 0.65
    Check_region = DRC:1 NOT (OR EXDFMi EXCLUi)
    Check_pattern = (GT_all NOT (OR EXDFMi EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
