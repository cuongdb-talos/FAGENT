OUTERCORNER = EXT M1 <= 0.002 ABUT == 90 INTERSECTING ONLY REGION
INNERCORNER = INT M1 <= 0.002 ABUT == 90 INTERSECTING ONLY REGION
DFM_R_18 {
@ M1 horse shoe space A and C, when B>=0.12 um (See attached picture)>= 0.12
   A = CONVEX EDGE M1 ANGLE1 == 90 ANGLE2 == 90 LENGTH1 > 0.12 LENGTH2 > 0.21 WITH LENGTH >= 0.12 < 0.20
   B = INNERCORNER WITH EDGE A
   B_edge = B COIN EDGE M1
   C = M1 TOUCH EDGE B_edge
   C1 = EXPAND EDGE C INSIDE BY 0.001
   C2 = C1 INTERACT INNERCORNER >= 2 <= 3
   C3 = C2 TOUCH OUTERCORNER >= 1 <= 2
   C3_edge = C3 COIN EDGE M1
   C4 = A TOUCH EDGE C3_edge
   C5 = EXPAND EDGE C4 INSIDE BY 0.001
   D  = CONVEX EDGE M1 ANGLE1 == 270 ANGLE2 == 270 LENGTH1 > 0.12 LENGTH2 > 0.12 WITH LENGTH >= 0.12
   D1 = OUTERCORNER WITH EDGE D
   D1_edge = D1 COIN EDGE M1
   D2 = M1 TOUCH EDGE D1_edge
   D3 = EXPAND EDGE D2 OUTSIDE BY 0.001
   D4 = D3 INTERACT OUTERCORNER == 2
   D5 = D4 TOUCH INNERCORNER == 2
   E1 = C5 TOUCH D5
   E2 = E1 OR D5
   E2_edge = E2 COIN EDGE M1
   E = M1 TOUCH EDGE E2
  (EXT E (M1 TOUCH EDGE B_edge)< 0.12 OPPOSITE REGION) NOT INSIDE EXDFM
}
DFM_S_23 {
@ Space between 1.2V NWs at different nets>= 1um
  (EXT LVNW0 < 1 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXDFM
 // (EXT LVNW_RE LVNW < 1 REGION) NOT INSIDE EXDFM
}
DFM_S_24 {
@ Space between 1.2V NW and 2.5V NW at different nets>= 1.2um
  (EXT LVNW0 MVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE EXDFM
  //(EXT LVNW_RE MVNW < 1.2 REGION) NOT INSIDE EXDFM
  //(EXT MVNW_RE LVNW < 1.2 REGION) NOT INSIDE EXDFM
}
DFM_S_25 {
@ Space between 2.5V NWs at different nets.(LDMOS is excluded for this rule check)>= 1.2um
  ((EXT MVNW0 < 1.2 ABUT<90 SINGULAR REGION NOT CONNECTED)NOT INSIDE LDBK) NOT INSIDE EXDFM
  //((EXT MVNW_RE MVNW < 1.2 REGION)NOT INSIDE LDBK) NOT INSIDE EXDFM
}
DFM_W_26a {
@ Channel width for 1.2V NMOS/PMOS transistors>= 0.12um
  Y = LENGTH GATE_M_W < 0.12
  ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_W_26b {
@ Channel width for 2.5V NMOS/PMOS transistors>= 0.4um
  Y = LENGTH GATE_D_W < 0.4
  ((EXPAND EDGE Y INSIDE BY 0.001) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_27a {
@ Space between AAs that are on the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP).>= 0.11um
  Y = OR NW DNW VTNH VTPH LVN LVP PW
  ((EXT AA < 0.11 ABUT<90 SINGULAR REGION) INSIDE Y) NOT INSIDE EXDFM
}
DFM_S_27b {
@ Space between AAs with one or both AA width greater than 0.15um that are on the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP)>= 0.13um
  Y = OR NW DNW VTNH VTPH LVN LVP PW
  X = AA WITH WIDTH > 0.15
  ((EXT X AA < 0.13 SINGULAR REGION)INSIDE Y) NOT INSIDE EXDFM
}
DFM_EN_28 {
@ N+AA enclosure by NW (excluding NW interacting with RESNW)>= 0.16um
  (ENC NACT (NW NOT INTERACT RESNW) < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_29 {
@ Space between NW and N+AA inside PW, except NW resistor region (except the INST region).>= 0.16um
  ((EXT (NW NOT INTERACT RESNW) (NACT INSIDE PW) < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EN_30 {
@ P+AA enclosure by NW >= 0.16um
  (ENC PACT NW < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_31 {
@ Space between NW to P+AA inside PW>= 0.16um
  (EXT NW (PACT INSIDE PW) < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_A_32 {
@ AA area >= 0.054um2
  (AREA AA < 0.054) NOT INSIDE EXDFM
}
DFM_W_33 {
@ NW width >= 0.47um
  (INT NW < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_34 {
@ Space between 1.2V NWs at same potential>= 0.47um
  (EXT LVNW0 < 0.47 ABUT<90 SINGULAR REGION CONNECTED) NOT INSIDE EXDFM
}
DFM_A_38 {
@ NW area >= 1.2um2
 (AREA NW < 1.2) NOT INSIDE EXDFM
}
DFM_W_39 {
@ PSUB width >= 0.47um
 (INT PSUB < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_L_40a {
@ 2.5V (or overdrive to 3.3V) native NMOS channel length>= 1.2um
  X = PBGT INSIDE EDGE ((PBAA AND DG) AND OVERPL)
  (INT X < 1.2 ABUT<90 REGION) NOT INSIDE EXDFM
}
DFM_S_41 {
@ Space between PSUBs >= 0.47um
 (EXT PSUB < 0.47 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_EN_42 {
@ MOS AA enclosure by PSUB = 0.26um
 X = SIZE PBMOS BY 0.26
 Y = PSUB INTERACT PBMOS
 (XOR X Y) NOT INSIDE EXDFM
}
DFM_EX_43 {
@ Extension of native NMOS poly GATE outside of AA. DRC waive INDMY covered regions.>= 0.35um
 ((ENC PBAA PBGT < 0.35 ABUT<90 REGION OPPOSITE) NOT INSIDE INDMY) NOT INSIDE EXDFM
}
DFM_EX_44 {
@ VTNH extension outside of MOS AA along GATE poly length direction. (except the SRAM region).>= 0.16um
  //X = (NACT AND VTNH) TOUCH EDGE GATE
  //Y = ENC X VTNH < 0.16 ABUT<90 OPPOSITE REGION
  //(Y NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTNH4_E = GATE COIN EDGE GT
  GATE_VTNH4_E_V = ANGLE GATE_VTNH4_E == 90
  GATE_VTNH4_B_V = EXPAND EDGE GATE_VTNH4_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_VTNH4_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  ((ENC MOS_AA_H_E VTNH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTNH4_E_H = ANGLE GATE_VTNH4_E == 0
  GATE_VTNH4_B_H = EXPAND EDGE GATE_VTNH4_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_VTNH4_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  ((ENC MOS_AA_V_E VTNH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_45 {
@ Space between VTNH and MOS AA of other device along other deviceâs GATE poly length direction (except the SRAM region).>= 0.16um
 // X1 = NACT TOUCH EDGE (AA INSIDE EDGE GT)
 // X2 = PACT TOUCH EDGE (AA INSIDE EDGE GT)
 // X = X1 OR EDGE X2
 // ((EXT X VTNH < 0.16 ABUT<90 REGION OPPOSITE) NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTNH5_E = GATE COIN EDGE GT
  GATE_VTNH5_E_V = ANGLE GATE_VTNH5_E == 90
  GATE_VTNH5_B_V = EXPAND EDGE GATE_VTNH5_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_VTNH5_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  ((EXT MOS_AA_H_E VTNH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTNH5_E_H = ANGLE GATE_VTNH5_E == 0
  GATE_VTNH5_B_H = EXPAND EDGE GATE_VTNH5_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_VTNH5_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  ((EXT MOS_AA_V_E VTNH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_A_46 {
@ VTNH area (except the SRAM region).>= 0.27um
  ((AREA VTNH < 0.27) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_47 {
@ VTPH extension outside of MOS AA along GATE poly length direction. (except the SRAM region).>= 0.16um
  //X = (PACT AND VTPH) TOUCH EDGE GATE
  //Y = ENC X VTPH < 0.16 ABUT<90 OPPOSITE REGION
  //(Y NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTPH4_E = GATE COIN EDGE GT
  GATE_VTPH4_E_V = ANGLE GATE_VTPH4_E == 90
  GATE_VTPH4_B_V = EXPAND EDGE GATE_VTPH4_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_VTPH4_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  ((ENC MOS_AA_H_E VTPH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTPH4_E_H = ANGLE GATE_VTPH4_E == 0
  GATE_VTPH4_B_H = EXPAND EDGE GATE_VTPH4_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_VTPH4_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  ((ENC MOS_AA_V_E VTPH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_48 {
@ Space between VTPH and MOS AA of other device along other deviceâs GATE poly length direction.(except the SRAM region).>= 0.16um
  //X1 = PACT TOUCH EDGE (AA INSIDE EDGE GT)
  //X2 = NACT TOUCH EDGE (AA INSIDE EDGE GT)
  //X = X1 OR EDGE X2
  //((EXT X VTPH < 0.16 ABUT<90 REGION OPPOSITE) NOT INSIDE INST)NOT INSIDE EXDFM
  GATE_VTPH5_E = GATE COIN EDGE GT
  GATE_VTPH5_E_V = ANGLE GATE_VTPH5_E == 90
  GATE_VTPH5_B_V = EXPAND EDGE GATE_VTPH5_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_VTPH5_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  ((EXT MOS_AA_H_E VTPH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
  GATE_VTPH5_E_H = ANGLE GATE_VTPH5_E == 0
  GATE_VTPH5_B_H = EXPAND EDGE GATE_VTPH5_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_VTPH5_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  ((EXT MOS_AA_V_E VTPH < 0.16 ABUT < 90 REGION) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_A_49 {
@ VTPH area (except the SRAM region).>= 0.27um
  X = AREA VTPH < 0.27
  (X NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_50 {
@ LVN extension outside of MOS AA along GATE poly length direction.>= 0.16um
  GATE_LVN4_E = GATE COIN EDGE GT
  GATE_LVN4_E_V = ANGLE GATE_LVN4_E == 90
  GATE_LVN4_B_V = EXPAND EDGE GATE_LVN4_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_LVN4_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  (ENC MOS_AA_H_E LVN < 0.16 ABUT < 90 REGION) NOT INSIDE EXDFM
  GATE_LVN4_E_H = ANGLE GATE_LVN4_E == 0
  GATE_LVN4_B_H = EXPAND EDGE GATE_LVN4_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_LVN4_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  (ENC MOS_AA_V_E LVN < 0.16 ABUT < 90 REGION) NOT INSIDE EXDFM
}
DFM_S_51 {
@ Space between LVN and MOS AA of other device along other deviceâs GATE poly length direction>= 0.16um
  GATE_LVN5_E = GATE COIN EDGE GT
  GATE_LVN5_E_V = ANGLE GATE_LVN5_E == 90
  GATE_LVN5_B_V = EXPAND EDGE GATE_LVN5_E_V INSIDE BY 0.001
  MOS_AA_H = AA ENCLOSE GATE_LVN5_B_V
  MOS_AA_H_E = ANGLE MOS_AA_H == 0
  (EXT MOS_AA_H_E LVN < 0.16 ABUT < 90 REGION) NOT INSIDE EXDFM
  GATE_LVN5_E_H = ANGLE GATE_LVN5_E == 0
  GATE_LVN5_B_H = EXPAND EDGE GATE_LVN5_E_H INSIDE BY 0.001
  MOS_AA_V = AA ENCLOSE GATE_LVN5_B_H
  MOS_AA_V_E = ANGLE MOS_AA_V == 90
  (EXT MOS_AA_V_E LVN < 0.16 ABUT < 90 REGION ) NOT INSIDE EXDFM
}
DFM_A_52 {
@ LVN area >= 0.27um
 (AREA LVN < 0.27) NOT INSIDE EXDFM
}
DFM_S_53 {
@ Space between DG and MOS AA>= 0.27um
 (EXT DG MOS < 0.27 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_54 {
@ Space between DG and transistor GATE poly (1.2V) along source/drain direction.>= 0.27um
  (EXT DG GATE_M_W < 0.27 ABUT<90 OPPOSITE REGION) NOT INSIDE EXDFM
}
DFM_S_59a {
@ Space between GTs in 1.2V MOS device region. DRC waive check the INDMY and INST covered region.>= 0.13um
 X = (EXT GT < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE DG
 (X NOT INSIDE (INST OR INDMY)) NOT INSIDE EXDFM
}
DFM_S_59b {
@ Space between GTs when one or both GT width > 0.09um in 1.2V MOS device region. DRC waive check the INDMY and INST covered region.>= 0.15um
 X = GT WITH WIDTH > 0.09
 Y = (EXT GT X < 0.15 SINGULAR REGION) NOT INSIDE DG
 (Y NOT INSIDE (INST OR INDMY)) NOT INSIDE EXDFM
}
DFM_S_59c {
@ Space between GTs in 2.5V MOS device region. DRC waive check the INDMY and INST covered region.>= 0.25um
 X = (EXT GT < 0.25 ABUT<90 SINGULAR REGION) INSIDE DG
 (X NOT INSIDE (INST OR INDMY)) NOT INSIDE EXDFM
}
DFM_S_60 {
@ Space between AA and GT on STI (when channel width<0.15um). DRC waive check the INDMY and INST covered region.>= 0.1um
  GT_check = GT WITH EDGE (LENGTH GATE_W < 0.15)
  X = EXT AA GT_check < 0.1 ABUT<90 SINGULAR REGION
  ((X INSIDE STI) NOT INSIDE (INST OR INDMY)) NOT INSIDE EXDFM
}
DFM_EX_61 {
@ Extension of AA outside of GT(not include dummy AA and dummy poly). DRC waive check the INST covered region.>= 0.18um
  ((ENC GT AA < 0.18 ABUT<90 REGION OPPOSITE) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_A_62 {
@ GT enclosed area, except INST region.>= 0.042um
  ((AREA GT < 0.042) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_L_63 {
@ LDMOS GATE Length >= 0.48um
 (INT LDNGATE < 0.48 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
 (INT LDPGATE < 0.48 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_W_64 {
@ STI width for LDMOS transistor drain side field plate= 0.11um
(INT STIDMY < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
(WITH WIDTH STIDMY > 0.11)NOT INSIDE EXDFM
}
DFM_O_65 {
@ Overlap of NW and LDNMOS GATE= 0.2um
(INT NW LDNGATE < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
(WITH WIDTH (NW AND LDNGATE) > 0.2)NOT INSIDE EXDFM
(LDNGATE NOT INTERACT NW)NOT INSIDE EXDFM
(NW TOUCH EDGE LDNGATE)NOT INSIDE EDGE EXDFM
}
DFM_O_66 {
@ Overlap of PW and LDPMOS GATE= 0.2um
 (ENC NW LDPGATE < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
 (WITH WIDTH (LDPGATE NOT NW) > 0.2)NOT INSIDE EXDFM
(LDPGATE NOT INTERACT (HOLES NW INNER)) NOT INSIDE EXDFM
((HOLES NW INNER) TOUCH EDGE LDPGATE) NOT INSIDE EDGE EXDFM
}
DFM_O_67 {
@ GT to STI drain side field plate overlap= 0um
  (GT AND STIDMY) NOT INSIDE EXDFM
  ((STIDMY AND LDBK) NOT TOUCH GT) NOT INSIDE EXDFM
}
DFM_EN_68 {
@ Dummy layer STIDMY is required for LDMOS transistor field plate area;
@ STIDMY enclosure LDMOS drain side filed plate.= 0um
  X = STIDMY AND LDAA
  Y = STIDMY NOT TOUCH (LDAA NOT GT)
  (X OR Y) NOT INSIDE EXDFM
}
DFM_S_69 {
@ Space between SN and P+ AA inside NW, except the INST region.>= 0.13um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SN
  Y = EXT SN X < 0.13 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_70 {
@ SN extension outside of Poly GATE for NMOS along source/drain direction, except the INST region.>= 0.32um
  X = GATE_W INSIDE EDGE SN
  Y = ENC X SN < 0.32 ABUT<90 OPPOSITE REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_71 {
@ Space between SN and poly GATE for PMOS along source/drain direction, except the INST region.>= 0.32um
  X = GATE_W INSIDE EDGE SP
  Y = EXT X SN < 0.32 ABUT<90 OPPOSITE REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_72 {
@ SN extension outside of NMOS AA along GATE poly length direction, if the distance to the related poly is larger than 0.20um. (except the SRAM region)>= 0.13um
  X = NMOS TOUCH EDGE AAEIGT
  Y = ENC X SN < 0.13 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_O_73 {
@ SN and AA overlap >= 0.13um
  (INT SN AA < 0.13 ABUT >0 <90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_A_74 {
@ SN area >= 0.122um2
  (AREA SN < 0.122) NOT INSIDE EXDFM
}
DFM_S_75 {
@ Space between SP and N+ AA inside P well, except the INST region.>= 0.13um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SP
  Y = EXT SP X < 0.13 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_76 {
@ Space between SP and N-channel poly GATE along source/drain direction, except the INST region.>= 0.32um
  X = GT INSIDE EDGE NACT
  Y = EXT SP X < 0.32 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_77 {
@ SP extension outside of PMOS poly GATE along source/drain direction, except the INST region.>= 0.32um
  X = GATE_W INSIDE EDGE SP
  Y = ENC X SP < 0.32 ABUT<90 OPPOSITE REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EX_78 {
@ SP extension outside of PMOS AA along GATE poly length direction, if the distance to the related poly is larger than 0.20Âµm. (except the SRAM region)>= 0.13um
  X = PMOS TOUCH EDGE AAEIGT
  Y = ENC X SP < 0.13 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_O_79 {
@ SP and AA overlap >= 0.13um
  (INT SP (AA NOT TOUCH EDGE SP) < 0.13 ABUT<90 REGION) NOT INSIDE EXDFM
}
DFM_A_80 {
@ SP area >= 0.122um2
  (AREA SP < 0.122) NOT INSIDE EXDFM
}
DFM_W_81 {
@ SAB width >= 0.43um
  (INT SAB < 0.43 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_82 {
@ Space between SABs >= 0.43um
  (EXT SAB < 0.43 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_EX_83 {
@ Extension of AA outside of SAB>= 0.22um
  (ENC SAB AA < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_84 {
@ Space between SAB and AA >= 0.22um
  (EXT SAB AA < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_85 {
@ Space between SAB and GT on AA>= 0.38um
  (EXT SAB GATE < 0.38 ABUT<90 REGION) NOT INSIDE EXDFM
}
DFM_EX_86 {
@ Extension of SAB outside of poly on STI>= 0.22um
  (ENC (GT NOT (AA OR AADUM)) SAB < 0.22 ABUT<90 REGION) NOT INSIDE EXDFM
}
DFM_S_87 {
@ Space between SAB and CT >= 0.22um
  (EXT SAB CT < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_EX_88a {
@ Extension of SAB outside of AA>= 0.22um
  (ENC AA SAB < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_EX_88b {
@ Extension of SAB outside of AA when AA width>10um>= 0.3um
  AA_check = AA WITH WIDTH > 10
  (ENC AA_check SAB < 0.3 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_A_89 {
@ SAB area >= 1um2
  (AREA SAB < 1.0) NOT INSIDE EXDFM
}
DFM_S_90 {
@ Space between SAB and poly on STI.>= 0.3um
  GT_CHECK = GT NOT (AA OR AADUM)
  (EXT SAB GT_CHECK < 0.3 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_91 {
    @ Space between two contacts in case contact array is larger or equal to 4x4. Two contact regions whose space is <=0.15Âµm are considered to be in the same array.>= 0.14um
    X = SIZE CT BY 0.075 OVERUNDER
    Y = SIZE X BY 0.344 UNDEROVER
    Z = CT INTERACT (Y AND CT)
    (EXT Z < 0.14 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_92 {
@ Space between AA and contact on poly>= 0.07um
  (EXT AA (CT AND GT)< 0.07 ABUT<90 SINGULAR REGION) NOT INSIDE EXDFM
}
DFM_S_93a {
@ Space between poly and contact on AA for 1.2V, except the INST region.>= 0.055um
  X = EXT GATE_M CT < 0.055 ABUT<90 SINGULAR REGION
  (((X INSIDE AA) NOT DG) NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_S_93b {
@ Space between poly and contact on AA for 2.5V.>= 0.11um
  X = EXT GATE_D CT < 0.11 ABUT<90 SINGULAR REGION
  ((X INSIDE AA) AND DG) NOT INSIDE EXDFM
}
DFM_EN_94 {
@ CT enclosure by AA for CT landed on AA, except the INST region.>= 0.06um
  X = CT INTERACT AA
  Y = ENC X AA < 0.06 ABUT<90 SINGULAR REGION OUTSIDE ALSO
  (Y NOT INSIDE INST) NOT INSIDE EXDFM
}
DFM_EN_95 {
@ M1 enclosure of CT when the M1 length along CT is >=0.3um>= 0.035um
  X = M1 WITH EDGE (LENGTH M1 >= 0.3)
  (ENC (CT INTERACT X) X < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_EN_100_V1 {
    @ Vn enclosure by Mn+1 or Mn if Mn+1/Mn length along via is >= 0.3um (n =2,3,4,5,6,7)>= 0.035um
    X1 = M1 WITH EDGE (LENGTH M1 >= 0.3)
    X2 = M2 WITH EDGE (LENGTH M2 >= 0.3)
    (ENC (V1 INTERACT X1) X1 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
    (ENC (V1 INTERACT X2) X2 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_EN_100_V2 {
    @ Vn enclosure by Mn+1 or Mn if Mn+1/Mn length along via is >= 0.3um (n =2,3,4,5,6,7)>= 0.035um
    X1 = M2 WITH EDGE (LENGTH M2 >= 0.3)
    X2 = M3 WITH EDGE (LENGTH M3 >= 0.3)
    (ENC (V2 INTERACT X1) X1 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
    (ENC (V2 INTERACT X2) X2 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_EN_100_V3 {
    @ Vn enclosure by Mn+1 or Mn if Mn+1/Mn length along via is >= 0.3um (n =2,3,4,5,6,7)>= 0.035um
    X1 = M3 WITH EDGE (LENGTH M3 >= 0.3)
    X2 = M4 WITH EDGE (LENGTH M4 >= 0.3)
    (ENC (V3 INTERACT X1) X1 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
    (ENC (V3 INTERACT X2) X2 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_EN_100_V4 {
    @ Vn enclosure by Mn+1 or Mn if Mn+1/Mn length along via is >= 0.3um (n =2,3,4,5,6,7)>= 0.035um
    X1 = M4 WITH EDGE (LENGTH M4 >= 0.3)
    X2 = M5 WITH EDGE (LENGTH M5 >= 0.3)
    (ENC (V4 INTERACT X1) X1 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
    (ENC (V4 INTERACT X2) X2 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_EN_100_V5 {
    @ Vn enclosure by Mn+1 or Mn if Mn+1/Mn length along via is >= 0.3um (n =2,3,4,5,6,7)>= 0.035um
    X1 = M5 WITH EDGE (LENGTH M5 >= 0.3)
    X2 = M6 WITH EDGE (LENGTH M6 >= 0.3)
    (ENC (V5 INTERACT X1) X1 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
    (ENC (V5 INTERACT X2) X2 < 0.035 ABUT<90 REGION OUTSIDE ALSO) NOT INSIDE EXDFM
}
DFM_R_101 {
    @ Parallel M1 line width without slot<= 4um
    M1_CHECK = M1 NOT INTERACT M1SLOT
    (M1_CHECK WITH WIDTH > 4) NOT INSIDE EXDFM
}
#IFDEF DENSITY_CHECK YES
DFM_D_102_M1 {
    @ Slot density of wide metal when:
    @ 1.Â  Metal width > 12um for inter-metal, Metal width > 20um for TM1, Metal width > 30um for TM2. Metal width >50um for TKM. DRC checks the metal main pattern (M1, M2...), not following (Mn-MnSLOT)
    @ 2.Â  The wide metal interacts with metal slot (M1SLOT, M2SLOT...)
    @ 3.Â  Metal slot (M1SLOT, M2SLOT...) size > 10*10 um are not included this rule density calculation
    @ 4.Â  DRC doesnât check metals interact with RV
    @ 5.Â  DRC individually exports result by each metal layer>= 0.15
    X_M1 = ((M1i NOT INTERACT RV) WITH WIDTH > 12) INTERACT M1SLOT
    Y_M1 = (M1SLOT WITH WIDTH <=10) NOT INTERACT RV
    Z_M1 = DFM PROPERTY X_M1 Y_M1 OVERLAP [- = AREA(Y_M1)/AREA(X_M1)] < 0.15
    DFM RDB Z_M1 "./Process_CALDRC_logfile/density_report_DFM_D_102_M1.log"
    (DFM COPY Z_M1) NOT INSIDE EXDFM
}
