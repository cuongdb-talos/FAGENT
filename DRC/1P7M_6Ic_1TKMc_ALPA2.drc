DFM_EN_104 {
    @ M1 enclosure of CT when M1 enclosure on one or both perpendicular directions<0.035um, except the INST region.>= 0.035um
    X = RECTANGLE ENC (CT NOT TOUCH M1) M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.035 OPPOSITE 0 0.035 OPPOSITE
    (X NOT INSIDE INST) NOT INSIDE EXDFM
    ((CT NOT M1) NOT INSIDE INST) NOT INSIDE EXDFM
}
