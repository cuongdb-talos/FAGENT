X = NET AREA RATIO ENMOS_D_temp_EMPTY2 ESD3C_EMPTY2 [AREA(ESD3C_EMPTY2)/0.002] < 240
((X INTERACT ENGATE)AND 1_2V_ESD_CASCODED) NOT INSIDE EXCLU
}
