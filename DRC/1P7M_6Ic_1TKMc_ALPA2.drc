TKM_W_1a {
    @ TKM metal width. DRC donât flag 89 to 90 degree widths in the INDMY region>= 2um
    ((INT TKM < 2 ABUT < 90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((INT TKM < 2 ABUT < 89 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
TKM_S_2a1 {
    @ Space between TKMs. DRC donât flag 89 to 90 degree spaces in the INDMY region.>= 2um
    ((EXT TKM < 2 ABUT < 90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT TKM < 2 ABUT < 89 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
TKM_S_2b {
    @ Space between two TKMs when one or both TKM width or length >=16um, and the run length of two TKMs >2um. TKM width or length checked by DRC is perpendicular to run length>= 2um
    span_edge_0 = DFM COPY (DFM SPACE TKMALL < 16 BY INT) EDGE
    span_edge_1 = TKMALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] TKMALL < 2 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2.001) NOT INSIDE EDGE EXCLU
}
TKM_S_3 {
    @ Space between an Inductor TKM and other TKM.
    @ Inductor TKM definition: (INDMY AND TKM)>= 30um
    (EXT (TKM AND INDMY) (TKM NOT INDMY) < 30 OPPOSITE REGION) NOT INSIDE EXCLU
}
TKM_A_4 {
    @ TKM area.
    @ DRC checking allows 0.0004um2 tolerance in INDMY region>= 6um2
    TKM_1 = TKM NOT INTERACT INDMY
    TKM_2 = TKM INTERACT INDMY
    (AREA TKM_1 < 6) NOT INSIDE EXCLU
    (AREA TKM_2 < 6 - 0.0004) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
TKM_A_5 {
    @ Enclosed area.
    @ DRC checking allows 0.0004um2 tolerance in INDMY region.>= 6um2
    X = (HOLES TKM INNER) NOT TKM
    X1 = X NOT INTERACT INDMY
    X2 = X INTERACT INDMY
    (AREA X1 < 6) NOT INSIDE EXCLU
    (AREA X2 < 6 - 0.0004) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
TKM_A_5a {
    @ Enclosed area.
    @ DRC checking allows 0.0004um2 tolerance in INDMY region.>= 9um2
    X = (HOLES TKM INNER) NOT TKM
    X1 = X NOT INTERACT INDMY
    X2 = X INTERACT INDMY
    (AREA X1 < 9) NOT INSIDE EXCLU
    (AREA X2 < 9 - 0.0004) NOT INSIDE EXCLU
}
#ENDIF
TKM_W_6 {
    @ TKM width, except bond pad and INDMY regions.<= 50um
    X = TKM WITH WIDTH > 50
    ((X NOT INTERACT RV) NOT INDMY) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
#IFDEF GUIXI_SPECIAL NO
TKM_D_7a {
    @ TKM density (including dummy) in 400umX400um window with step size 200um.<= 0.7
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (TKMALL NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 400.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(400.0*400.0/4-AREA(Check_window1)))] > 0.7 WINDOW 400.0 STEP 200.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 400.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(400.0*400.0/4-AREA(Check_window2)))] > 0.7 WINDOW 400.0 STEP 200.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 400.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(400.0*400.0/4-AREA(Check_window3)))] > 0.7 WINDOW 400.0 STEP 200.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_TKM_D_7a.log"
    RDB "./Process_CALDRC_logfile/density_report_TKM_D_7a.rdb"
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
TKM_D_7a1 {
    @ TKM density (including dummy) in 50umX50um window with step size 25um.<= 0.8
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (TKMALL NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 50.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window1)))] > 0.8 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 50.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window2)))] > 0.8 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 50.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window3)))] > 0.8 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_TKM_D_7a1.log"
    RDB "./Process_CALDRC_logfile/density_report_TKM_D_7a1.rdb"
}
#ENDIF
TKM_D_7b {
    @ TKM pattern density on the whole chip (including dummy patterns)<= 0.55
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (TKMALL NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [!!AREA(Check_pattern)*(AREA(Check_pattern))/AREA(Check_region)] > 0.55
    PRINT "./Process_CALDRC_logfile/density_report_TKM_D_7b.log"
    RDB "./Process_CALDRC_logfile/density_report_TKM_D_7b.rdb"
}
TKM_D_7c_R {
    @ Recommend the average TKM density of whole chip is larger than 20% (including dummy patterns), otherwise  would help to add dummy patterns.>= 0.2
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (TKMALL NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [(!AREA(Check_pattern)+AREA(Check_pattern)/AREA(Check_region))] < 0.2
    PRINT "./Process_CALDRC_logfile/density_report_TKM_D_7c_R.log"
    RDB "./Process_CALDRC_logfile/density_report_TKM_D_7c_R.rdb"
}
#ENDIF
TKM_R_8 {
    @ Both active and passive devices inside inductor area are not allowed.
    (AND device_all INDMY) NOT INSIDE EXCLU
}
TKM_EX_9 {
    @ TKM Inductor area must by covered by marking layer âINDMYâ and the extension of âINDMYâ beyond TKM.>= 15um
    (ENC (TKM INTERACT INDMY) INDMY < 15 ABUT < 90 OPPOSITE REGION OUTSIDE ALSO) NOT INSIDE EXCLU
}
GROUP GRV RV_?
RV_EN_1_R_4 {
    @ RV_EN_1: RV edge fully enclosure by TM2/TKM directly underneath RV>= 1um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((ENC RV TKM < 1.00 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INDMY) NOT INSIDE EXCLU
    ((ENC RV TKM < 1.00 - 0.002 ABUT<90 SINGULAR REGION OUTSIDE ALSO) AND INDMY) NOT INSIDE EXCLU
}
RV_W_2_R_4 {
    @ RV_W_2: RV width and length >= 3um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((INT RV < 3 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((INT RV < 3 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
RV_S_3_R_4 {
    @ RV_S_3: Space between two RV >= 3um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((EXT RV < 3 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT RV < 3 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RV_S_3a_R_4 {
    @ RV_S_3a: Space between two RV >= 2um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((EXT RV < 2 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT RV < 2 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_ON YES
#IFDEF GUIXI_SPECIAL NO
RV_EN_1_R_R_4 {
    @ RV_EN_1_R: RV edge fully enclosure by TM2/TKM directly underneath RV>= 1.5um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((ENC RV TKM < 1.50 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INDMY) NOT INSIDE EXCLU
    ((ENC RV TKM < 1.50 - 0.002 ABUT<90 SINGULAR REGION OUTSIDE ALSO) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
RV_EN_1a_R_R_4 {
    @ RV_EN_1a_R: RV edge fully enclosure by TM2/TKM directly underneath RV>= 0.35um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((ENC RV TKM < 0.350 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INDMY) NOT INSIDE EXCLU
    ((ENC RV TKM < 0.350 - 0.002 ABUT<90 SINGULAR REGION OUTSIDE ALSO) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
RV_W_2_R_R_4 {
    @ RV_W_2_R: RV width and length >= 55um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((INT RV < 55.0 OPPOSITE REGION PARA ONLY) NOT INDMY) NOT INSIDE EXCLU
    ((INT RV < 55.0 - 0.002 OPPOSITE REGION PARA ONLY) AND INDMY) NOT INSIDE EXCLU
}
RV_S_3_R_R_4 {
    @ RV_S_3_R: Space between two RV >= 5um
    @ RV_R_4: DRC allows 0.002um checking tolerance in INDMY region for RV.EN.1~RV.S.3/ RV.EN.1(R)~RV.S.3(R) rules.
    ((EXT RV < 5.0 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT RV < 5.0 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
GROUP GBCB1 BCB1_?
BCB1_EN_1_R_6 {
@ BCB1_EN_1:  BCB1(RDL via) enclosure by RDL (except fuse, seal ring and guard ring design)>= 1.5um
@ BCB1_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
  X11 = ENC BCB1 RDL < 1.50 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  X1 = X11 NOT INDMY
  ((X1 NOT LOGO) NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
  X22 = ENC BCB1 RDL < 1.50 - 0.002 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
  X2 = X22 AND INDMY
  ((X2 NOT LOGO) NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
}
BCB1_W_2_R_6 {
@ BCB1_W_2:  BCB1(RDL Via) width and length (except fuse, seal ring and guard ring design)>= 3um
@ BCB1_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
  X11 = INT BCB1 < 3 ABUT<90 SINGULAR REGION
  X1 = X11 NOT INDMY
  (X1 NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
  X22 = INT BCB1 < 3 -0.002 ABUT<90 SINGULAR REGION
  X2 = X22 AND INDMY
  (X2 NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
}
#IFDEF GUIXI_SPECIAL NO
BCB1_S_3_R_6 {
@ BCB1_S_3:  Space between two BCB1(RDL vias)>= 3um
@ BCB1_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
  ((EXT BCB1 < 3 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((EXT BCB1 < 3 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
BCB1_S_3_R_6 {
@ BCB1_S_3:  Space between two BCB1(RDL vias)>= 2um
@ BCB1_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
  ((EXT BCB1 < 2 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((EXT BCB1 < 2 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
BCB1_EN_4_R_6 {
    @ BCB1_EN_4: BCB1(RDL via) enclosure by TM2 or other metal layer directly underneath RV (except seal ring and guard ring design)>= 1um
    @ BCB1_R_6: DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
    X11 = ENC BCB1 TKM < 1.00 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
    X1 = X11 NOT INDMY
    ((X1 NOT LOGO) NOT MARKG) NOT INSIDE EXCLU
    X22 = ENC BCB1 TKM < 1.00 -0.002 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO
    X2 = X22 AND INDMY
    ((X2 NOT LOGO) NOT MARKG) NOT INSIDE EXCLU
}
BCB1_S_5_R_6 {
    @ BCB1_S_5: Space between BCB1(RDL via) and RV>= 5um
    @ BCB1_R_6: DRC allows 0.002um checking tolerance in INDMY region for BCB1.EN.1-BCB1.S.5 rules.
    ((EXT BCB1 RV < 5 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT BCB1 RV < 5 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
BCB1_O_7 {
    @ BCB1 is not allowed to be overlapped with RV
    (BCB1 AND RV) NOT INSIDE EXCLU
}
GROUP GRDL RDL_?
RDL_W_1_R_6 {
@ RDL_W_1:  RDL Width (except fuse design)>= 3um
@ RDL_R_6:  DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
  ((INT (RDL NOT FUSE) < 3.0 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((INT (RDL NOT FUSE) < 3.0 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
RDL_S_2a_R_6 {
@ RDL_S_2a:  Space between two RDLs >= 2um
@ RDL_R_6:  DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
  ((EXT RDL < 2.0 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((EXT RDL < 2.0 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
RDL_S_2b_R_6 {
@ RDL_S_2b:  Space between two RDLs with one or both RDL width larger than 10um>= 3um
@ RDL_R_6:  DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
  X1 = (RDL WITH WIDTH > 10) COIN EDGE RDL
  ((EXT X1 RDL <3.0 REGION) NOT INDMY) NOT INSIDE EXCLU
  X2 = (RDL WITH WIDTH > 10) COIN EDGE RDL
  ((EXT X2 RDL <3.0 - 0.002 REGION) AND INDMY) NOT INSIDE EXCLU
}
RDL_S_3_R_6 {
@ RDL_S_3:  Space between RDL and L mark window>= 10um
@ RDL_R_6:  DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
  ((EXT RDL LOGO < 10 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((EXT RDL LOGO < 10 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
RDL_S_4_R_6 {
@ RDL_S_4:  Space between RDL and fuse area (marked by MARKF)>= 10um
@ RDL_R_6:  DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
  ((EXT RDL MARKF < 10 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
  ((EXT RDL MARKF < 10 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
RDL_S_5_R_6 {
    @ RDL_S_5: Space between RDL and RV, except seal-ring regions>= 3.5um
    @ RDL_R_6: DRC allows 0.002um checking tolerance in INDMY region for RDL.W.1-RDL.S.5 rules.
    (((EXT RDL RV < 3.5 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE MARKS) NOT INSIDE EXCLUi
    (((EXT RDL RV < 3.5 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE MARKS) NOT INSIDE EXCLUi
}
GROUP GBCB2 BCB2_?
BCB2_W_1_R_6 {
    @ BCB2_W_1: BCB2 width (suggest to consult with package vendor)>= 10um
    @ BCB2_R_6: DRC allows 0.002um checking tolerance in INDMY region for BCB2.W.1-BCB2.S.4 rules.
    ((INT BCB2 < 10 ABUT<90 SINGULAR REGION) NOT INDMY)NOT INSIDE EXCLU
    ((INT BCB2 < 10 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY)NOT INSIDE EXCLU
}
BCB2_S_2_R_6 {
    @ BCB2_S_2: Space between two BCB2 (suggest to consult with package vendor)>= 5um
    @ BCB2_R_6: DRC allows 0.002um checking tolerance in INDMY region for BCB2.W.1-BCB2.S.4 rules.
    ((EXT BCB2 < 5 ABUT<90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT BCB2 < 5 - 0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
BCB2_EN_3_R_6 {
@ BCB2_EN_3:  BCB2 fully enclosed by RDL>= 1.25um
@ BCB2_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB2.W.1-BCB2.S.4 rules.
  ((ENC BCB2 RDL < 1.25 ABUT<90 SINGULAR REGION) NOT INDMY)NOT INSIDE EXCLU
  ((ENC BCB2 RDL < 1.25-0.002 ABUT<90 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
  (BCB2 NOT RDL)NOT INSIDE EXCLU
}
BCB2_S_4_R_6 {
@ BCB2_S_4:  Space between BCB2 and BCB1 (except fuse and guard ring/seal ring design)>= 1um
@ BCB2_R_6:  DRC allows 0.002um checking tolerance in INDMY region for BCB2.W.1-BCB2.S.4 rules.
  X11 = EXT BCB2 BCB1 < 1 ABUT<90 SINGULAR REGION
  X1 = X11 NOT INDMY
  (X1 NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
  X22 = EXT BCB2 BCB1 < 1 - 0.002 ABUT<90 SINGULAR REGION
  X2 = X22 AND INDMY
  (X2 NOT INSIDE (OR FUSE MARKS MARKF MARKG)) NOT INSIDE EXCLUi
}
BCB2_O_5 {
@ RV and BCB1 is not allowed to be overlapped with BCB2
  X = RV OR BCB1
  (X AND BCB2) NOT INSIDE EXCLU
}
#IFDEF BORDER_CHECK YES
GROUP GBD BD_?
BD_EXTENT = EXTENT DRAWN ORIGINAL
BD_EXTENT_OTHER = EXTENT DRAWN ORIGINAL IGNORE BORDER
BD_OTHER_OUTSIDE = BD_EXTENT_OTHER NOT BORDER
BD_R_1_DNW {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC DNW BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_AA {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC AA BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_NW {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC NW BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_PSUB {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC PSUB BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_VTNH {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC VTNH BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_VTPH {
