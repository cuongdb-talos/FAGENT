SL_D_7_M6_G {
    @ Slot density of wide metal when>= 0.1
    @ 1.Â  Metal width > 12um for inter-metal, Metal width > 20um for TM1, Metal width > 30um for TM2. Metal width >50um for TKM. DRC checks the metal main pattern (M1, M2â¦), not following (Mn-MnSLOT).
    @ 2.Â  The wide metal interacts with metal slot (M1SLOT, M2SLOTâ¦).
    @ 3.Â  Metal slot (M1SLOT, M2SLOTâ¦) size > 10*10 um are not included this rule density calculation.
    @ 4.Â  DRC doesnât check metals interact with RV.
    @ 5.Â  DRC individually exports result by each metal layer.
    X_M6 = ((M6i NOT INTERACT RV) WITH WIDTH > 12) INTERACT M6SLOT
    Y_M6 = (M6SLOT WITH WIDTH <=10) NOT INTERACT RV
    Z_M6 = DFM PROPERTY X_M6 Y_M6 OVERLAP [- = AREA(Y_M6)/AREA(X_M6)] < 0.1
    DFM RDB Z_M6 "./Process_CALDRC_logfile/density_report_SL_D_7_M6_G.log"
    (DFM COPY Z_M6) NOT INSIDE EXCLU
}
SL_D_7_TKM_G {
    @ Slot density of wide metal when>= 0.1
    @ 1.Â  Metal width > 12um for inter-metal, Metal width > 20um for TM1, Metal width > 30um for TM2. Metal width >50um for TKM. DRC checks the metal main pattern (M1, M2â¦), not following (Mn-MnSLOT).
    @ 2.Â  The wide metal interacts with metal slot (M1SLOT, M2SLOTâ¦).
    @ 3.Â  Metal slot (M1SLOT, M2SLOTâ¦) size > 10*10 um are not included this rule density calculation.
    @ 4.Â  DRC doesnât check metals interact with RV.
    @ 5.Â  DRC individually exports result by each metal layer.
    X = ((TKMi NOT INTERACT RV) WITH WIDTH > 50) INTERACT TKMSLOT
    Y = (TKMSLOT WITH WIDTH <=10) NOT INTERACT RV
    Z = DFM PROPERTY X Y OVERLAP [- = AREA(Y)/AREA(X)] < 0.1
    DFM RDB Z "./Process_CALDRC_logfile/density_report_SL_D_7_TKM_G.log"
    (DFM COPY Z) NOT INSIDE EXCLU
}
#ENDIF
SL_R_10_M1_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M1SLOT) NOT INSIDE EXCLU
}
SL_R_10_M2_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M2SLOT) NOT INSIDE EXCLU
}
SL_R_10_M3_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M3SLOT) NOT INSIDE EXCLU
}
SL_R_10_M4_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M4SLOT) NOT INSIDE EXCLU
}
SL_R_10_M5_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M5SLOT) NOT INSIDE EXCLU
}
SL_R_10_M6_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE M6SLOT) NOT INSIDE EXCLU
}
SL_R_10_TKM_G {
    @ Metal slot must be rectangle.
    (NOT RECTANGLE TKMSLOT) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF ESD_CHECK YES
GROUP GESD ESD_?
ESD_W_2_G {
@ Unit finger width (F) of NMOS and PMOS for ESD protection device (Fig.2)>= 15um
@ <= 60um
(LENGTH EGATE_W < 15) NOT INSIDE EDGE EXCLU
(LENGTH EGATE_W > 60) NOT INSIDE EDGE EXCLU
}
/*
ESD_W_3_G {
@ ESD.3(G) is defined for total channel width of ESD N/PMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, RV and PA but not broken by resistors. SAB is used for drain recognition in DRC runset.
@ Channel width (W) of NMOS and PMOS for ESD protection device (Channel width=Finger width x Finger No.)>= 360um
X = NET AREA RATIO ENGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 360
Y = NET AREA RATIO EPGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 360
((X INTERACT ENGATE) NOT INTERACT EGATE_NOSAB) NOT INSIDE EXCLU
((Y INTERACT EPGATE) NOT INTERACT EGATE_NOSAB) NOT INSIDE EXCLU
}
*/
#IFDEF HBM_TARGET HBM_2KV
ESD_W_3a_G {
@ Total channel width of 1.2V ESD NMOS for HBM 2KV, except the ESDCAS region.>= 240
X = NET AREA RATIO ENGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 240
(((X INTERACT ENGATE) NOT INTERACT EGATE_NOSAB)AND 1_2V_ESD_MOS) NOT INSIDE EXCLU
}
