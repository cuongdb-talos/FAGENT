#ENDIF
DFM_R_21 {
    @ For parallel long NW (run length > 50um), must make NW width >= 1.07um or NW to NW space >= 1.07um>= 1.07um
    X1 = EXT NW < 1.07 OPPOSITE REGION PARA ONLY
    X2 = LENGTH X1 > 50
    X3 = EXPAND EDGE X2 OUTSIDE BY 1.07
    X4 = X3 NOT INTERACT (X3 NOT NW)
    X5 = INT X2 < 1.07 REGION
    (X5 NOT INTERACT X4) NOT INSIDE EXDFM
}
DFM_S_96_M1 {
    @ Space between two M1s having parallel segment >0.5um with one or both M1 width>0.2um> 0.11um
    span_edge_0 = DFM COPY (DFM SPACE M1ALL < 0.201 BY INT) EDGE
    span_edge_1 = M1ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M1ALL < 0.111 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.501) NOT INSIDE EDGE EXDFM
}
DFM_S_98_M2 {
    @ Space between two Mns having parallel segment >0.5um with one or both Mn width>0.2um (n = 2,3,4,5,6,7,8)> 0.11um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 0.201 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.111 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.501) NOT INSIDE EDGE EXDFM
}
DFM_S_98_M3 {
    @ Space between two Mns having parallel segment >0.5um with one or both Mn width>0.2um (n = 2,3,4,5,6,7,8)> 0.11um
