GROUP GDG DG_?
#IFDEF GUIXI_SPECIAL NO
DG_W_1 {
@ DG width >= 0.46um
  (INT DG < 0.46 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_S_2 {
@ Space between two DGs, merge if the space is less than 0.46um>= 0.46um
  (EXT DG < 0.46 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_3 {
@ Enclosure of AA by DG(Except pick-up AA)>= 0.25um
  (ENC (AA NOT (NTAP OR PTAP)) DG < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
DG_W_1a {
@ DG width >= 0.44um
  (INT DG < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_S_2a {
@ Space between two DGs, merge if the space is less than 0.46um>= 0.44um
  (EXT DG < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_3a {
@ Enclosure of AA by DG(Except pick-up AA)>= 0.165um
  (ENC (AA NOT (NTAP OR PTAP)) DG < 0.165 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
DG_EN_4 {
@ Enclosure of MOS AA by DG along GATE poly direction>= 0.27um
  X = MOS TOUCH EDGE (GATE INSIDE DG)
  ENC X DG < 0.27 ABUT<90 REGION
}
DG_S_5 {
@ Space between DG and MOS AA>= 0.25um
  (EXT DG MOS < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
 // (EXT DG AA_LDMOS < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
DG_EN_8 {
@ Enclosure of NW beyond DG, set the value to 0 if the enclosure is less than 0.46um>= 0.46um
  (ENC DG NW > 0 < 0.46 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_S_9 {
@ Space or extension of DG to NW, set the value to 0 if it is smaller than 0.46um>= 0.46um
  (ENC NW DG > 0 < 0.46 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
  (EXT NW DG > 0 < 0.46 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_O_10 {
@ Overlap of DG and NW, set the value to 0 if it is smaller than 0.46um>= 0.46um
  (INT DG NW > 0 < 0.46 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
DG_EN_8a {
@ Enclosure of NW beyond DG, set the value to 0 if the enclosure is less than 0.36um>= 0.36um
  (ENC DG NW > 0 < 0.36 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_S_9a {
@ Space or extension of DG to NW, set the value to 0 if it is smaller than 0.36um>= 0.36um
  (ENC NW DG > 0 < 0.36 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
  (EXT NW DG > 0 < 0.36 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_O_10a {
@ Overlap of DG and NW, set the value to 0 if it is smaller than 0.36um>= 0.36um
  (INT DG NW > 0 < 0.36 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
DG_EN_11a {
@ Enclosure of DG beyond PSUB, space or extension of PSUB to DG, overlap of PSUB and DG, set the value to 0 if it is smaller than 0.32um>= 0.32um
  (ENC PSUB DG > 0 < 0.32 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_11b {
@ Enclosure of DG beyond PSUB, space or extension of PSUB to DG, overlap of PSUB and DG, set the value to 0 if it is smaller than 0.32um>= 0.32um
  (EXT PSUB DG > 0 < 0.32 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_11c {
@ Enclosure of DG beyond PSUB, space or extension of PSUB to DG, overlap of PSUB and DG, set the value to 0 if it is smaller than 0.32um>= 0.32um
  (ENC DG PSUB > 0 < 0.32 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_11d {
@ Enclosure of DG beyond PSUB, space or extension of PSUB to DG, overlap of PSUB and DG, set the value to 0 if it is smaller than 0.32um>= 0.32um
  (INT DG PSUB > 0 < 0.32 ABUT>0<90 SINGULAR REGION) NOT INSIDE EXCLU
}
DG_EN_12 {
@ Enclosure of GATE by DG, along source/drain direction>= 0.33um
  (ENC GATE_W DG < 0.33 ABUT<90  REGION OPPOSITE) NOT INSIDE EXCLU
}
DG_S_13 {
@ Space between DG and 1.2V GATE along source/drain direction>= 0.33um
  (EXT DG GATE_M_W < 0.33 ABUT<90 OPPOSITE REGION) NOT INSIDE EXCLU
}
DG_R_14 {
@ DG straddle GATE is not allowed
  (DG CUT (GATE NOT INSIDE DG)) NOT INSIDE EXCLU
}
GROUP GGT GT_?
GT_L_1a {
    @ Channel length for 1.2V NMOS /PMOS transistors>= 0.06um
    X = GT INSIDE EDGE (AA NOT INTERACT DG)
    (INT X < 0.06 ABUT<90 REGION) NOT INSIDE EXCLU
}
GT_L_1b {
    @ Channel length for 2.5V NMOS/PMOS transistors, except the INST region>= 0.28um
    X = GT INSIDE EDGE (((AA AND DG) NOT INTERACT UNDEPL) NOT INTERACT OVERPL)
    ((INT X < 0.28 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_L_1c {
    @ Channel length for 2.5V over drive to 3.3V NMOS/PMOS transistors (GT_25OD33), except the INST region>= 0.50(NMOS)um
    @ >= 0.40(PMOS)um
    X = GT INSIDE EDGE ((NACT AND DG) AND OVERPL)
    Y = GT INSIDE EDGE ((PACT AND DG) AND OVERPL)
    ((INT X < 0.50 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
    ((INT Y < 0.40 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_L_1d {
    @ Channel length for 2.5V under drive to 1.8V NMOS/PMOS transistors (GT_25UD18), except the INST region>= 0.22um
    X = GT INSIDE EDGE ((AA AND DG) AND UNDEPL)
    ((INT X < 0.22 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_L_1e {
    @ Channel length for 2.5V drain drive to 5V NMOS/PMOS transistors (GT_25DD50), except the INST region>= 0.50(NMOS)um
    @ >= 0.45(PMOS)um
    X = GT INSIDE EDGE ((NACT AND DG) AND MOSOV5)
    Y = GT INSIDE EDGE ((PACT AND DG) AND MOSOV5)
    ((INT X < 0.50 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
    ((INT Y < 0.45 ABUT<90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_W_2 {
    @ Width of interconnect poly>= 0.06um
    (INT INTERGT < 0.06 ABUT<90 REGION) NOT INSIDE EXCLU
}
GT_S_3a {
    @ Space between two GTs. DRC waive check the INDMY and INST covered region.>= 0.12um
    X = EXT GT < 0.12 ABUT<90 SINGULAR REGION
    ((X NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_S_3b {
    @ Space between two GTs when one or both GT width is >= 0.4um, and the run length of two GTs is >= 0.5um.>= 0.16um
    GT_W = WITH WIDTH GT >= 0.4
    GT_S = EXT GT_W GT < 0.16 OPPOSITE REGION PARA ONLY
    GT_LS = LENGTH GT_S >= 0.5
    (GT_S WITH EDGE GT_LS) NOT INSIDE EDGE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_S_3b1 {
    @ Space between two GTs when one or both GT width is >= 0.4um, and the run length of two GTs is >= 0.5um.>= 0.15um
    GT_W = WITH WIDTH GT >= 0.4
    GT_S = EXT GT_W GT < 0.15 OPPOSITE REGION PARA ONLY
    GT_LS = LENGTH GT_S >= 0.5
    (GT_S WITH EDGE GT_LS) NOT INSIDE EDGE EXCLU
}
#ENDIF
LAYER MAP 999 DATATYPE 1119 9999
LAYER EMPTY 9999
GT_EMPTY = EMPTY OR (GT AND AA)
AA_EMPTY = EMPTY OR AA
CONNECT GT_EMPTY AA_EMPTY
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
GT_S_3c_R {
    @ Recommended space between GTs on the same AA. DRC waive check if no contacts between two GTs. DRC waive check if no contacts between two GTs, and waive check the INDMY and INST covered region.>= 0.19um
    X = EXT GT_EMPTY < 0.19 ABUT<90 SINGULAR REGION CONNECTED
    Y = X INTERACT CT
    ((Y NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_S_3d_R {
    @ Recommended space between GTs on the same AA inside DG. DRC waive check if no contacts between two GTs. DRC waive check if no contacts between two GTs, and waive check the INDMY and INST covered region.>= 0.24um
    X = EXT (GT_EMPTY AND DG) < 0.24 ABUT<90 SINGULAR REGION CONNECTED
    Y = X INTERACT CT
    ((Y NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_S_3d1_R {
    @ Recommended space between GTs on the same AA inside DG. DRC waive check if no contacts between two GTs. DRC waive check if no contacts between two GTs, and waive check the INDMY and INST covered region.>= 0.18um
    X = EXT (GT_EMPTY AND DG) < 0.18 ABUT<90 SINGULAR REGION CONNECTED
    Y = X INTERACT CT
    ((Y NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#ENDIF
GT_S_3e {
    @ Space between two GTs on AA. DRC waive check the INDMY covered region.>= 0.13um
    X = (AA AND GT) COIN EDGE GT
    Y = EXT X < 0.13 ABUT < 90 REGION
    (Y NOT INSIDE INDMY) NOT INSIDE EXCLU
}
GT_S_4 {
    @ Space between AA and GT on STI. DRC waive check the INDMY and INST covered region.>= 0.05um
    X = EXT AA GT < 0.05 ABUT<90 SINGULAR REGION
    (((X INSIDE STI) NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_EX_5 {
    @ Extension of AA outside of GT (not include dummy AA and dummy Poly), except AA COIN EDGE STIDMY. DRC waive check the INST covered region.>= 0.115um
    ((ENC GT (AA NOT COIN EDGE STIDMY) < 0.115 ABUT<90 REGION OPPOSITE) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_EX_6 {
    @ Extension of GATE poly outside of AA (not including dummy AA and dummy poly). DRC waive check INDMY, LDBK and INST covered regions, DRC waive the jog region if extension GT with jog.>= 0.14um
    Y = ENC AA GT < 0.14 ABUT<90 OPPOSITE REGION
    Z = EXT GT < 0.005 ABUT==90 REGION INTERSECTING ONLY
    ((((Y NOT TOUCH Z) NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_EX_6a {
    @ Extension of GATE poly outside of AA (not including dummy AA and dummy poly). DRC waive check INDMY, LDBK and INST covered regions, DRC waive the jog region if extension GT with jog.>= 0.12um
    Y = ENC AA GT < 0.12 ABUT<90 OPPOSITE REGION
    Z = EXT GT < 0.005 ABUT==90 REGION INTERSECTING ONLY
    ((((Y NOT TOUCH Z) NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
GT_EX_6_R {
    @ Extension of GATE poly outside of AA (not including dummy AA and dummy poly)
    @ DRC waive check INDMY, LDBK and INST covered regions.>= 0.14um
    ((((ENC AA GT < 0.14 ABUT<90 OPPOSITE REGION) NOT INSIDE INDMY) NOT INSIDE INST) NOT INSIDE EXCLU)NOT INSIDE LDBK
}
GT_EX_6a_R {
    @ GT end-cap extension of AA when:
    @ 1.Â  GT space to L-shape AA in the same MOS is < 0.1um
    @ 2.Â  GATE channel width (W) is >= 0.15um
    @ DRC only check the L-shape opposite side GT end-cap.>= 0.16um
    A = ENC AA GT < 0.16 OPPOSITE REGION
    X = LENGTH GATE_W >= 0.15
    Y = GATE WITH EDGE X
    B = EXT [Y] AA < 0.1 ABUT==90 PERP ONLY
    (A WITH EDGE (A TOUCH EDGE B)) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF DENSITY_CHECK YES
GT_D_7a_Min {
    @ Local GT density (including dummy) in 200um*200um window with step size: 100um.>= 0.07
    @ <= 0.7
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (GT_all NOT EXCLUi) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.07 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.07 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.07 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_GT_D_7a_Min.log"
    RDB "./Process_CALDRC_logfile/density_report_GT_D_7a_Min.rdb"
}
GT_D_7a_Max {
    @ Local GT density (including dummy) in 200um*200um window with step size: 100um.>= 0.07
    @ <= 0.7
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (GT_all NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window1)))] > 0.7 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window2)))] > 0.7 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.7 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_GT_D_7a_Max.log"
    RDB "./Process_CALDRC_logfile/density_report_GT_D_7a_Max.rdb"
}
GT_D_7b_Min {
    @ Global GT density for fully chip (including dummy)>= 0.1
    @ <= 0.45
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (GT_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [(!AREA(Check_pattern)+AREA(Check_pattern)/AREA(Check_region))] < 0.1
    PRINT "./Process_CALDRC_logfile/density_report_GT_D_7b_Min.log"
    RDB "./Process_CALDRC_logfile/density_report_GT_D_7b_Min.rdb"
}
GT_D_7b_Max {
    @ Global GT density for fully chip (including dummy)>= 0.1
    @ <= 0.45
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (GT_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [!!AREA(Check_pattern)*(AREA(Check_pattern))/AREA(Check_region)] > 0.45
    PRINT "./Process_CALDRC_logfile/density_report_GT_D_7b_Max.log"
    RDB "./Process_CALDRC_logfile/density_report_GT_D_7b_Max.rdb"
}
GT_D_7c {
    @ GT density inside of dummy block area (DUMBP OR NODMF), while the area of dummy block layer is larger than 2500um2 (50X50um).>= 0.1
    X = AREA (DUMBP OR NODMF) > 2500
    Check_region = X NOT EXCLUi
    Check_pattern = (GT_all NOT EXCLUi) AND Check_region
    DENSITY Check_pattern Check_region [(!AREA(Check_pattern)+AREA(Check_pattern)/AREA(Check_region))] < 0.1
    PRINT "./Process_CALDRC_logfile/density_report_GT_D_7c.log"
    RDB "./Process_CALDRC_logfile/density_report_GT_D_7c.rdb"
}
#ENDIF
GT_R_8 {
    @ No bent GT on AA are allowed. All GT patterns on AA have to be orthogonal to AA edge.
    @ DRC waive check the INDMY and INST covered region, and waive check (AA AND GT) width <= 0.01um pattern.
    GTEIAA1 = GTEIAA COIN EDGE ((GT AND AA) WITH WIDTH > 0.01)
    ((INT GTEIAA1 < 0.01 ABUT == 90 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    ((EXT GTEIAA1 < 0.01 ABUT == 90 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    ((INT GTEIAA1 < 0.01 ABUT == 45 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    ((EXT GTEIAA1 < 0.01 ABUT == 45 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    ((INT GTEIAA1 < 0.01 ABUT == 135 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    ((EXT GTEIAA1 < 0.01 ABUT == 135 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
    AAEIGT1 = AAEIGT COIN EDGE ((GT AND AA) WITH WIDTH > 0.01)
    ((INT GTEIAA1 AAEIGT1 < 0.01 ABUT != 90 REGION) NOT INSIDE (INDMY OR INST)) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_EX_9_SN {
    @ SN and SP extension outside of poly resistor. Poly resistor enclosed by SN/SP. DRC waive check the INST covered region.>= 0.16um
    ((ENC (GT AND RESP1) SN < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_EX_9_SP {
    @ SN and SP extension outside of poly resistor. Poly resistor enclosed by SN/SP. DRC waive check the INST covered region.>= 0.16um
    ((ENC (GT AND RESP1) SP < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_EX_9a_SN {
    @ SN and SP extension outside of poly resistor. Poly resistor enclosed by SN/SP. DRC waive check the INST covered region.>= 0.15um
    ((ENC (GT AND RESP1) SN < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_EX_9a_SP {
    @ SN and SP extension outside of poly resistor. Poly resistor enclosed by SN/SP. DRC waive check the INST covered region.>= 0.15um
    ((ENC (GT AND RESP1) SP < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
GT_S_10_SP {
    @ Space between NLL, NLH, SN and P type poly resistor, Space between PLL,PLH, SP and N type poly resistor. DRC waive check the INST covered region.>= 0.16um
    X = (GTR AND SP) AND RESP1
    Y = OR NLL NLH SN
    ((EXT Y X < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_S_10_SN {
    @ Space between NLL, NLH, SN and P type poly resistor, Space between PLL,PLH, SP and N type poly resistor. DRC waive check the INST covered region.>= 0.16um
    X = (GTR AND SN) AND RESP1
    Y = OR PLL PLH SP
    ((EXT Y X < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_EN_11 {
    @ GT is enclosed by SN and/or SP. except MOM and HRPDMY area (when checking the rule, size down the HRPDMY by 0.3um along the current direction)
    @ DRC waive check the INST covered region.
    HRPR = GT INTERACT HRPDMY
    HRP_END = SIZE (HRPR NOT HRPDMY) BY 0.3
    GT_MID = ( GT INTERACT (HRPDMY OR HRP)) NOT HRP_END
    Y = ((((GT INTERACT CT) NOT GT_MID) NOT SP) NOT SN) NOT INTERACT MOMDMY
    (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
GT_O_12 {
    @ SN and SP overlap on GT is not allowed.
    ((GT AND SN) AND SP) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_A_13 {
    @ GT area, except INST region.>= 0.038um2
    ((AREA GT < 0.038) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_A_13b {
    @ GT area, except INST region.>= 0.0375um2
    ((AREA GT < 0.0375) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
GT_A_13a {
    @ GT enclosed area >= 0.05um2
    (AREA ((HOLES GT INNER) NOT GT) < 0.05) NOT INSIDE EXCLU
}
GT_W_14 {
    @ Width of 45 degree GT on STI>= 0.19um
    GT_CHECK = GT INSIDE STI
    X = ANGLE GT_CHECK >= 44.9 <= 45.1
    (INT X < 0.19 ABUT<90 REGION) NOT INSIDE EXCLU
}
GT_S_15 {
    @ Space to 45-degree GT on STI, except EFUSE region GT.>= 0.19um
    GT_CHECK = GT INSIDE STI
    X = ANGLE GT_CHECK >= 44.9 <= 45.1
    ((EXT X < 0.19 ABUT<90 REGION) NOT INSIDE EFUSE) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
GT_S_16 {
    @ GATE space when L-shape AA and L-shape GT enclosed area is < 0.012 um2>= 0.15um
    X = AA_LS OR GT_LS
    Y = AREA (HOLES X INNER) < 0.012
    Z = GATE INTERACT Y SINGULAR ONLY
    ((EXT Z < 0.15 ABUT<90 REGION) INTERACT Y) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
GT_S_16a {
    @ GATE space when L-shape AA and L-shape GT enclosed area is < 0.012 um2>= 0.14um
    X = AA_LS OR GT_LS
    Y = AREA (HOLES X INNER) < 0.012
    Z = GATE INTERACT Y SINGULAR ONLY
    ((EXT Z < 0.14 ABUT<90 REGION) INTERACT Y) NOT INSIDE EXCLU
}
#ENDIF
GT_S_17 {
    @ Space between large GT and GATE with narrow channel length<= 0.08 Âµm.
    @ The large GT definition:
    @ GT area >= 630 Âµm2 and within regions of density > 70% in window 30 Âµm x 30 Âµm, stepping 15 Âµm. Dummy poly isnât included in the density check.>= 1um
    Density_region = DENSITY GT > 0.7 WINDOW 30 STEP 15
    Large_GT = (AREA GT >= 630) INSIDE Density_region
    GATE_LE = (GATE TOUCH EDGE (INT GATE_W [GATE] < 0.005 ABUT INTERSECTING ONLY)) NOT COIN EDGE GATE_W
    GATE_check = GATE WITH EDGE (LENGTH GATE_LE <= 0.08)
    EXT Large_GT GATE_check < 1 ABUT<90 SINGULAR REGION
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
GT_S_18_R {
    @ Space between GT dense line end to line (Dh) or GT line to line (Ds) when:
    @ 1.Â  GT line end definition: GT width < 0.14Âµm
    @ 2.Â  Run length of GT line to line or GT line to end: E1 >= -0.03Âµm
    @ Any one edge distance from the corner of the two edges: K1 < 0.14Âµm
    @ Any one of Dh or Ds meet this rule value is ok.
    @ 3.Â  DRC waive check GT small extrusion F < 0.04Âµm and exclude SRAM region.>= 0.14um
    LINE_END = CONVEX EDGE GT ANGLE1 ==90 LENGTH1 >=0.04 ANGLE2 ==90 LENGTH2 >=0.04 WITH LENGTH < 0.14
    LINE_END_SHAPE1 = EXPAND EDGE LINE_END INSIDE BY 0.11
    LINE_SIDE1 = (GT COIN EDGE LINE_END_SHAPE1 ) NOT COIN EDGE LINE_END
    LINE_END_SHAPE = EXPAND EDGE LINE_END INSIDE BY 0.14
    LINE_SIDE = (GT COIN EDGE LINE_END_SHAPE ) NOT COIN EDGE LINE_END
    LINE_END_EXP = EXPAND EDGE LINE_END INSIDE BY 0.001 EXTEND BY 0.03
    LINE_SIDE_EXP = EXPAND EDGE LINE_SIDE1 INSIDE BY 0.001 EXTEND BY 0.03
    LINE_END_1 = LINE_END_EXP TOUCH EDGE LINE_END
    LINE_SIDE_1 = LINE_SIDE_EXP TOUCH EDGE LINE_SIDE
    E1 = EXT [LINE_END_1] GT < 0.14 OPPOSITE PERP ALSO OBTUSE ALSO
    E2 = EXT [LINE_SIDE] < 0.14 OPPOSITE
    LINE_END_E1 = LINE_END_1 TOUCH EDGE E1
    LINE_SIDE_E2 = LINE_SIDE_1 TOUCH EDGE E2
    GT_CORNER = INT LINE_END_E1 LINE_SIDE_E2 <= 0.002 ABUT == 90 REGION
    ((LINE_END_SHAPE INTERACT GT_CORNER) OUTSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIDELINE_CHECK_TURN_OFF YES
GT_L_19_G {
    @ GT length between two CTs without GATE, and the length from any point inside GATE to nearest CT, when the GT width is < 0.13um. This rule is for voltage drop concern. DRC waive check ESDIO1 or ESDMOS covered region.<= 25um
    GT_CHECK = ((WITH WIDTH GT < 0.13) NOT GATE) INTERACT CT
    Z0 = SIZE CT BY 12.5 INSIDE OF GT_CHECK STEP 0.02
    ((GT_CHECK INTERACT Z0 > 1) NOT INSIDE (ESDIO1 OR ESDMOS)) NOT INSIDE EXCLU
    X = GATE WITH EDGE (LENGTH GATE_L < 0.13)
    Y = (GT INTERACT X) INTERACT CT
    Z = SIZE CT BY 25 INSIDE OF Y STEP 0.02
    (((GATE INTERACT Y) NOT INSIDE Z) NOT INSIDE (ESDIO1 OR ESDMOS)) NOT INSIDE EXCLU
}
#ENDIF
GT_O_20 {
    @ GT overlap AA must produce two or more AAs, except the INDMY, LDBK and INST covered regions.
    (((GT AND AA) NOT WITH EDGE (GT INSIDE EDGE AA) == 2) NOT INSIDE (OR INDMY INST LDBK)) NOT INSIDE EXCLU
}
GT_L_21 {
    @ H-shape GATE is forbidden when:
    @ 1.Â  GATE channel length is < 0.11um
    @ 2.Â  GT center bar length < 0.425um
    @ 3.Â Â  All four H-legs Length (X) >0.065um, and all four H-legs width (Y) <0.265um
    GT_CHECK = GT_HS INTERACT AA
    X1 = CONVEX EDGE GT_CHECK == 0
    Y1 = INT X1 < 0.11 REGION OPPOSITE
    Y11 = INT (Y1 INSIDE EDGE AA) < 0.11 REGION OPPOSITE
    X2 = LENGTH (Y1 TOUCH EDGE Y11) < 0.425
    Y2 = EXPAND EDGE X2 INSIDE BY 0.001
    X3 = CONVEX EDGE GT_CHECK == 1
    Y3 = GT_CHECK WITH EDGE (LENGTH X3 > 0.065) == 4
    X4 = CONVEX EDGE GT_CHECK == 2
    Y4 = INT X3 X4 < 0.265 REGION OPPOSITE
    ((((GT_CHECK INTERACT Y1) INTERACT Y2) INTERACT Y3) INTERACT Y4) NOT INSIDE EXCLU
}
GT_R_22 {
    @ UNDEPL/OVERPL layers must be inside DG layer.
    @ UNDEPL layer should be defined for 2.5V under-drive to 1.8V device(GT_25UD18), and OVERPL layer should be defined for 2.5V over-drive to 3.3V IO device. (GT_25OD33).
    (UNDEPL NOT DG) NOT INSIDE EXCLU
    (OVERPL NOT DG) NOT INSIDE EXCLU
}
GROUP GSN SN_?
SN_W_1 {
@ SN width. Single-point-interaction is allowed.>= 0.18um
  (INT SN < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
SN_S_2 {
@ Space between two SNs. Single-point-interaction is allowed.>= 0.18um
  (EXT SN < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SN_S_3 {
@ Space between SN and P+ AA inside NW, except the INST region.>= 0.1um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SN
  Y = EXT SN X < 0.10 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SN_S_3a {
@ Space between SN and P+ AA inside NW, except the INST region.>= 0.09um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SN
  Y = EXT SN X < 0.09 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
SN_S_4 {
@ Space between SN and P+ pick-up AA inside PW>= 0.02um
  X = PTAP NOT TOUCH EDGE NACT
  Y = X NOT TOUCH EDGE SN
  (EXT SN Y < 0.02 ABUT<90 REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SN_S_5 {
@ Space between SN and PMOS GATE along source/drain direction, except the INST region>= 0.24um
  X = GATE_W INSIDE EDGE SP
  Y = EXT X SN < 0.24 ABUT<90 OPPOSITE  REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SN_EX_6_8 {
@ SN_EX_6:  SN extension outside of NMOS GATE along source/drain direction, except the INST region>= 0.24um
@ SN_EX_8:  SN extension outside of NMOS AA along GATE poly length direction, if the distance to the related poly is less than or equal to 0.20um (except the INST region)>= 0.16um
  SN_S = SN NOT INSIDE INST
  NACT_S = NACT NOT INSIDE INST
  CMACRO SNP_68 SN_S NACT_S 0.24 0.16 0.2
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SN_S_5a {
@ Space between SN and PMOS GATE along source/drain direction, except the INST region>= 0.22um
  X = GATE_W INSIDE EDGE SP
  Y = EXT X SN < 0.22 ABUT<90 OPPOSITE  REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SN_EX_6a_8a {
@ SN_EX_6a:  SN extension outside of NMOS GATE along source/drain direction, except the INST region>= 0.22um
@ SN_EX_8a:  SN extension outside of NMOS AA along GATE poly length direction, if the distance to the related poly is less than or equal to 0.20um (except the INST region)>= 0.15um
  SN_S = SN NOT INSIDE INST
  NACT_S = NACT NOT INSIDE INST
  CMACRO SNP_68 SN_S NACT_S 0.22 0.15 0.2
}
#ENDIF
SN_EX_7 {
@ SN extension outside of NMOS AA along GATE poly length direction, if the distance to the related poly is larger than 0.20um (except the INST region)>= 0.12um
  X = NMOS TOUCH EDGE AAEIGT
  Y = ENC X SN < 0.12 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SN_EN_9a {
@ N+AA enclosure by SN in NW. DRC wavie NW resistor.>= 0.02um
  X = ((NTAP NOT INTERACT NWR) NOT COIN EDGE PACT) NOT COIN EDGE SP
  ((ENC X SN < 0.02 ABUT<90 REGION) INSIDE NW) NOT INSIDE EXCLU
}
SN_EN_9b {
@ N+AA enclosure by SN in PW, except the INST region.>= 0.02um
  X = (NACT NOT COIN EDGE PACT) NOT COIN EDGE SP
  (((ENC X SN < 0.02 ABUT<90 REGION) INSIDE PW) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
SN_EN_9b_R {
@ N+AA enclosure by SN in PW, except the INST region and NW resistor.>= 0.12um
  X = ((NACT NOT INTERACT NWR) NOT COIN EDGE PACT) NOT COIN EDGE SP
  (((ENC X SN < 0.12 ABUT<90 REGION) INSIDE PW) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
SN_O_10 {
@ Overlap of SN and AA >= 0.09um
  (INT SN AA < 0.09 ABUT >0 <90 SINGULAR REGION) NOT INSIDE EXCLU
}
SN_A_11 {
@ SN area >= 0.1um2
  (AREA SN < 0.10) NOT INSIDE EXCLU
}
SN_A_11a {
@ SN enclosed area >= 0.1um2
  (AREA ((HOLES SN INNER) NOT SN) < 0.10 ) NOT INSIDE EXCLU
}
SN_S_12 {
@ Space between SN and butted P+AA (except SRAM area).= 0um
  X = SN AND PACT
  (X NOT INSIDE INST) NOT INSIDE EXCLU
}
SN_S_13 {
@ Butted P+ pick-up AA space to GT in the same AA (the butted N+ACTIVE extending <0.18um)>= 0.24um
  NAAL = NACT TOUCH INSIDE EDGE NGATE
  NAAL_EP = EXPAND EDGE NAAL OUTSIDE BY 0.18 EXTEND BY 0.01
  BUTNA_ED = PACT COIN EDGE (NACT NOT NTAP)
  BUTNA_ED_1 = BUTNA_ED INSIDE EDGE NAAL_EP
  BUTSN_1 = (PACT INTERACT PW) WITH EDGE BUTNA_ED_1
  GTSN_1 = (GT INSIDE EDGE ((NACT NOT NTAP) TOUCH PACT)) COIN EDGE NGATE
  GTSN   = (GT WITH EDGE GTSN_1) TOUCH EDGE NGATE
  (EXT BUTSN_1 GTSN < 0.24 ABUT<90 REGION) NOT INSIDE EXCLU
}
GROUP GSP SP_?
SP_W_1 {
@ SP width. Single-point-interaction is allowed.>= 0.18um
  (INT SP < 0.18 ABUT<90 REGION) NOT INSIDE EXCLU
}
SP_S_2 {
@ Space between two SPs. Single-point-interaction is allowed.>= 0.18um
  (EXT SP < 0.18 ABUT<90 OPPOSITE REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SP_S_3 {
@ Space between SP and N+ AA inside P well, except the INST region.>= 0.1um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SP
  Y = EXT SP X < 0.10 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SP_S_3a {
@ Space between SP and N+ AA inside P well, except the INST region.>= 0.09um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SP
  Y = EXT SP X < 0.09 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
SP_S_4 {
@ Space between SP and N+ AA inside N well>= 0.02um
  X = NTAP NOT TOUCH EDGE PACT
  Y = X NOT TOUCH EDGE SP
  (EXT SP Y < 0.02 ABUT<90 REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SP_S_5 {
@ Space between SP and NMOS GATE along source/drain direction, except the INST region.>= 0.24um
  X = GT INSIDE EDGE NACT
  Y = EXT SP X < 0.24 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SP_EX_6_8 {
@ SP_EX_6:  SP extension outside of PMOS GATE along source/drain direction, except the INST region.>= 0.24um
@ SP_EX_8:  SP extension outside of PMOS AA along GATE poly length direction, if the distance to the related poly is less than or equal to 0.20um (except SRAM area).>= 0.16um
 SP_S = SP NOT INSIDE INST
 PACT_S = PACT NOT INSIDE INST
 CMACRO SNP_68 SP_S PACT_S 0.24 0.16 0.2
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SP_S_5a {
@ Space between SP and NMOS GATE along source/drain direction, except the INST region.>= 0.22um
  X = GT INSIDE EDGE NACT
  Y = EXT SP X < 0.22 ABUT<90 REGION OPPOSITE
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SP_EX_6a_8a {
@ SP_EX_6a:  SP extension outside of PMOS GATE along source/drain direction, except the INST region.>= 0.22um
@ SP_EX_8a:  SP extension outside of PMOS AA along GATE poly length direction, if the distance to the related poly is less than or equal to 0.20um (except SRAM area).>= 0.15um
 SP_S = SP NOT INSIDE INST
 PACT_S = PACT NOT INSIDE INST
 CMACRO SNP_68 SP_S PACT_S 0.22 0.15 0.2
}
#ENDIF
SP_EX_7 {
@ SP extension outside of PMOS AA along GATE poly length direction, if the distance to the related poly is larger than 0.20um (except SRAM area).>= 0.12um
  X = PMOS TOUCH EDGE AAEIGT
  Y = ENC X SP < 0.12 ABUT<90 REGION
  (Y NOT INSIDE INST) NOT INSIDE EXCLU
}
SP_EN_9a {
@ P+ AA enclosure by SP in PW>= 0.02um
  X = (PTAP NOT COIN EDGE NACT) NOT COIN EDGE SN
  ((ENC X SP < 0.02 ABUT<90 REGION) INSIDE PW) NOT INSIDE EXCLU
}
SP_EN_9b {
@ P+ AA enclosure by SP in NW, except the INST region.>= 0.02um
  X = (PACT NOT COIN EDGE NACT) NOT COIN EDGE SN
  (((ENC X SP < 0.02 ABUT<90 REGION) INSIDE NW) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
SP_EN_9b_R {
@ P+ AA enclosure by SP in NW, except the INST region.>= 0.12um
  X = (PACT NOT COIN EDGE NACT) NOT COIN EDGE SN
  (((ENC X SP < 0.12 ABUT<90 REGION) INSIDE NW) NOT INSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
SP_O_10 {
@ Overlap of SP and AA >= 0.09um
  (INT SP (AA NOT TOUCH EDGE SP) < 0.09 ABUT<90 REGION) NOT INSIDE EXCLU
}
SP_A_11 {
@ SP area >= 0.1um2
  (AREA SP < 0.100) NOT INSIDE EXCLU
}
SP_EN_11a {
@ SP enclosed area >= 0.1um2
  (AREA ((HOLES SP INNER) NOT SP) < 0.10) NOT INSIDE EXCLU
}
SP_S_12 {
@ Space between SP and butted N+AA (except SRAM area).= 0um
  X = SP AND NACT
  (X NOT INSIDE INST) NOT INSIDE EXCLU
}
SP_O_13 {
@ SP overlap with SN is not allowed
  (AND SN SP) NOT INSIDE EXCLU
}
SP_S_15 {
@ Butted N+ pick-up AA space to GT in the same AA (the butted P+ACTIVE extending <0.18um)>= 0.24um
  PAAL = PACT TOUCH INSIDE EDGE PGATE
  PAAL_EP = EXPAND EDGE PAAL OUTSIDE BY 0.18 EXTEND BY 0.01
  BUTNA_ED = NACT COIN EDGE (PACT NOT PTAP)
  BUTNA_ED_1 = BUTNA_ED INSIDE EDGE PAAL_EP
  BUTSN_1 = (NACT INTERACT NW) WITH EDGE BUTNA_ED_1
  GTSP_1 = (GT INSIDE EDGE (PACT  TOUCH NACT)) COIN EDGE PGATE
  GTSP   = (GT WITH EDGE GTSP_1) TOUCH EDGE PGATE
  (EXT BUTSN_1 GTSP < 0.24 ABUT<90 REGION) NOT INSIDE EXCLU
}
GROUP GSAB SAB_?
#IFDEF GUIXI_SPECIAL NO
SAB_W_1 {
@ SAB width >= 0.4um
  (INT SAB < 0.40 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SAB_S_2a {
@ Space between two SABs >= 0.4um
  (EXT SAB < 0.40 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SAB_W_1a {
@ SAB width >= 0.36um
  (INT SAB < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SAB_S_2a1 {
@ Space between two SABs >= 0.36um
  (EXT SAB < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
SAB_S_2b {
@ Space between two SABs when one or both SABs interact with GT. DRC waive if no (GT OR AA) exists in the space region.>= 0.45um
  ((EXT (SAB INTERACT GT) SAB < 0.45 ABUT<90 SINGULAR REGION) INTERACT (GT OR AA)) NOT INSIDE EXCLU
}
SAB_EX_3 {
@ Extension of AA outside of SAB>= 0.2um
  (ENC SAB AA < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SAB_S_4 {
@ Space between SAB and AA >= 0.2um
  (EXT SAB AA < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SAB_S_4a {
@ Space between SAB and AA >= 0.15um
  (EXT SAB AA < 0.15 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
SAB_S_5 {
@ Space between SAB and GATE.SAB overlap with GATE is forbidden, DRC waive ESDIO1/ ESDMOS regions and waive the total SAB which overlaps GATE 60nm.>= 0.36um
  ((EXT SAB GATE < 0.36 ABUT<90 REGION) NOT INSIDE (ESDIO1 OR ESDMOS)) NOT INSIDE EXCLU
  ESD_REGION = INT GATE_W SAB == 0.06 OPPOSITE REGION
  (((SAB NOT INTERACT ESD_REGION) AND GATE) NOT INSIDE (ESDIO1 OR ESDMOS)) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SAB_EX_6 {
@ Extension of SAB outside of poly on STI>= 0.2um
  (ENC (GT NOT (AA OR AADUM)) SAB < 0.2 ABUT<90 REGION) NOT INSIDE EXCLU
}
SAB_S_7 {
@ Space between SAB and CT >= 0.2um
  (EXT SAB CT < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SAB_EX_8 {
@ Extension of SAB outside of AA>= 0.2um
  (ENC AA SAB < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SAB_EX_6a {
@ Extension of SAB outside of poly on STI>= 0.17um
  (ENC (GT NOT (AA OR AADUM)) SAB < 0.17 ABUT<90 REGION) NOT INSIDE EXCLU
}
SAB_S_7a {
@ Space between SAB and CT >= 0.18um
  (EXT SAB CT < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SAB_EX_8a {
@ Extension of SAB outside of AA>= 0.17um
  (ENC AA SAB < 0.17 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
SAB_O_9 {
@ SAB overlap with SN or SP>= 0.2um
  (INT SN SAB < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
  (INT SP SAB < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
SAB_A_10 {
@ SAB area >= 1um2
  (AREA SAB < 1.0) NOT INSIDE EXCLU
}
SAB_EN_10a {
@ SAB enclosed area >= 1um2
  (AREA ((HOLES SAB INNER) NOT SAB)< 1.0) NOT INSIDE EXCLU
}
SAB_S_11 {
@ Space between SAB and poly on STI.>= 0.28um
  GT_CHECK = GT NOT (AA OR AADUM)
  (EXT SAB GT_CHECK < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
SAB_A_10b {
@ SAB area >= 0.3um2
  (AREA SAB < 0.3) NOT INSIDE EXCLU
}
SAB_EN_10a1 {
@ SAB enclosed area >= 0.3um2
  (AREA ((HOLES SAB INNER) NOT SAB)< 0.3) NOT INSIDE EXCLU
}
SAB_S_11a {
@ Space between SAB and poly on STI.>= 0.2um
  GT_CHECK = GT NOT (AA OR AADUM)
  (EXT SAB GT_CHECK < 0.2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
SAB_EX_12_R {
@ Extension on unsilicided AA/GT when SAB width is >10um. DRC waive if >= 5 poly fingers interact with the SAB.>= 0.3um
  SAB_CHECK = (SAB WITH WIDTH > 10) NOT INTERACT (GT AND SAB) > 4
  (ENC ((AA OR GT) INTERACT SAB) SAB_CHECK < 0.3 ABUT < 90 REGION) NOT INSIDE EXCLU
}
#ENDIF
SAB_R_13 {
@ Butted SN/SP on unsillcided AA/GT is not allowed.
  SAB_CHECK = (AA AND SAB) OR (GT AND SAB)
  ((SN COIN EDGE SP) INSIDE EDGE SAB_CHECK ) NOT INSIDE EDGE EXCLU
}
GROUP GCT CT_?
CT_R_1 {
@ Fixed contact size (square shape)
@ DRC waive rectangular CT in SRAM and EFUSE area, and waive protection ring purpose non-rectangular CT in MARKG and MARKS area.= 0.09um
  X = NOT RECTANGLE CT == 0.09 BY == 0.09
  (X NOT INSIDE ((MARKG OR INST) OR EFUSE)) NOT INSIDE EXCLU
  (NOT RECTANGLE (RECTANGLE (CT AND INST) ASPECT == 1) == 0.09 BY == 0.09) NOT INSIDE EXCLU
}
CT_S_2a {
@ Space between two contacts, except INST region.>= 0.11um
  ((EXT CT < 0.11 ABUT<90 SINGULAR REGION) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
CT_S_2b {
    @ Space between two contacts in case contact array is larger or equal to 4x4. Two contact regions whose space is <=0.15um are considered to be in the same array.>= 0.13um
    X = SIZE CT BY 0.075 OVERUNDER
    Y = SIZE X BY 0.344 UNDEROVER
    Z = CT INTERACT (Y AND CT)
    (EXT Z < 0.13 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
CT_S_2b1 {
    @ Space between two contacts in case contact array is larger or equal to 4x4. Two contact regions whose space is <=0.15um are considered to be in the same array.>= 0.13um
    X = SIZE CT BY 0.075 OVERUNDER
    Y = SIZE X BY 0.344 UNDEROVER
    Z = CT INTERACT (Y AND CT)
    (EXT Z < 0.14 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
CT_S_2c_R {
@ CT space at different nets, except INST region.>= 0.12um
 (EXT CT < 0.12 ABUT<90 SINGULAR REGION NOT CONNECTED) NOT INSIDE (INST OR EXCLU)
}
CT_S_2d_R {
@ CT space at different nets when parallel run length is > 0um, except INST region.>= 0.14um
 CT_S = EXT CT < 0.14 ABUT<90 OPPOSITE REGION PARA ONLY NOT CONNECTED
 CT_LS = LENGTH CT_S > 0
 (CT_S WITH EDGE CT_LS ) NOT INSIDE (INST OR EXCLU)
}
#ENDIF
CT_S_3 {
@ Space between AA and contact on poly>= 0.065um
  (EXT AA (CT AND GT) < 0.065 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
CT_S_4a {
@ Space between GATE and contact on AA for 1.2V, except INST region.>= 0.05um
  X = EXT GATE_M (CT AND AA) < 0.05 ABUT<90 SINGULAR REGION
  ((X NOT DG) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
CT_S_4b {
@ Space between GATE and contact on AA for 2.5V>= 0.09um
  X = EXT GATE_D (CT AND AA) < 0.09 ABUT<90 SINGULAR REGION
  (X AND DG) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
CT_S_4b1 {
@ Space between GATE and contact on AA for 2.5V>= 0.07um
  X = EXT GATE_D (CT AND AA) < 0.07 ABUT<90 SINGULAR REGION
  (X AND DG) NOT INSIDE EXCLU
}
#ENDIF
CT_EN_5 {
@ CT enclosure by AA for CT landed on AA, except INST region.>= 0.015um
  X = CT INTERACT AA
  ((ENC X AA < 0.015 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
CT_EN_5a_R {
@ CT enclosure by AA when one or both perpendicular directions is <0.03um, except INST region.>= 0.03um
 X = RECTANGLE ENC (CT INTERACT AA) AA ABUT<90 OUTSIDE ALSO GOOD 0.015 OPPOSITE 0.03 OPPOSITE 0.015 OPPOSITE 0.03 OPPOSITE
 Y = ENC [X] AA < 0.03 OPPOSITE
 ((INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE INST) NOT INSIDE EXCLU
 (((CT INTERACT AA) NOT AA) NOT INSIDE INST) NOT INSIDE EXCLU
}
CT_EN_6a_R {
@ CT enclosure by poly when one or both perpendicular directions is <0.04um, except INST region.>= 0.04um
 X = RECTANGLE ENC (CT INTERACT GT) GT ABUT<90 OUTSIDE ALSO GOOD 0.01 OPPOSITE 0.04 OPPOSITE 0.01 OPPOSITE 0.04 OPPOSITE
 Y = ENC [X] GT < 0.04 OPPOSITE
 ((INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE INST) NOT INSIDE EXCLU
 (((CT INTERACT GT) NOT GT) NOT INSIDE INST) NOT INSIDE EXCLU
}
CT_EN_7c_R {
@ M1 enclosure of CT, when M1 width is >1um.>= 0.04um
 M1_CHECK = M1 WITH WIDTH > 1
 CT_CHECK = (CT INTERACT M1_CHECK) NOT TOUCH M1_CHECK
 (ENC CT_CHECK M1 < 0.04 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
CT_EN_6 {
@ CT enclosure by poly for CT landed on poly, except INST region.>= 0.01um
  X = CT INTERACT GT
  ((ENC X GT < 0.01 ABUT<90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE INST) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
CT_EN_7a_7b {
@ CT_EN_7a:  M1 enclosure of CT, except INST region.>= 0um
@ CT_EN_7b:  M1 enclosure of CT when M1 enclosure on one or both perpendicular directions < 0.025um, except INST region.>= 0.025um
 // X = CT INTERACT M1
 // (RECTANGLE ENC X M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.025 OPPOSITE 0 0.025 OPPOSITE) NOT INSIDE EXCLU
 // (X NOT M1) NOT INSIDE EXCLU
 // (CT NOT INTERACT M1) NOT INSIDE EXCLU
  X = RECTANGLE ENC (CT NOT TOUCH M1) M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.025 OPPOSITE 0 0.025 OPPOSITE
  A = ENC [X] M1 < 0.025 OPPOSITE
  ((INT A < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE INST) NOT INSIDE EXCLU      //For CT not touching M1
  B = CT COIN EDGE M1
  ((INT B < 0.005 ABUT==90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU       //For CT touch M1 with >= 2 butting edges
  Y = ENC CT M1 < 0.025 OPPOSITE REGION
  C1 = CT COIN EDGE M1
  C2 = CT COIN EDGE Y
  ((INT C1 C2 < 0.005 ABUT==90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU	//For CT touch M1 with == 1 edge
  (CT NOT M1) NOT INSIDE EXCLU
  (CT NOT INTERACT M1) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
CT_EN_7a_7c {
@ CT_EN_7a:  M1 enclosure of CT, except INST region.>= 0um
@ CT_EN_7c:  M1 enclosure of CT when M1 enclosure on one or both perpendicular directions < 0.025um, except INST region.>= 0.02um
 // X = CT INTERACT M1
 // (RECTANGLE ENC X M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.025 OPPOSITE 0 0.025 OPPOSITE) NOT INSIDE EXCLU
 // (X NOT M1) NOT INSIDE EXCLU
 // (CT NOT INTERACT M1) NOT INSIDE EXCLU
  X = RECTANGLE ENC (CT NOT TOUCH M1) M1 ABUT<90 OUTSIDE ALSO GOOD 0 0.025 OPPOSITE 0 0.025 OPPOSITE
  A = ENC [X] M1 < 0.02 OPPOSITE
  ((INT A < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE INST) NOT INSIDE EXCLU      //For CT not touching M1
  B = CT COIN EDGE M1
  ((INT B < 0.005 ABUT==90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU       //For CT touch M1 with >= 2 butting edges
  Y = ENC CT M1 < 0.02 OPPOSITE REGION
  C1 = CT COIN EDGE M1
  C2 = CT COIN EDGE Y
  ((INT C1 C2 < 0.005 ABUT==90 REGION) NOT INSIDE INST) NOT INSIDE EXCLU	//For CT touch M1 with == 1 edge
  (CT NOT M1) NOT INSIDE EXCLU
  (CT NOT INTERACT M1) NOT INSIDE EXCLU
}
#ENDIF
CT_R_9  {
@ CT is not allowed to land on GATE, except INST region.
  ((AND GATE CT) NOT INSIDE INST) NOT INSIDE EXCLU
}
CT_O_10 {
@ CT should land on salicided surface (except MARKG/MARKS covered area) and CT cannot overlap with (STI without poly) (except SRAM and Efuse area).
@ Waive the CT cutting AA in SRAM area.
  CT_CHECK = CT NOT ((CT CUT AA) AND INST)
  ((CT_CHECK NOT ((AA OR GT) NOT SAB) ) NOT INSIDE (MARKG OR MARKS)) NOT INSIDE EXCLU
  ((CT_CHECK AND (STI NOT GT)) NOT INSIDE (INST OR EFUSE)) NOT INSIDE EXCLU
}
CT_R_11 {
@ CT must be fully covered by M1 and (AA OR GT), except INST region.
  ((CT NOT (M1 AND (GT OR AA))) NOT INSIDE INST) NOT INSIDE EXCLU
}
CT_O_12 {
@ Itâs not allowed CT overlap with NW, AA, Poly, HRP and M1 resistor. For NW, AA, Poly, HRP resistor, please refer each resistor section definition.
@ M1 resistor definition: (M1 AND M1R).
  (CT AND NW_resistor) NOT INSIDE EXCLU
  (CT AND AA_resistor) NOT INSIDE EXCLU
  (CT AND GT_resistor) NOT INSIDE EXCLU
  (CT AND HRP_resistor) NOT INSIDE EXCLU
  (CT AND (M1 AND M1R)) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
CT_S_13_R {
@ Space to butted SN/SP edge on AA (overlap of SN/SP boundary on AA is not allowed)>= 0.06um
  X = (SN COIN EDGE SP) NOT OUTSIDE EDGE AA
  Y = (SP COIN EDGE SN) NOT OUTSIDE EDGE AA
  (X INSIDE EDGE CT) NOT INSIDE EDGE EXCLU
  (Y INSIDE EDGE CT) NOT INSIDE EDGE EXCLU
  (ENC CT X < 0.06 ABUT<90 REGION) NOT INSIDE EXCLU
  (ENC CT Y < 0.06 ABUT<90 REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIDELINE_CHECK_TURN_OFF YES
CT_R_14_G {
@ Both source/drain and butted well pick up side should be put CT to avoid high Rs.
  CHECK_SD = OR (PSD TOUCH NTAP) (NSD TOUCH PTAP)
  CHECK_TAP = OR (NTAP TOUCH PSD) (PTAP TOUCH NSD)
  (CHECK_SD NOT ENCLOSE CT) NOT INSIDE EXCLU
  (CHECK_TAP NOT ENCLOSE CT) NOT INSIDE EXCLU
}
#ENDIF
GROUP GM1 M1_?
M1_W_1 {
    @ M1 width >= 0.09um
    (INT M1 < 0.09 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M1_S_2a {
    @ Space between two M1s. DRC waive check 89 to 90 degree spaces in the INDMY. DRC waive check the INST region.>= 0.09um
    X = EXT M1 < 0.09 ABUT<90 SINGULAR REGION
    ((X NOT INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
    Y = EXT M1 < 0.09 ABUT<89 SINGULAR REGION
    ((Y AND INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
M1_S_2b {
    @ Space between two M1s when one or both M1 width or length>=1um, and the run length of two M1s is >=2um.
    @ M1 width or length direction checked by DRC is perpendicular to run length direction.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M1ALL < 1 BY INT) EDGE
    span_edge_1 = M1ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M1ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
M1_S_2c {
    @ Space between two M1s when one or both M1 width or length >=5um, and run length of two M1s is >=2um.
    @ M1 width or length direction checked by DRC is perpendicular to run length direction.>= 0.5um
    span_edge_0 = DFM COPY (DFM SPACE M1ALL < 5 BY INT) EDGE
    span_edge_1 = M1ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M1ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
M1_W_3 {
    @ M1 width <= 12um
    (M1 WITH WIDTH > 12) NOT INSIDE EXCLU
}
M1_A_4 {
    @ M1 area (except SRAM area).>= 0.027um2
    X = AREA M1 < 0.027
    (X NOT INSIDE INST) NOT INSIDE EXCLU
}
M1_EN_5 {
    @ Enclosed area by M1 >= 0.13um2
    X = (HOLES M1 INNER) NOT M1
    (AREA X < 0.13) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
M1_D_6a_min {
    @ M1 density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M1ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6a_min.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6a_min.rdb"
}
M1_D_6a_max {
    @ M1 density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M1ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window1)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window2)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6a_max.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6a_max.rdb"
}
M1_D_6b {
    @ M1 density (including dummy) in 50umX50um window with step size 25um.<= 0.9
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (M1ALL NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 50.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window1)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 50.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window2)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 50.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window3)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6b.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6b.rdb"
}
M1_D_6c {
    @ The difference between M1 density in 200umX200um with step size 200um and those of the adjacent checking windows (including dummy). INDMY/MARKG/MARKF/MARKS covered areas are excluded for this rule checking<= 0.45
    Check_pattern = M1ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    DENSITY Check_pattern Check_region [AREA(Check_pattern)/AREA(Check_region)] >= 0 WINDOW 200.0 GRADIENT > 0.45 ABSOLUTE BACKUP
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6c.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6c.rdb"
}
M1_D_6d {
    @ M1 density (including dummy) in 25umX25um window with step size 12.5um.
    @ INDMY/MARKG/MARKS covered areas are excluded for this rule checking>= 0.1
    Check_region = DRC:1 NOT (OR INDMY MARKG MARKS EXCLUi)
    Check_pattern = (M1ALL NOT (OR INDMY MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6d.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6d.rdb"
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M1_D_6e_min_R {
    @ M1 average density inside the dummy block area ((DUMBM OR M1DUB) OR NODMF) in 25umX25um window with step size 12.5um when the dummy block area >= 25umX25um.
    @ INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking.>= 0.1
    @ <= 0.9
    X = OR DUMBM M1DUB NODMF
    Y = SIZE X BY 12.5 UNDEROVER
    Check_region = Y NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M1ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6e_min_R.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6e_min_R.rdb"
}
M1_D_6e_max_R {
    @ M1 average density inside the dummy block area ((DUMBM OR M1DUB) OR NODMF) in 25umX25um window with step size 12.5um when the dummy block area >= 25umX25um.
    @ INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking.>= 0.1
    @ <= 0.9
    X = OR DUMBM M1DUB NODMF
    Y = SIZE X BY 12.5 UNDEROVER
    Check_region = Y NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M1ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window1)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window2)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window3)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M1_D_6e_max_R.log"
    RDB "./Process_CALDRC_logfile/density_report_M1_D_6e_max_R.rdb"
}
#ENDIF
#ENDIF
M1_S_7 {
    @ Space between metal lines with one or both are 45 degree, and the bending metal length>=0.5um
    @ (the area with 0.1um distance from bending point need not follow this rule)>= 0.105um
    X_45 = ANGLE M1 >= 44.9 <= 45.1
    Y = LENGTH X_45 >= 0.5
    (EXT Y < 0.105 REGION) NOT INSIDE EXCLU
    (EXT Y M1 < 0.105 REGION CORNER TO EDGE) NOT INSIDE EXCLU
}
#IFDEF GUIXI_SPECIAL NO
M1_S_11 {
    @ Space(S1 or S2) at M1 line-end (W<0.11um) in a dense-line-end configuration: If M1 has parallel run length with opposite M1 (measured with E1>=-0.035um extension) along 2 adjacent edges of M1 (any one edge distance from the corner of the two edges: K1<0.11um), then one of the space (S1 or S2) needs to be at least this value (except for small jog with edge length < 0.09um). DRC waive check the INST covered region.>= 0.11um
    LINE_END = CONVEX EDGE M1 ANGLE1 == 90 LENGTH1 >= 0.09 ANGLE2 == 90 LENGTH2 >= 0.09 WITH LENGTH < 0.11
    LINE_END_SHAPE = EXPAND EDGE LINE_END INSIDE BY 0.11
    LINE_SIDE = (M1 COIN EDGE LINE_END_SHAPE ) NOT COIN EDGE LINE_END
    LINE_END_EXP = EXPAND EDGE LINE_END INSIDE BY 0.001 EXTEND BY 0.035
    LINE_SIDE_EXP = EXPAND EDGE LINE_SIDE INSIDE BY 0.001 EXTEND BY 0.035
    LINE_END_1 = LINE_END_EXP TOUCH EDGE LINE_END
    LINE_SIDE_1 = LINE_SIDE_EXP TOUCH EDGE LINE_SIDE
    E1 = EXT [LINE_END_1] M1 < 0.11 OPPOSITE PERP ALSO OBTUSE ALSO
    E2 = EXT [LINE_SIDE] < 0.11 OPPOSITE
    LINE_END_E1 = LINE_END_1 TOUCH EDGE E1
    LINE_SIDE_E2 = LINE_SIDE_1 TOUCH EDGE E2
    M1_CORNER = INT LINE_END_E1 LINE_SIDE_E2 <= 0.002 ABUT == 90 REGION
    ((LINE_END_SHAPE INTERACT M1_CORNER) OUTSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
GROUP GM2 M2_?
M2_W_1 {
    @ Mn width >= 0.1um
    (INT M2 < 0.1 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M2_S_2a {
    @ Space between two Mns. DRC waive check 89 to 90 degree spaces in the INDMY region. (If n=2, DRC waive check the INST region)>= 0.1um
    X = EXT M2 < 0.1 ABUT<90 SINGULAR REGION
    ((X NOT INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
    Y = EXT M2< 0.10 ABUT<89 SINGULAR REGION
    ((Y AND INDMY) NOT INSIDE INST) NOT INSIDE EXCLU
}
M2_S_2b {
    @ Space between two Mns when one or both Mn width or length>=1um, and the run length of two Mns is >=2um. Mn width or length direction checked by DRC is perpendicular to run length direction.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 1 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
M2_S_2c {
    @ Space between two Mns when one or both Mn width or length >=5um, and the run length of two Mns is >=2um.
    @ M1 width or length direction checked by DRC is perpendicular to run length direction.>= 0.5um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 5 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M2_S_2d_R {
    @ Space between two Mns when one or both Mn width >=0.4um, and the parallel run length of two Mns is >= 0.4um.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M2ALL < 0.4 BY INT) EDGE
    span_edge_1 = M2ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M2ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.4) NOT INSIDE EDGE EXCLU
}
#ENDIF
M2_W_3 {
    @ Mn width (Exclude DUPMK1 region when Mn as TM-1 in 1 top metal option)<= 12um
    (M2 WITH WIDTH > 12)NOT INSIDE EXCLU
}
M2_A_4 {
    @ Mn area (If n=2, DRC waive check the INST region).>= 0.035 um 2
    X = AREA M2 < 0.035
    (X NOT INSIDE INST) NOT INSIDE EXCLU
}
M2_EN_5 {
    @ Enclosed area by Mn >= 0.12 um 2
    X = (HOLES M2 INNER) NOT M2
    (AREA X < 0.12) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
M2_D_6a_min {
    @ Mn density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking
    @ (Exclude DUPMK1 region when when Mn as TM-1 in 1 top metal option)>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M2ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M2_D_6a_min.log"
    RDB "./Process_CALDRC_logfile/density_report_M2_D_6a_min.rdb"
}
M2_D_6a_max {
    @ Mn density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking
    @ (Exclude DUPMK1 region when when Mn as TM-1 in 1 top metal option)>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M2ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window1)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window2)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M2_D_6a_max.log"
    RDB "./Process_CALDRC_logfile/density_report_M2_D_6a_max.rdb"
}
M2_D_6b {
    @ Mn density (including dummy) in 50umX50um window with step size 25um.(Exclude DUPMK1 when when Mn as TM-1 in 1 top metal option)<= 0.9
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (M2ALL NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 50.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window1)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 50.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window2)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 50.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window3)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M2_D_6b.log"
    RDB "./Process_CALDRC_logfile/density_report_M2_D_6b.rdb"
}
M2_D_6c {
    @ The difference between Mn density in 200umX200um with step size 200um and those of the adjacent checking windows (including dummy). INDMY/MARKG/MARKF/MARKS covered areas are excluded for this rule checking<= 0.45
    Check_pattern = M2ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    DENSITY Check_pattern Check_region [AREA(Check_pattern)/AREA(Check_region)] >= 0 WINDOW 200.0 GRADIENT > 0.45 ABSOLUTE BACKUP
    PRINT "./Process_CALDRC_logfile/density_report_M2_D_6c.log"
    RDB "./Process_CALDRC_logfile/density_report_M2_D_6c.rdb"
}
M2_D_6d {
    @ Mn density (including dummy) in 25umX25um window with step size 12.5um. INDMY/MARKG/MARKS covered areas are excluded for this rule checking>= 0.1
    Check_region = DRC:1 NOT (OR INDMY MARKG MARKS EXCLUi)
    Check_pattern = (M2ALL NOT (OR INDMY MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M2_D_6d.log"
    RDB "./Process_CALDRC_logfile/density_report_M2_D_6d.rdb"
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M2_D_6e_min_R {
    @ Average density for Mn inside the dummy block area in 25umX25um window with step size 12.5um when the dummy block area ((DUMBM OR Mn(n=2-8)DUB) OR NODMF) >= 25umX25um. INDMY/MARKF/MARKG/ MARKS covered areas are excluded from this rule checking.>= 0.1
    @ <= 0.9
