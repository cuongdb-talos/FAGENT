GROUP GTV2 TV2_?
TV2_R_1 {
    @ Fixed TV2 size (square shape), except MARKG/MARKS area.= 0.36um
    (NOT RECTANGLE TV2 == 0.36 BY == 0.36) NOT INSIDE (MARKG OR EXCLU)
}
TV2_S_2a {
    @ Space between two TV2s >= 0.34um
    (EXT TV2 < 0.34 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
TV2_S_2b {
    @ Recommended space between TV2s within array greater or equal to 3x3 (Two via regions whose space is <=0.56um are considered to be in the same array)>= 0.5um
    X = SIZE TV2 BY 0.28 OVERUNDER
    Y = SIZE X BY 0.8800000000000001 UNDEROVER
    Z = TV2 INSIDE Y
    (EXT Z < 0.5 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
TV2_EN_3a_3b {
    @ TV2_EN_3a: TM1/Mn fully enclosure of TV2 (Mn is Metal layer directly underneath TV2)>= 0.01um
    @ TV2_EN_3b: TM1/Mn enclosure of TV2 when TM1/Mn enclosure on one or both perpendicular directions < 0.05um. (Mn is Metal layer directly underneath TV2)>= 0.05um
    X = RECTANGLE ENC TV2 M6 ABUT<90 OUTSIDE ALSO GOOD 0.01 OPPOSITE 0.05 OPPOSITE 0.01 OPPOSITE 0.05 OPPOSITE
    (ENC X M6 < 0.01 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE EXCLU
    Y = ENC [X] M6 < 0.05 OPPOSITE
    (INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE EXCLU
    (TV2 NOT M6) NOT INSIDE EXCLU
    (TV2 NOT INTERACT M6) NOT INSIDE EXCLU
}
TV2_EN_5a {
    @ TKM enclosure of TV2 (four directions)>= 0.3um
    (ENC TV2 TKM < 0.3 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLU
}
TV2_O_10 {
    @ Itâs not allowed TV2 overlap with Mn/TM1 resistor when Mn/TM1 directly underneath TV2. And Itâs not allowed TV2 overlap with TM2/TKM resistor when TM2/TKM directly above TV2
    @ Mn resistor definition: (Mn AND MnR).
    @ TM1 resistor definition: (TM1 AND TM1R).
    @ TM2 resistor definition: (TM2 AND TM2R).
    @ TKM resistor definition: (TKM AND TKMR).
    X1 = M6 AND M6R
    X2 = TKM AND TKMR
    (TV2 AND (X1 OR X2)) NOT INSIDE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_ON YES
TV2_R_11_R {
    @ There should be at least two square TV2s at the intersection of Mn/TM1 and TM2 when either metal width >= 0.5um, excluding MARKS region.
    TV2_SQ = RECTANGLE TV2 ASPECT == 1
    X1_M6 = M6 ENCLOSE (M6 WITH WIDTH >= 0.5)
    X1_TKM = TKM ENCLOSE (TKM WITH WIDTH >= 0.5)
    M6TKM = M6 AND TKM
    X1 = X1_M6 OR X1_TKM
    (M6TKM INTERACT TV2_SQ == 1) INTERACT X1
}
#ENDIF
GROUP GTKM TKM_?
#IFDEF GUIXI_SPECIAL NO
TKM_W_1 {
    @ TKM metal width. DRC donât flag 89 to 90 degree widths in the INDMY region>= 1.5um
    ((INT TKM < 1.5 ABUT < 90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((INT TKM < 1.5 ABUT < 89 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
TKM_S_2a {
    @ Space between TKMs. DRC donât flag 89 to 90 degree spaces in the INDMY region.>= 1.5um
    ((EXT TKM < 1.5 ABUT < 90 SINGULAR REGION) NOT INDMY) NOT INSIDE EXCLU
    ((EXT TKM < 1.5 ABUT < 89 SINGULAR REGION) AND INDMY) NOT INSIDE EXCLU
}
#ENDIF
