}
#ENDIF
ESD_L_4a_G {
@ Channel length(GTL) of 1.2V N/PMOS for ESD protection device.>= 0.13um
(LENGTH (EGATELV COIN EDGE EGATE_L) < 0.13) NOT INSIDE EDGE EXCLU
}
ESD_L_4b_G {
@ Channel length(GTL) of 2.5V N/PMOS for ESD protection device.>= 0.28um
(LENGTH (EGATEMV COIN EDGE EGATE_L) < 0.28) NOT INSIDE EDGE EXCLU
}
ESD_L_4c_G {
@ Channel length(GTL) of 2.5V overdrive 3.3V NMOS for ESD protection device.>= 0.5um
(LENGTH ((EGATE_2_5V_O_3_3V AND ENACT) COIN EDGE EGATE_L) < 0.5) NOT INSIDE EDGE EXCLU
}
ESD_L_4d_G {
@ Channel length(GTL) of 2.5V overdrive 3.3V PMOS for ESD protection device.>= 0.4um
(LENGTH ((EGATE_2_5V_O_3_3V AND EPACT) COIN EDGE EGATE_L) < 0.4) NOT INSIDE EDGE EXCLU
}
ESD_L_4e_G {
@ Channel length(GTL) of 1.2V Cascoded NMOS for ESD protection device.>= 0.13um
(LENGTH ((EGATE_1_2V_CASCODED AND ENACT) COIN EDGE EGATE_L) < 0.13) NOT INSIDE EDGE EXCLU
}
ESD_S_5_G {
@ Space from poly edge to CT edge on source side (SCP) for NMOS and PMOS (Fig.2).>= 0.25um
(EXT EGATE_W ECT_S < 0.25 ABUT< 90 REGION) NOT INSIDE EXCLU
}
ESD_S_6_G {
@ Space from poly edge to CT edge on drain side (DCP) (Fig.2)>= 1.7um
(EXT EGATE_W ECT_D < 1.7 ABUT< 90 REGION) NOT INSIDE EDGE EXCLU
}
ESD_R_7a_G {
@ The contact region of drain side should be kept silicided.
(ECT AND ESAB) NOT INSIDE EXCLU
}
ESD_W_8_G {
@ Width of SAB(AL) on the drain side for NMOS and PMOS, note: AL does not include the overlap of SAB area and GT (Fig.2)>= 1.5um
(EXT ESAB_HO EGATE_W < 1.5 ABUT < 90 REGION) NOT INSIDE EXCLU
}
ESD_O_9_G {
@ The overlap of SAB and poly(SOL) for 1.2V ESD N/PMOS, except the ESDCAS region.  (Fig.2/6) >= 0.02um
((INT ESAB (GT INTERACT ESAB) < 0.02 ABUT < 90 SINGULAR REGION)AND 1_2V_ESD_MOS) NOT INSIDE EXCLU
((EGATE NOT INTERACT ESAB)AND 1_2V_ESD_MOS) NOT INSIDE EXCLU
((EGATE TOUCH EDGE ESAB)INSIDE EDGE 1_2V_ESD_MOS) NOT INSIDE EDGE EXCLU
}
ESD_O_9a_G {
@ The overlap of SAB and poly(SOL) for 2.5V/2.5V overdrive 3.3V ESD N/PMOS, except the ESDCAS region.  (Fig.2/6) >= 0.05um
((INT ESAB (GT INTERACT ESAB) < 0.05 ABUT < 90 SINGULAR REGION)AND (OR 2_5V_ESD_MOS ESD_2_5V_O_3_3V)) NOT INSIDE EXCLU
((EGATE NOT INTERACT ESAB)AND (OR 2_5V_ESD_MOS ESD_2_5V_O_3_3V)) NOT INSIDE EXCLU
((EGATE TOUCH EDGE ESAB)INSIDE EDGE(OR 2_5V_ESD_MOS ESD_2_5V_O_3_3V)) NOT INSIDE EDGE EXCLU
}
ESD_EX_10_G {
@ Extension of SAB(SET) beyond AA along finger direction for 1.2V/2.5V/2.5V overdrive 3.3V ESD N/PMOS and 1.2V Cascoded ESD NMOS. (Fig.2a/2b/6) >= 0.2
ESAB_SET = (ESAB OR ESAB_HO) NOT TOUCH EDGE (ESAB INSIDE EDGE GATE)
CHECK_REGION = OR 1_2V_ESD_MOS 2_5V_ESD_MOS ESD_2_5V_O_3_3V (1_2V_ESD_CASCODED AND SN)
((ENC AA ESAB_SET < 0.2 ABUT < 90  REGION)INSIDE CHECK_REGION)NOT INSIDE EDGE EXCLU
}
ESD_R_11_G {
@ ESD protection devices should be surrounded by guard ring, this guard ring also can be designed as the pickup of the ESD device. (Fig.2)
ENGUARDRING = HOLES ENTAP INNER EMPTY
EPGUARDRING = HOLES EPTAP INNER EMPTY
(EPMOS NOT ENGUARDRING) NOT INSIDE EXCLU
(EPMOS NOT EPGUARDRING) NOT INSIDE EXCLU
(ENMOS NOT EPGUARDRING) NOT INSIDE EXCLU
}
ESD_R_11a_G {
@ Space between N+AA and P+AA for 1.2V/2.5V/2.5V overdrive 3.3V ESD PMOS. (BS)>= 2.1um
CHECK_REGION = (OR 1_2V_ESD_MOS 2_5V_ESD_MOS ESD_2_5V_O_3_3V)INTERACT EPGATE
EPACT_BS = (EPACT INTERACT EGATE)AND CHECK_REGION
ENACT_BS = (DONUT(ENACT AND CHECK_REGION))NOT INTERACT EGATE
(EXT ENACT_BS EPACT_BS < 2.1 ABUT < 90 SINGULAR REGION)NOT EXCLU
}
ESD_R_11b_G {
@ Space between N+AA and P+AA for 1.2V/2.5V/2.5V overdrive 3.3V ESD PMOS.(PS)>= 2um
CHECK_REGION = (OR 1_2V_ESD_MOS 2_5V_ESD_MOS ESD_2_5V_O_3_3V)INTERACT EPGATE
ENACT_PS = (DONUT(ENACT AND CHECK_REGION))NOT INTERACT EGATE
EPACT_PS = (DONUT(EPACT AND CHECK_REGION))NOT INTERACT EGATE
((EXT ENACT_PS EPACT_PS < 2 ABUT < 90 SINGULAR REGION) AND CHECK_REGION)NOT EXCLU
}
ESD_R_11c_G {
@ Space between N+AA and P+AA for 1.2V/2.5V/2.5V overdrive 3.3V/ 1.2V Cascoded ESD NMOS. (PS)>= 2.1um
CHECK_REGION = (OR 1_2V_ESD_MOS 2_5V_ESD_MOS ESD_2_5V_O_3_3V 1_2V_ESD_CASCODED)INTERACT ENGATE
ENACT_PS = (ENACT INTERACT EGATE)AND CHECK_REGION
EPACT_PS = (DONUT(EPACT AND CHECK_REGION))NOT INTERACT EGATE
((EXT ENACT_PS EPACT_PS < 2.1 ABUT < 90 SINGULAR REGION) AND CHECK_REGION)NOT EXCLU
}
ESD_S_12_G {
@ Space between active poly gate and inactive poly gate of 1.2V Cascoded NMOS(SGT) (Fig.6) >= 0.6um
EGT = GT AND 1_2V_ESD_CASCODED
ESAB_CASCODED = ESAB AND 1_2V_ESD_CASCODED
((EXT EGT < 0.6 ABUT < 90  OPPOSITE REGION)AND ESAB_CASCODED)NOT EXCLU
}
ESD_O_13_G {
@ SAB should cover all top poly gates and extend to overlap the second poly gate (active poly gate) of 1.2V Cascoded NMOS.(SOL) (Fig.6) >= 0.02um
ESAB_CASCODED = ESAB AND 1_2V_ESD_CASCODED
(EGATE_1_2V_CASCODED NOT INTERACT ESAB)NOT EXCLU
(ESAB_CASCODED TOUCH EGATE_1_2V_CASCODED )NOT EXCLU
(ESAB_CASCODED INTERACT EGATE_1_2V_CASCODED !=4)NOT EXCLU
(INT ESAB_CASCODED EGATE_1_2V_CASCODED < 0.02 ABUT < 90 SINGULAR REGION)NOT EXCLU
}
ESD_W_20_G {
@ The width of SAB hole(B) for silicide CT area (Fig. 4 and Fig.6)>= 0.49um
@ <= 1
(INT ESAB_HO < 0.49 ABUT < 90 SINGULAR REGION)NOT EXCLU
(WITH WIDTH ESAB_HO > 1) NOT INSIDE EXCLU
}
ESD_L_22_G {
@ Unit finger length of ESD diode (L) >= 0.5um
@ <= 2um
(WITH WIDTH ESDNDIO_FINGER < 0.5)NOT EXCLU
(WITH WIDTH ESDNDIO_FINGER > 2)NOT EXCLU
(WITH WIDTH ESDPDIO_FINGER < 0.5)NOT EXCLU
(WITH WIDTH ESDPDIO_FINGER > 2)NOT EXCLU
}
ESD_W_23_G {
@ Unit finger width of ESD diode (W) >=	20um
@ <= 60um	
(RECTANGLE ESDNDIO_FINGER >= 0.5 <= 2 BY < 20)NOT EXCLU
(RECTANGLE ESDNDIO_FINGER >= 0.5 <= 2 BY > 60)NOT EXCLU
(RECTANGLE ESDPDIO_FINGER >= 0.5 <= 2 BY < 20)NOT EXCLU
(RECTANGLE ESDPDIO_FINGER >= 0.5 <= 2 BY > 60)NOT EXCLU
}
ESD_S_25_G {
@ The AA spacing between (N+AA AND PW)/(P+AA AND NW) and P+ pickup AA/N+ pickup AA ring (S1/S2) (Fig.1a). >= 0.5um
@ <= 1um
(EXT ESDDIO_NTAP_RING ESDPDIO_FINGER < 0.5 ABUT < 90 SINGULAR REGION)NOT EXCLU
(EXT ESDDIO_PTAP_RING ESDNDIO_FINGER < 0.5 ABUT < 90 SINGULAR REGION)NOT EXCLU
((SIZE ESDPDIO_FINGER BY 1)INSIDE EDGE ESDDIO_NTAP_HOLE)NOT INSIDE EDGE EXCLU
((SIZE ESDNDIO_FINGER BY 1)INSIDE EDGE ESDDIO_PTAP_HOLE)NOT INSIDE EDGE EXCLU
}
ESD_S_26_G {
@ The AA spacing between N+AA AND NW and Bulk Ring(S3) (Fig.1b). >= 1.5um
(EXT ESDDIO_NTAP_RING ESDDIO_BULK_RING < 1.5 ABUT < 90 SINGULAR REGION)NOT EXCLU
}
#IFDEF HBM_TARGET HBM_2KV
ESD_R_24a_G {
@ Total perimeter of STI ESD 1.2V Ndiode [(L+W)*2*N] for HBM 2KV , N is finger number. >= 153um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 153
((X INTERACT ESDNDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24d_G {
@ Total perimeter of STI ESD 1.2V Pdiode [(L+W)*2*N] for HBM 2KV , N is finger number.>= 102um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 102
((X INTERACT ESDPDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24g_G {
@ Total perimeter of STI ESD 2.5V Ndiode [(L+W)*2*N] for HBM 2KV , N is finger number. >= 153um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 153
((X INTERACT ESDNDIO_FINGER)AND DG)NOT EXCLU
}
ESD_R_24j_G {
@ Total perimeter of STI ESD 2.5V Pdiode [(L+W)*2*N] for HBM 2KV , N is finger number..>= 102um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 102
((X INTERACT ESDPDIO_FINGER)AND DG)NOT EXCLU
}
#ENDIF
#IFDEF HBM_TARGET HBM_4KV
ESD_R_24b_G {
@ Total perimeter of STI ESD 1.2V Ndiode [(L+W)*2*N] for HBM 4KV , N is finger number.>= 255um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 255
((X INTERACT ESDNDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24e_G {
@ Total perimeter of STI ESD 1.2V Pdiode [(L+W)*2*N] for HBM 4KV , N is finger number.>= 204um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 204
((X INTERACT ESDPDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24h_G {
@ Total perimeter of STI ESD 2.5V Ndiode [(L+W)*2*N] for HBM 4KV , N is finger number.>= 255um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 255
((X INTERACT ESDNDIO_FINGER)AND DG)NOT EXCLU
}
ESD_R_24k_G {
@ Total perimeter of STI ESD 2.5V Pdiode [(L+W)*2*N] for HBM 4KV , N is finger number.>= 204um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 204
((X INTERACT ESDPDIO_FINGER)AND DG)NOT EXCLU
}
#ENDIF
#IFDEF HBM_TARGET HBM_8KV
ESD_R_24c_G {
@ Total perimeter of STI ESD 1.2V Ndiode [(L+W)*2*N] for HBM 8KV , N is finger number.>= 408um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 408
((X INTERACT ESDNDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24f_G {
@ Total perimeter of STI ESD 1.2V Pdiode [(L+W)*2*N] for HBM 8KV , N is finger number.>= 357um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 357
((X INTERACT ESDPDIO_FINGER)NOT DG)NOT EXCLU
}
ESD_R_24i_G {
@ Total perimeter of STI ESD 2.5V Ndiode [(L+W)*2*N] for HBM 8KV , N is finger number.>= 408um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 408
((X INTERACT ESDNDIO_FINGER)AND DG)NOT EXCLU
}
ESD_R_24l_G {
@ Total perimeter of STI ESD 2.5V Pdiode [(L+W)*2*N] for HBM 8KV , N is finger number.>= 408um
X = NET AREA RATIO ESDDIO_FINGER_EMPTY ESDDIO_FINGER_EDGE_EMPTY [AREA(ESDDIO_FINGER_EDGE_EMPTY)/0.001] < 408
((X INTERACT ESDPDIO_FINGER)AND DG)NOT EXCLU
}
#ENDIF
#ENDIF
