all_pad_RDL_pwr = with text RDL POWER_NAME RDL
all_pad_RDL_gnd = with text RDL GROUND_NAME RDL
#ENDIF
all_pad_TXT_M1 = OR all_pad_M1_pwr all_pad_M1_gnd all_pad_M1i_pwr all_pad_M1i_gnd
all_pad_TXT1_M1 = STAMP all_pad_TXT_M1 BY M1_EMPTY5
power_pad_TXT_M1 = M1_EMPTY5 INTERACT (NET AREA RATIO M1_EMPTY5 all_pad_TXT1_M1 > 0)
all_pad_TXT_M2 = OR all_pad_M2_pwr all_pad_M2_gnd all_pad_M2i_pwr all_pad_M2i_gnd
all_pad_TXT1_M2 = STAMP all_pad_TXT_M2 BY M2_EMPTY5
power_pad_TXT_M2 = M2_EMPTY5 INTERACT (NET AREA RATIO M2_EMPTY5 all_pad_TXT1_M2 > 0)
all_pad_TXT_M3 = OR all_pad_M3_pwr all_pad_M3_gnd all_pad_M3i_pwr all_pad_M3i_gnd
all_pad_TXT1_M3 = STAMP all_pad_TXT_M3 BY M3_EMPTY5
power_pad_TXT_M3 = M3_EMPTY5 INTERACT (NET AREA RATIO M3_EMPTY5 all_pad_TXT1_M3 > 0)
all_pad_TXT_M4 = OR all_pad_M4_pwr all_pad_M4_gnd all_pad_M4i_pwr all_pad_M4i_gnd
all_pad_TXT1_M4 = STAMP all_pad_TXT_M4 BY M4_EMPTY5
power_pad_TXT_M4 = M4_EMPTY5 INTERACT (NET AREA RATIO M4_EMPTY5 all_pad_TXT1_M4 > 0)
all_pad_TXT_M5 = OR all_pad_M5_pwr all_pad_M5_gnd all_pad_M5i_pwr all_pad_M5i_gnd
all_pad_TXT1_M5 = STAMP all_pad_TXT_M5 BY M5_EMPTY5
power_pad_TXT_M5 = M5_EMPTY5 INTERACT (NET AREA RATIO M5_EMPTY5 all_pad_TXT1_M5 > 0)
all_pad_TXT_M6 = OR all_pad_M6_pwr all_pad_M6_gnd all_pad_M6i_pwr all_pad_M6i_gnd
all_pad_TXT1_M6 = STAMP all_pad_TXT_M6 BY M6_EMPTY5
power_pad_TXT_M6 = M6_EMPTY5 INTERACT (NET AREA RATIO M6_EMPTY5 all_pad_TXT1_M6 > 0)
all_pad_TXT_TKM = OR all_pad_TKM_pwr all_pad_TKM_gnd all_pad_TKMi_pwr all_pad_TKMi_gnd
all_pad_TXT1_TKM = STAMP all_pad_TXT_TKM BY TKM_EMPTY5
power_pad_TXT_TKM = TKM_EMPTY5 INTERACT (NET AREA RATIO TKM_EMPTY5 all_pad_TXT1_TKM > 0)
all_pad_TXT_RV = OR all_pad_RV_pwr1 all_pad_RV_pwr2 all_pad_RV_pwr3 all_pad_RV_gnd1 all_pad_RV_gnd2 all_pad_RV_gnd3
all_pad_TXT1_RV = STAMP all_pad_TXT_RV BY RV_EMPTY5
power_pad_TXT_RV = RV_EMPTY5 INTERACT (NET AREA RATIO RV_EMPTY5 all_pad_TXT1_RV > 0)
all_pad_TXT_RDL = OR all_pad_RDL_pwr all_pad_RDL_gnd
all_pad_TXT1_RDL = STAMP all_pad_TXT_RDL BY RDL_EMPTY5
power_pad_TXT_RDL = RDL_EMPTY5 INTERACT (NET AREA RATIO RDL_EMPTY5 all_pad_TXT1_RDL > 0)
POWER_PAD1 = VSSMK1 OR VDDMK1
POWER_PAD2 = STAMP POWER_PAD1 BY PA_EMPTY5
POWER_PAD2_1 = STAMP POWER_PAD1 BY BCB2_EMPTY5
POWER_PAD3 = PA_EMPTY5 INTERACT (NET AREA RATIO PA_EMPTY5 POWER_PAD2 > 0)
POWER_PAD3_1 = BCB2_EMPTY5 INTERACT (NET AREA RATIO BCB2_EMPTY5 POWER_PAD2_1 > 0)
PA_IO_PAD = PA_EMPTY5 NOT INTERACT POWER_PAD3
BCB2_IO_PAD = BCB2_EMPTY5 NOT INTERACT POWER_PAD3_1
NMOS_1 = (NACT NOT NW) ENCLOSE GATE
PMOS_1 = (PACT AND NW) ENCLOSE GATE
#IFDEF DEFINE_PAD_BY_TEXT NO
NAA_IO_PAD1 = NET AREA RATIO NSD_EMPTY5 PA_IO_PAD > 0
NAA_IO_PAD2 = NET AREA RATIO NSD_EMPTY5 BCB2_IO_PAD > 0
PAA_IO_PAD1 = NET AREA RATIO PSD_EMPTY5 PA_IO_PAD > 0
PAA_IO_PAD2 = NET AREA RATIO PSD_EMPTY5 BCB2_IO_PAD > 0
NMOS_IO_PAD = NMOS_1 INTERACT (OR NAA_IO_PAD1 NAA_IO_PAD2)
PMOS_IO_PAD = PMOS_1 INTERACT (OR PAA_IO_PAD1 PAA_IO_PAD2)
#ENDIF
#IFDEF DEFINE_PAD_BY_TEXT YES
NAA_PAD1 = NET AREA RATIO NSD_EMPTY5 PA_IO_PAD > 0
NAA_PAD2 = NET AREA RATIO NSD_EMPTY5 BCB2_IO_PAD > 0
PAA_PAD1 = NET AREA RATIO PSD_EMPTY5 PA_IO_PAD > 0
PAA_PAD2 = NET AREA RATIO PSD_EMPTY5 BCB2_IO_PAD > 0
