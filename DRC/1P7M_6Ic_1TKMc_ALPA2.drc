@ Total channel width of 2.5V overdrive 3.3V ESD PMOS for HBM 2KV, except the ESDCAS region.>= 420um
X = NET AREA RATIO EPGATE_D_EMPTY ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 420
(((X INTERACT EPGATE) NOT INTERACT EGATE_NOSAB)AND ESD_2_5V_O_3_3V) NOT INSIDE EXCLU
}
