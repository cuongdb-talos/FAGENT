    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.65 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_DFM_D_20_Max.log"
