    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC M4DUM BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_M5DUM {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC M5DUM BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_M6DUM {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC M6DUM BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_R_1_TKMDUM {
    @ Border layer must enclose all chip layout patterns (all chip design, excluding MARKS, NODMF marking layer)
    @ This rule is not applicable if customers insert seal ring by themselves.
    @ This rule checking layer are DNW,AA,NW,PSUB,VTNH,VTPH,LVN, LVP,DG,GT,SN,SP, HRP, ESD1, SAB,CT,Mn(n=1-8),Vn(n=1-7), TV1,TV2,TM1,TM2, TKM, RV,BCB1,BCB2,RDL, FUSE,AADUM,GTDUM,MnDUM(n=1-8),TM1DUM,TM2DUM, TKMDM.>= 0.37um
    mark_layer = OR MARKS NODMF EXCLUi
    (ENC TKMDUM BORDER < 0.37 ABUT<90 SINGULAR REGION) NOT INSIDE mark_layer
}
BD_EN_2 {
    @ Enclosure of DNW by the chip edge (BORDER layer) if it need  to add seal ring.>= 6um
    (ENC DNW BORDER < 6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLUi
}
BD_EN_4 {
    @ Enclosure of seal ring outer ring outline edge by BORDER layer (excluding seal ring corner dummy area) if seal ring has been added by designers.>= 1.5um
    M1_S = (M1 OR M1DUM) AND MARKS
    (ENC (DONUT M1_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    M2_S = (M2 OR M2DUM) AND MARKS
    (ENC (DONUT M2_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    M3_S = (M3 OR M3DUM) AND MARKS
    (ENC (DONUT M3_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    M4_S = (M4 OR M4DUM) AND MARKS
    (ENC (DONUT M4_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    M5_S = (M5 OR M5DUM) AND MARKS
    (ENC (DONUT M5_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    M6_S = (M6 OR M6DUM) AND MARKS
    (ENC (DONUT M6_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    TKM_S = (TKM OR TKMDUM) AND MARKS
    (ENC (DONUT TKM_S) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
    (ENC (DONUT RDL) BORDER < 1.5 ABUT < 90 SINGULAR REGION OUTSIDE ALSO) NOT INSIDE EXCLUi
}
#ENDIF
GROUP GAADUMCK AADUMCK_?
AADUM_max = RECTANGLE AADUM == 3 BY == 3
AADUM_mid = RECTANGLE AADUM == 1 BY == 1
AADUM_min = RECTANGLE AADUM == 0.5 BY == 0.5
AADUMCK_W_1a_1b_1c {
    @ AADUMCK_W_1a: Dummy AA width (square shape)
    @ May include 2.4 Âµm x 2.4 Âµm poly Dummy= 3um
    @ AADUMCK_W_1b: Dummy AA width (square shape)
    @ May include 0.92 Âµm x 0.92 Âµm poly Dummy= 1um
    @ AADUMCK_W_1c: Dummy AA width (square shape)
    @ May include 0.42 Âµm x 0.42 Âµm poly Dummy= 0.5um
    (AADUM NOT (OR AADUM_max AADUM_mid AADUM_min)) NOT INSIDE EXCLU
}
AADUMCK_S_2 {
    @ Space between two Dummy AAs.>= 0.28um
    (EXT AADUM < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
AADUMCK_S_4 {
    @ Space between dummy AA and mian AA/GT.
    @ Dummy AA pattern insertion is not allowed to touch an area that is covered by AA/GT layer>= 1.6um
    (EXT AADUM AA < 1.6 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM GT < 1.6 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
AADUMCK_S_5 {
    @ Space between dummy AA and RESAA/RESNW/RESP1/VARMOS/MARKG/MARKS layers.
    @ Dummy AA pattern insertion is not allowed to touch an area that is covered by RESAA/RESNW/RESP1/VARMOS/MARKG/MARKS layer>= 0.4um
    (EXT AADUM RESAA < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM RESNW < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM RESP1 < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM VARMOS < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM MARKG < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM MARKS < 0.4 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
}
AADUMCK_S_6 {
    @ Space between dummy AA and DUMBA/NODMF/INDMY/MARKF/FUSEMK1.
    @ Dummy AA pattern insertion is not allowed to touch an area that is covered by DUMBA/NODMF/INDMY/MARKF/FUSEMK1 layer>= 2um
    (EXT AADUM DUMBA < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM NODMF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM INDMY < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM MARKF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM FUSEMK1 < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
AADUMCK_S_7 {
    @ Space between dummy AA and LOGO
    @ Dummy AA pattern insertion is not allowed to touch an area that is covered by LOGO layer>= 0.1um
    (EXT AADUM LOGO < 0.1 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
AADUMCK_S_8 {
    @ Space between dummy AA and NW/DNW edge.
    @ Dummy AA is not allowed to straddle on a boundary of NW/DNW>= 0.6um
    (EXT AADUM NW < 0.6 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (ENC AADUM NW < 0.6 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (EXT AADUM DNW < 0.6 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (ENC AADUM DNW < 0.6 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
}
AADUMCK_EN_9 {
    @ Chip edge(BORDER) enclosure of dummy AA>= 0.6um
    (ENC AADUM BORDER < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (AADUM NOT BORDER) NOT INSIDE EXCLU
}
AADUMCK_EN_9a {
    @ Chip edge(BORDER) enclosure of dummy AA (For AADUMCK.W.1a)>= 8um
    (ENC AADUM_max BORDER < 8 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
AADUMCK_S_10 {
    @ Space between dummy AA and LOGO/VARMOS/MARKF/FUSEMK1/MARKS/MARKG/DUMBA/NODMF/RESNW/RESAA/RESP1/INDMY/AA/GT/NW/DNW (For AADUMCK.W.1a)>= 8um
    (EXT AADUM_max LOGO < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max VARMOS < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max FUSEMK1 < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max MARKS < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT AADUM_max MARKF < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max MARKG < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max DUMBA < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max NODMF < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max RESAA < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max RESNW < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max RESP1 < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max INDMY < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max AA < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max GT < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT AADUM_max NW < 8 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (EXT AADUM_max DNW < 8 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
}
GROUP GGTDUMCK GTDUMCK_?
GTDUM_max = RECTANGLE GTDUM == 2.4 BY == 2.4
GTDUM_mid = RECTANGLE GTDUM == 0.92 BY == 0.92
GTDUM_min = RECTANGLE GTDUM == 0.42 BY == 0.42
GTDUMCK_W_1a_1b_1c {
    @ GTDUMCK_W_1a: Dummy GT width (square shape)= 2.4um
    @ GTDUMCK_W_1b: Dummy GT width (square shape)= 0.92um
    @ GTDUMCK_W_1c: Dummy GT width (square shape)= 0.42um
    (GTDUM NOT (OR GTDUM_max GTDUM_mid GTDUM_min)) NOT INSIDE EXCLU
}
GTDUMCK_S_2 {
    @ Space between two Dummy GTs. >= 0.36um
    (EXT GTDUM < 0.36 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
GTDUMCK_S_4 {
    @ Space between dummy GT and NW edge.
    @ Dummy AA is not allowed to straddle on a boundary of NW>= 0.3um
    (EXT GTDUM NW < 0.3 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (ENC GTDUM NW < 0.3 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
}
GTDUMCK_S_5 {
    @ Space between dummy GT and mian AA/GT.
    @ Dummy poly pattern insertion is not allowed to touch the area that is covered by AA/GT.>= 0.8um
    (EXT GTDUM AA < 0.8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM GT < 0.8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
GTDUMCK_S_6 {
    @ Space between dummy GT and DUMBP/NODMF/FUSEMK1/MARKF/INDMY.
    @ Dummy poly pattern insertion is not allowed to touch the area that is covered by DUMBP/NODMF/FUSEMK1/MARKF/INDMY.>= 2um
    (EXT GTDUM DUMBP < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM NODMF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM INDMY < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM MARKF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM FUSEMK1 < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
GTDUMCK_S_7 {
    @ Space between dummy GT and RESAA/RESNW/RESP1/VARMOS/MARKG/MARKS
    @ Dummy poly pattern insertion is not allowed to touch the area that is covered by RESAA/RESNW/RESP1/VARMOS/MARKG/MARKS.>= 0.44um
    (EXT GTDUM RESAA < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM RESNW < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM RESP1 < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM VARMOS < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM MARKG < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM MARKS < 0.44 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
}
GTDUMCK_S_8 {
    @ Space between dummy GT and LOGO.
    @ Dummy poly pattern insertion is not allowed to touch the area that is covered by LOGO.>= 0.1um
    (EXT GTDUM LOGO < 0.1 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
GTDUMCK_S_9 {
    @ Space between dummy GT and RV/BCB2.
    @ No Dummy poly pattern is allowed to exist under RV/BCB2.>= 2um
    (EXT GTDUM RV < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM BCB2 < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
GTDUMCK_EN_10 {
    @ Chip edge (BORDER) enclosure of dummy GT.>= 0.6um
    (ENC GTDUM BORDER < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (GTDUM NOT BORDER) NOT INSIDE EXCLU
}
GTDUMCK_EN_10a {
    @ Chip edge (BORDER) enclosure of dummy GT. (For GTDUMCK.W.1a)>= 8um
    (ENC GTDUM_max BORDER < 8 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
GTDUMCK_S_11 {
    @ Space between dummy GT and LOGO/VARMOS/FUSEMK1/MARKF/MARKS/MARKG/DUMBP/NODMF/RESNW/ RESAA/RESP1/INDMY/AA/GT/NW/RV/BCB2 (For GTDUMCK.W.1a)>= 8um
    (EXT GTDUM_max LOGO < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max VARMOS < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max FUSEMK1 < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max MARKF < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max MARKS < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT GTDUM_max MARKG < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max DUMBP < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max NODMF < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max RESAA < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max RESNW < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max RESP1 < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max INDMY < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max AA < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max GT < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max NW < 8 ABUT<90 SINGULAR REGION OVERLAP) NOT INSIDE EXCLU
    (EXT GTDUM_max RV < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT GTDUM_max BCB2 < 8 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
GROUP GM1DUMCK M1DUMCK_?
M1DUM_max = RECTANGLE M1DUM == 2 BY == 2
M1DUM_mid = RECTANGLE M1DUM == 1 BY == 1
M1DUM_min = RECTANGLE M1DUM == 0.42 BY == 0.42
wide_M1 = M1 WITH WIDTH > 1.5
45d_M1 = ANGLE M1 >= 44.9 <= 45.1
M1DUMCK_W_1a_1b_1c {
    @ MnDUMCK_W_1a: Dummy metal width (square shape) = 2um
    @ MnDUMCK_W_1b: Dummy metal width (square shape) = 1um
    @ MnDUMCK_W_1c: Dummy metal width (square shape) = 0.42um
    (M1DUM NOT (OR M1DUM_max M1DUM_mid M1DUM_min)) NOT INSIDE EXCLU
}
M1DUMCK_S_2 {
    @ Space between two Dummy metals>= 0.25um
    (EXT M1DUM < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M1DUMCK_S_3a {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1a)>= 10um
    (EXT M1DUM_max M1 < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_3b {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1b)>= 3um
    (EXT M1DUM_mid M1 < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_3c {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1c)>= 0.3um
    (EXT M1DUM_min M1 < 0.3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_5 {
    @ Space between dummy metal and the MnDUB/DUMBM/NODMF/MOMDMY.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by MnDUB /DUMBM/NODMF/MOMDMY.>= 2um
    (EXT M1DUM M1DUB < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM DUMBM < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM NODMF < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM MOMDMY < 2 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_6 {
    @ Space between dummy metal and MARKS/MARKG/FUSEMK1/MARKF/INDMY.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by MARKS/MARKG/FUSEMK1/MARKF/INDMY.>= 3um
    (EXT M1DUM MARKS < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT M1DUM MARKG < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM FUSEMK1 < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM MARKF < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM INDMY < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_7 {
    @ Space between dummy metal and LOGO.
    @ Metal dummy pattern insertion is not allowed to touch areas covered by LOGO.>= 0.1um
    (EXT M1DUM LOGO < 0.1 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_S_8 {
    @ Space between dummy metal and Mn wide metal (width>1.5um).>= 0.6um
    (EXT M1DUM wide_M1 < 0.6 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M1DUMCK_S_9 {
    @ Space between dummy metal and 45 degree edge of metal (Mn).>= 0.4um
    45d_M1_EXP = EXPAND EDGE 45d_M1 OUTSIDE BY 0.4
    (45d_M1_EXP NOT OUTSIDE (45d_M1_EXP AND M1DUM)) NOT INSIDE EXCLU
}
M1DUMCK_EN_10 {
    @ Chip edge(BORDER) enclosure of dummy metal>= 2.5um
    (ENC M1DUM BORDER < 2.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (M1DUM NOT BORDER) NOT INSIDE EXCLU
}
M1DUMCK_EN_10a {
    @ Chip edge(BORDER) enclosure of dummy metal. (For MnDUMCK.W.1a)>= 10um
    (ENC M1DUM_max BORDER < 10 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M1DUMCK_S_11 {
    @ Space between dummy metal and LOGO/FUSEMK1/MARKF/MARKS/MARKG/DUMBM/MnDUB/NODMF/INDMY/MOMDMY (For MnDUMCK.W.1a)>= 10um
    (EXT M1DUM_max LOGO < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max FUSEMK1 < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max MARKF < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max MARKS < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLUi
    (EXT M1DUM_max MARKG < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max DUMBM < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max M1DUB < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max NODMF < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max INDMY < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
    (EXT M1DUM_max MOMDMY < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M1DUMCK_R_12 {
    @ Mn dummy metal cannot be interacted with Mn main patterns.
    @ Noteï¼n=1, 2, 3, 4, 5, 6, 7, 8
    (M1DUM INTERACT M1) NOT INSIDE EXCLU
}
GROUP GM2DUMCK M2DUMCK_?
M2DUM_max = RECTANGLE M2DUM == 2 BY == 2
M2DUM_mid = RECTANGLE M2DUM == 1 BY == 1
M2DUM_min = RECTANGLE M2DUM == 0.42 BY == 0.42
wide_M2 = M2 WITH WIDTH > 1.5
45d_M2 = ANGLE M2 >= 44.9 <= 45.1
M2DUMCK_W_1a_1b_1c {
    @ MnDUMCK_W_1a: Dummy metal width (square shape) = 2um
    @ MnDUMCK_W_1b: Dummy metal width (square shape) = 1um
    @ MnDUMCK_W_1c: Dummy metal width (square shape) = 0.42um
    (M2DUM NOT (OR M2DUM_max M2DUM_mid M2DUM_min)) NOT INSIDE EXCLU
}
M2DUMCK_S_2 {
    @ Space between two Dummy metals>= 0.25um
    (EXT M2DUM < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M2DUMCK_S_3a {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1a)>= 10um
    (EXT M2DUM_max M2 < 10 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M2DUMCK_S_3b {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1b)>= 3um
    (EXT M2DUM_mid M2 < 3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M2DUMCK_S_3c {
    @ Space between dummy metal and Mn pattern(for MnDUMCK.W.1c)>= 0.3um
    (EXT M2DUM_min M2 < 0.3 ABUT<90 SINGULAR REGION INSIDE ALSO) NOT INSIDE EXCLU
}
M2DUMCK_S_5 {
    @ Space between dummy metal and the MnDUB/DUMBM/NODMF/MOMDMY.
