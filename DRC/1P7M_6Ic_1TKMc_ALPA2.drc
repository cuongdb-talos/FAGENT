}
SL_R_6_M4V4_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M4SLOT V4 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M5V4_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M5SLOT V4 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M5V5_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M5SLOT V5 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M6V5_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
    (EXT M6SLOT V5 < 0.5 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SL_R_6_M6TV2_G {
    @ Distance between open slot edge and contact or vias directly underneath/above the metal.>= 0.5um
