MOM_S_6_G {
    @ The space between (Mn AND MOMMKn AND MOMDMY) and Vn/Vn-1 (n=1~8) outside of MOMDMY, whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or TV1 or TV2.>= 0.11um
    (EXT ((M1 AND MOMMK1) AND MOMDMY) (V1 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M2 AND MOMMK2) AND MOMDMY) (V1 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M2 AND MOMMK2) AND MOMDMY) (V2 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M3 AND MOMMK3) AND MOMDMY) (V2 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M3 AND MOMMK3) AND MOMDMY) (V3 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M4 AND MOMMK4) AND MOMDMY) (V3 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M4 AND MOMMK4) AND MOMDMY) (V4 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M5 AND MOMMK5) AND MOMDMY) (V4 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M5 AND MOMMK5) AND MOMDMY) (V5 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M6 AND MOMMK6) AND MOMDMY) (V5 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT ((M6 AND MOMMK6) AND MOMDMY) (TV2 OUTSIDE MOMDMY) < 0.11 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF LDMOS_CHECK YES
GROUP GLD LD_?
LD_L_1_G {
@ LDMOS gate length >= 0.48um
  ((INT LDNGATE < 0.48 ABUT<90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
  ((INT LDPGATE < 0.48 ABUT<90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
 }
LD_L_1_NOSHR_G {
@ LDMOS gate length >= 0.532um
 ((INT LDNGATE < 0.532 ABUT<90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
 ((INT LDPGATE < 0.532 ABUT<90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_2_G {
@ Dummy layer STIDMY is required for LDMOS transistor field plate area. STI width for LDMOS transistor drain side field plate= 0.11um
((INT STIDMY < 0.11 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH STIDMY > 0.11)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_2_NOSHR_G {
@ Dummy layer STIDMY is required for LDMOS transistor field plate area. STI width for LDMOS transistor drain side field plate= 0.122um
((INT STIDMY < 0.122 ABUT < 90 SINGULAR REGION) INSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH STIDMY > 0.122)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_O_3_G {
@ Overlap of NW and LDNMOS gate= 0.2um
((INT NW LDNGATE < 0.20 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH (NW AND LDNGATE) > 0.2)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_O_3_NOSHR_G {
@ Overlap of NW and LDNMOS gate= 0.222um
((INT NW LDNGATE < 0.222 ABUT < 90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH (NW AND LDNGATE) > 0.222)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_O_4_G {
@ Overlap of PW and LDPMOS gate= 0.2um
((ENC NW LDPGATE < 0.20 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH (LDPGATE NOT NW) > 0.2)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_O_4_NOSHR_G {
@ Overlap of PW and LDPMOS gate= 0.222um
((ENC NW LDPGATE < 0.222 ABUT < 90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
((WITH WIDTH (LDPGATE NOT NW) > 0.222)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_5_G {
@ Channel width for LDMOS transistors>= 2um
((INT (LDAA IN EDGE GT) < 2 ABUT < 90 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_5_NOSHR_G {
@ Channel width for LDMOS transistors>= 2.219um
((INT (LDAA IN EDGE GT) < 2.219 ABUT < 90 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_6_G {
@ Space between one LDMOS gate poly to another LDMOS gate poly on source side>= 0.27um
((EXT (GT INSIDE EDGE LDAA) < 0.27 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_6_NOSHR_G {
@ Space between one LDMOS gate poly to another LDMOS gate poly on source side>= 0.299um
((EXT (GT INSIDE EDGE LDAA) < 0.299 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_EX_7_G {
@ NW or PW extension outside of LDMOS AA along channel width direction. (Extension <= 0 is not allowed)>= 0.25um
  X1 = LDAA TOUCH EDGE STIDMY
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) NOT COIN EDGE X1
 ((ENC X3 NW < 0.25 ABUT < 90 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
 ((EXT X3 NW < 0.25 ABUT < 90 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
 (NW TOUCH EDGE X3) NOT INSIDE EDGE EXCLU
}
LD_EX_7_NOSHR_G {
@ NW or PW extension outside of LDMOS AA along channel width direction. (Extension <= 0 is not allowed)>= 0.277um
  X1 = LDAA TOUCH EDGE STIDMY
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) NOT COIN EDGE X1
((ENC X3 NW < 0.277 ABUT < 90 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
((EXT X3 NW < 0.277 ABUT < 90 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
(NW TOUCH EDGE X3) NOT INSIDE EDGE EXCLU
}
LD_S_8a_G {
@ Space between LDMOS source side AA and pickup AA along channel length direction>= 0.6um
  X1 = LDAA TOUCH EDGE GT
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) OR EDGE X1
  X4 = (LDAA WITH EDGE X3) NOT COIN EDGE X3
  ((EXT X4 (PTAP OR NTAP) < 0.6 ABUT < 90 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_8a_NOSHR_G {
@ Space between LDMOS source side AA and pickup AA along channel length direction>= 0.665um
  X1 = LDAA TOUCH EDGE GT
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) OR EDGE X1
  X4 = (LDAA WITH EDGE X3) NOT COIN EDGE X3
  ((EXT X4 (PTAP OR NTAP) < 0.665 ABUT < 90 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_8b_G {
@ Space between LDMOS source side AA and pickup AA along channel width direction>= 0.9um
  X1 = LDAA TOUCH EDGE GT
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) NOT TOUCH EDGE X1
 ((EXT X3 (PTAP OR NTAP) < 0.9 ABUT < 90 REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_8b_NOSHR_G {
@ Space between LDMOS source side AA and pickup AA along channel width direction>= 0.998um
  X1 = LDAA TOUCH EDGE GT
  X2 = INT X1 [LDAA] < 0.005 ABUT INTERSECTING ONLY
  X3 = (LDAA TOUCH EDGE X2) NOT TOUCH EDGE X1
 ((EXT X3 (PTAP OR NTAP) < 0.998 ABUT < 90 REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_O_9_G {
@ GT to STI drain side field plate overlap= 0um
  (GT AND STIDMY) NOT INSIDE EXCLU
  ((STIDMY AND LDBK) NOT TOUCH GT) NOT INSIDE EXCLU
}
LD_EX_10_G {
@ LDBK extension outside of MOS AA.>= 0.4um
@ LDMOS block layer (LDBK) is used to identify LDMOS function area.
  X1 = LDAA TOUCH STIDMY
  ((ENC X1 LDBK < 0.4 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_EX_10_NOSHR_G {
@ LDBK extension outside of MOS AA.>= 0.443um
@ LDMOS block layer (LDBK) is used to identify LDMOS function area.
  X1 = LDAA TOUCH STIDMY
  ((ENC X1 LDBK < 0.443 ABUT < 90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_EN_11_G {
@ STIDMY enclosure LDMOS drain side filed plate= 0um
  X = STIDMY AND LDAA
  Y = STIDMY NOT TOUCH (LDAA NOT GT)
  (X OR Y) NOT INSIDE EXDRC
}
LD_S_12_G {
@ CT to GT space on LDMOS at source side>= 0.11um
   X =  CT AND (LDAA INTERACT GT)
  ((EXT X GT < 0.11 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_S_12_NOSHR_G {
@ CT to GT space on LDMOS at source side>= 0.121um
   X =  CT AND (LDAA INTERACT GT)
  ((EXT X GT < 0.121 ABUT < 90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_14_G {
@ LDMOS drain side AA width>= 0.21um
  X = (AA NOT GT) TOUCH STIDMY
  ((INT X < 0.21 ABUT < 90 SINGULAR REGION)NOT INSIDE NOSHR) NOT INSIDE EXCLU
}
LD_W_14_NOSHR_G {
@ LDMOS drain side AA width>= 0.233um
  X = (AA NOT GT) TOUCH STIDMY
  ((INT X < 0.233 ABUT < 90 SINGULAR REGION)NOT OUTSIDE NOSHR) NOT INSIDE EXCLU
}
#ENDIF
SRAM_R_1 {
@ If GATE is enclosed by INST layer, it should be also enclosed by bit cell marking layer (SRAM525, SRAM620, SRAM974, SRAM1158).
  X = GATE NOT OUTSIDE INST
  (X NOT (OR SRAM525 SRAM620 SRAM974 SRAM1158)) NOT INSIDE EXCLU
}
SRAM_R_1b {
@ Bit cell marking layers (SRAM525, SRAM620, SRAM974, SRAM1158) must be within SRAM INST marker layer.
@ DRC waive if bit cell marker layer is larger than INST, but no device (AA AND GT) in the area ((INST OR bit cell marker layer) NOT (INST AND bit cell marker layer)).
  ((OR SRAM525 SRAM620 SRAM974 SRAM1158) NOT INTERACT INST) NOT INSIDE EXCLU
  (((OR SRAM525 SRAM620 SRAM974 SRAM1158) NOT INST) INTERACT (AA AND GT))NOT INSIDE EXCLU
}
GROUP GSRAA SRAA_?
SRAA_W_2a {
@ Channel width for 1.2V NMOS/PMOS transistors>= 0.11 0.085um
  Y = LENGTH GATE_M_W < 0.085
  ((EXPAND EDGE Y INSIDE BY 0.001) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_S_3a {
@ Space between two AAs in the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP). DRC waive check 45-degree spaces (1degree tolerance) in the INDMY region.>= 0.1 0.095um
  Y = OR NW DNW VTNH VTPH LVN LVP PW
  ((((EXT AA < 0.095 ABUT<90 SINGULAR REGION) INSIDE Y) NOT INDMY) NOT OUTSIDE INST) NOT INSIDE EXCLU
  ((((EXT AA < 0.095 ABUT<44 SINGULAR REGION) INSIDE Y) AND INDMY) NOT OUTSIDE INST) NOT INSIDE EXCLU
  ((((EXT AA < 0.095 ABUT>46<90 SINGULAR REGION) INSIDE Y) AND INDMY) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_S_3b {
@ Space between AAs when one or both AA width greater than 0.15um in the same well (including NW, PW, DNW, VTNH, VTPH, LVN, LVP). DRC waive check the INDMY covered region.>= 0.11 0.105um
  Y = OR NW DNW VTNH VTPH LVN LVP PW
  X = AA WITH WIDTH > 0.15
  ((((EXT X AA < 0.105 SINGULAR REGION) INSIDE Y) NOT INDMY) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_EN_4 {
@ N+AA enclosed by NW (excluding NW interacting with RESNW)>= 0.12 0.055um
  X = ENC NACT (NW NOT INTERACT RESNW) < 0.055 ABUT<90 SINGULAR REGION
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_S_5 {
@ Space between NW and N+AA inside PW>= 0.15 0.06um
  X = EXT NW (NACT AND PW) < 0.06 ABUT<90 SINGULAR REGION
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_EN_6 {
@ P+AA enclosed by NW >= 0.15 0.06um
  X = ENC PACT NW < 0.06 ABUT<90 SINGULAR REGION
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_S_7 {
@ Space between NW and P+AA inside PW>= 0.12 0.11um
  X = EXT NW (PACT INSIDE PW) < 0.11 ABUT<90 SINGULAR REGION
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRAA_A_8 {
@ AA area >= 0.038 0.029um2
  X = AREA AA < 0.029
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
GROUP GSRVTNH SRVTNH_?
SRVTNH_EX_4 {
@ VTNH extension outside of NMOS AA along GATE poly length direction.>= 0.12 0.065um
  X = (NACT AND VTNH) TOUCH EDGE GATE
  Y = ENC X VTNH < 0.065 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
  }
SRVTNH_S_5 {
@ Space between VTNH and MOS AA of other device along other deviceâs GATE poly length direction>= 0.12 0.065um
  X1 = NACT TOUCH EDGE (AA INSIDE EDGE GT)
  X2 = PACT TOUCH EDGE (AA INSIDE EDGE GT)
  X = X1 OR EDGE X2
  ((EXT X VTNH < 0.065 ABUT<90 REGION OPPOSITE) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRVTNH_A_8 {
@ VTNH area >= 0.18 0.11um2
  ((AREA VTNH < 0.11) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
GROUP GSRVTPH SRVTPH_?
SRVTPH_EX_4 {
@ VTPH extension outside of PMOS AA along GATE poly length direction.>= 0.12 0.065um
  X = (PACT AND VTPH) TOUCH EDGE GATE
  Y = ENC X VTPH < 0.065 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRVTPH_S_5 {
@ Space between VTPH and MOS AA of other device along other deviceâs GATE poly length direction>= 0.12 0.065um
  X1 = PACT TOUCH EDGE (AA INSIDE EDGE GT)
  X2 = NACT TOUCH EDGE (AA INSIDE EDGE GT)
  X = X1 OR EDGE X2
  ((EXT X VTPH < 0.065 ABUT<90 REGION OPPOSITE) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRVTPH_A_8 {
@ VTPH area >= 0.18 0.11um2
  ((AREA VTPH < 0.11) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
GROUP GSRGT SRGT_?
POLYEND = CONVEX EDGE GT ANGLE1 >0 ANGLE2 > 0 LENGTH1 >= 0.14 LENGTH2 >= 0.14 WITH LENGTH < 0.14
SRGT_S_3a1 {
@ Space between GTs with the parallel run length > 0.12um except poly line end to end patterns.>= 0.12um
   END_END = EXT [POLYEND] < 0.12 OPPOSITE
   X = (EXT [GT] < 0.12 OPPOSITE) NOT COIN EDGE END_END
   Y = LENGTH X > 0.12
   (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_S_3a2 {
@ Space between GTs with the parallel run length > 0.025 and <= 0.12um except poly line end to end patterns.>= 0.107um
   END_END = EXT [POLYEND] < 0.107 OPPOSITE
   X = (EXT [GT] < 0.107 OPPOSITE) NOT COIN EDGE END_END
   Y = LENGTH X > 0.025 <= 0.12
   (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_S_3a3 {
@ Space between GTs with the parallel run length <= 0.025um except poly line end to end patterns.>= 0.06um
   END_END = EXT [POLYEND] < 0.06 OPPOSITE
   X = (EXT [GT] < 0.06 OPPOSITE) NOT COIN EDGE END_END
   Y = LENGTH X <= 0.025
   (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_S_3c {
@ Space between GTs on the same AA>= 0.13um
  X = EXT GT_EMPTY < 0.13 ABUT < 90 SINGULAR REGION CONNECTED
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRGT_S_3d {
@ Space between poly line end to end>= 0.105um
  X = EXT POLYEND < 0.105 OPPOSITE REGION EXCLUDE SHIELDED
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRGT_S_4a {
@ Space between AA and GT on STI with the parallel run length > 0.04um except poly line end to end patterns.>= 0.05um
  X = AA INSIDE EDGE GT
  Y = AA TOUCH EDGE X
  A = EXT [Y] INTERGT < 0.05 OPPOSITE
  B = LENGTH A > 0.04
  (B NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_S_4b {
@ Space between AA and GT on STI with the parallel run length <= 0.04um except poly line end to end patterns.>= 0.032um
  X = AA INSIDE EDGE GT
  Y = AA TOUCH EDGE X
  A = EXT [Y] INTERGT < 0.032 OPPOSITE
  B = LENGTH A <=0.04
  (B NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_EX_5a {
@ Extension of AA outside of GT with the parallel run length > 0.15um except poly line end to end patterns.>= 0.095um
   X = ENC [GT] AA < 0.095 OPPOSITE
   Y = LENGTH X > 0.15
   (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_EX_5b {
@ Extension of AA outside of GT with the parallel run length > 0.015um and <= 0.04um except poly line end to end patterns.>= 0.077um
   X = ENC [GT] AA < 0.077 OPPOSITE
   Y = LENGTH X > 0.015 <=0.04
   (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_EX_5c {
@ Extension of AA outside of GT with the parallel run length > 0.04um and <= 0.15um except poly line end to end patterns.DRC doesnât flag if AA extends out of ((AA AND GT) NOT GATE) >= 0um and <= 0.01um.>= 0.077um
   X = ENC [GT] AA < 0.077 OPPOSITE
   Y = LENGTH X > 0.04 <= 0.15
   Z = (AA AND GT) NOT GATE
   L = ENC [Z] AA <= 0.01 OPPOSITE
   M = LENGTH L > 0.04 <= 0.15
   ((Y NOT COIN EDGE M) NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRGT_EX_6 {
@ Extension of GATE poly end-cap outside of AA, except small jogs (jog <= 0.005um)>= 0.068um
  X = GATE COIN EDGE AA
  Y = ENC X GT < 0.068 ABUT<90 REGION
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
GROUP GSRSN SRSN_?
SRSN_S_3a {
@ Space between SN and P+ AA inside NW with the parallel run length > 0.055um>= 0.065um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SN
  Y = EXT [SN] X < 0.065 OPPOSITE
  A = LENGTH Y > 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSN_S_3b {
@ Space between SN and P+ AA inside NW with the parallel run length <= 0.055um>= 0.06um
  X = (PACT NOT PTAP) NOT TOUCH EDGE SN
  Y = EXT [SN] X < 0.06 OPPOSITE
  A = LENGTH Y <= 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSN_S_5 {
@ Space between SN and PMOS GATE along source/drain direction.>= 0.219um
  X = GATE_W INSIDE EDGE SP
  Y = EXT X SN < 0.219 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRSN_EX_6 {
@ SN extension outside of NMOS GATE along source/drain direction..>= 0.214um
  X = GATE_W INSIDE EDGE SN
  Y = ENC X SN < 0.214 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRSN_EX_7a_8a {
@ SRSN_EX_7a:  SN extension outside of NMOS AA along GATE poly length direction with the parallel run length > 0.055um, if the distance to the related poly is > 0.20um>= 0.065um
@ SRSN_EX_8a:  SN extension outside of NMOS AA along GATE poly length direction with the parallel run length > 0.055um, if the distance to the related poly is <= 0.20um>= 0.065um
  X = NMOS TOUCH EDGE AAEIGT
  Y = ENC X [SN] < 0.065 OPPOSITE
  A = LENGTH Y > 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSN_EX_7b_8b {
@ SRSN_EX_7b:  SN extension outside of NMOS AA along GATE poly length direction with the parallel run length <= 0.055um, if the distance to the related poly is > 0.20um>= 0.06um
@ SRSN_EX_8b:  SN extension outside of NMOS AA along GATE poly length direction with the parallel run length <= 0.055um, if the distance to the related poly is <= 0.20um>= 0.06um
  X = NMOS TOUCH EDGE AAEIGT
  Y = ENC X [SN] < 0.06 OPPOSITE
  A = LENGTH Y <= 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
GROUP GSRSP SRSP_?
SRSP_S_3a {
@ Space between SP and N+ AA inside PW with the parallel run length > 0.055um>= 0.065um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SP
  Y = EXT [SP] X < 0.065 OPPOSITE
  A = LENGTH Y > 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSP_S_3b {
@ Space between SP and N+ AA inside PW with the parallel run length <= 0.055um>= 0.06um
  X = (NACT NOT NTAP) NOT TOUCH EDGE SP
  Y = EXT [SP] X < 0.06 OPPOSITE
  A = LENGTH Y <= 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSP_S_5 {
@ Space between SP and NMOS GATE along source/drain direction.>= 0.219um
  X = GATE_W INSIDE EDGE SN
  Y = EXT X SP < 0.219 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRSP_EX_6 {
@ SP extension outside of PMOS GATE along source/drain direction.>= 0.214um
  X = (GT INSIDE EDGE PACT) COIN EDGE GATE
  Y = ENC X SP < 0.214 ABUT<90 REGION OPPOSITE
  (Y NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRSP_EX_7a_8a {
@ SRSP_EX_7a:  SP extension outside of PMOS AA along GATE poly length direction with the parallel run length > 0.055Âµm, if the distance to the related poly is > 0.20um>= 0.065um
@ SRSP_EX_8a:  SP extension outside of PMOA AA along GATE poly length direction with the parallel run length > 0.055um, if the distance to the related poly is <= 0.20um>= 0.065um
  X = PMOS TOUCH EDGE AAEIGT
  Y = ENC X [SP] < 0.065 OPPOSITE
  A = LENGTH Y > 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRSP_EX_7b_8b {
@ SRSP_EX_7b:  SP extension outside of PMOS AA along GATE poly length direction with the parallel run length <= 0.055um, if the distance to the related poly is > 0.20Âµm>= 0.06um
@ SRSP_EX_8b:  SP extension outside of PMOS AA along GATE poly length direction with the parallel run length <= 0.055um, if the distance to the related poly is <= 0.20um>= 0.06um
  X = PMOS TOUCH EDGE AAEIGT
  Y = ENC X [SP] < 0.06 OPPOSITE
  A = LENGTH Y <= 0.055
  (A NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
GROUP GSRCT SRCT_?
CT_SR = CT INSIDE INST
SCT_SR = RECTANGLE CT_SR ASPECT == 1
RCT_SR = CT_SR NOT SCT_SR
SRCT_S_2a1 {
@ Space between contacts (runlength>0.02Âµm)>= 0.11 0.11um
  X = EXT [CT] < 0.11 OPPOSITE
  Y = LENGTH X > 0.02
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRCT_S_2a2 {
@ Space between contacts (runlength<=0.02Âµm)>= 0.11 0.09um
  X = EXT [CT] < 0.09 OPPOSITE
  Y = LENGTH X <= 0.02
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRCT_S_4a {
@ Space between GATE and contact on AA for 1.2V>= 0.05 0.038um
  X = EXT GATE_M (CT AND AA) < 0.038 ABUT<90 SINGULAR REGION
  ((X NOT DG) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRCT_EN_5 {
@ Square CT area enclosed by AA for CT landed on AA>= N/A 0.87
  X = SCT_SR CUT AA
  Y = X AND AA
  Z = DFM PROPERTY X Y OVERLAP ABUT ALSO
      [- = CO(Y)] == 1
      [- = AREA(Y)/AREA(X)] >= 0.87
  (X NOT Z) NOT INSIDE EXCLU
}
SRCT_EN_6 {
@ CT enclosure by poly for CT landed on poly (exclude rectangular CT)>= 0.01 0um
  ((SCT_SR INTERACT GT) NOT GT) NOT INSIDE EXCLU
}
SRCT_EN_7 {
@ M1 enclosure of CT (four directions, exclude rectangular CT)>= N/A 0um
  (SCT_SR NOT M1) NOT INSIDE EXCLU
}
SRCT_R_9 {
@ Square CT is not allowed to land on GATE N/A
  X = GATE AND SCT_SR
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRCT_W_101b {
@ Rectangular CT width >= N/A 0.08um
  (INT RCT_SR < 0.08 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SRCT_A_101c {
@ Rectangular CT overlap AA area>= N/A 0.01um2
  X = RCT_SR AND AA
  (AREA X < 0.01) NOT INSIDE EXCLU
}
SRCT_O_101d {
@ Rectangular CT overlap poly>= N/A 0.073um
  (INT RCT_SR GT < 0.073 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
SRCT_A_101e {
@ Rectangular CT overlap poly area>= N/A 0.006um2
  X = AND RCT_SR GT
  (AREA X < 0.006) NOT INSIDE EXCLU
}
SRCT_A_101f {
@ Rectangular CT overlap M1 area>= N/A 0.017um2
  X = AND RCT_SR M1
  (AREA X < 0.017) NOT INSIDE EXCLU
}
SRCT_EX_101g {
@ Poly extension outside of rectangular CT>= N/A -0.008um
  X = GT AND RCT_SR
  Y = CT ENCLOSE X
  Z = CONVEX EDGE X == 2
  M = Z NOT COIN EDGE Y
  L = CONVEX EDGE M ANGLE1 > 0 ANGLE2 > 0
  (ENC (L) Y <= 0.008 OPPOSITE) NOT INSIDE EDGE EXCLU
}
SRCT_EX_101h {
@ Rectangular CT extension outside of poly (without AA overlap)<= N/A 0.02um
  X = GT AND RCT_SR
  Y = CT ENCLOSE X
  Z = CONVEX EDGE X == 2
  M = Z NOT COIN EDGE Y
  L = CONVEX EDGE M ANGLE1 == 0 ANGLE2 >= 0
  H = ENC (L) Y <= 0.02 OPPOSITE
  (H NOT INSIDE EDGE AA) NOT INSIDE EDGE EXCLU
}
SRCT_EN_101i {
@ M1 enclosure of rectangular CT>= N/A -0.032um
  X = M1 INSIDE EDGE RCT_SR
  Y = EXPAND EDGE X OUTSIDE BY 0.032
  Z = (M1 WITH EDGE X) OR Y
  ((RCT_SR INTERACT Z) NOT Z) NOT INSIDE EXCLU
}
GROUP GSRM1 SRM1_?
SRM1_S_2a1 {
@ Space between M1s with the parallel run length > 0.26um>= 0.09um
  X = EXT [M1] < 0.09 OPPOSITE
  Y = LENGTH X > 0.26
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM1_S_2a2 {
@ Space between two M1s with the parallel run length >= 0.09um and <= 0.26um>= 0.08um
  X = EXT [M1] < 0.08 OPPOSITE
  Y = LENGTH X >= 0.09 <= 0.26
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM1_S_2a3 {
@ Space between two M1s with the parallel run length < 0.09um>= 0.075um
  X = EXT [M1] < 0.075 OPPOSITE
  Y = LENGTH X < 0.09
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM1_A_4 {
@ M1 area >= 0.027um2
 X = AREA (M1 OR M1DUM) < 0.027
 (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
M1_SR_EMPTY = EMPTY OR (M1 INTERACT INST)
CT_SR_EMPTY = EMPTY OR ((SIZE CT_SR BY -0.032) AND M1_SR_EMPTY)
V1_SR_EMPTY = EMPTY OR V1i
CONNECT M1_SR_EMPTY CT_SR_EMPTY
CONNECT M1_SR_EMPTY V1_SR_EMPTY
SRM1_S_101 {
@ Space between M1 and adjacent CT with parallel run length > 0um>= 0.082um
  X = EXT M1_SR_EMPTY CT_SR_EMPTY < 0.114 ABUT<90 REGION OPPOSITE EXTENDED 0.032 MEASURE ALL NOT CONNECTED
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRM1_S_102 {
@ Space between M1 and adjacent V1 with parallel run length >= 0um>= 0.087um
@ Note: Besides the rules listed in the table, SRAM M1 should follow general rule 7.4.15 except M1.S.2a and M1.A.4.
  X = EXT M1_SR_EMPTY [V1_SR_EMPTY] < 0.087 ABUT<90 OPPOSITE MEASURE ALL NOT CONNECTED
  (X NOT OUTSIDE EDGE INST ) NOT INSIDE EDGE EXCLU
}
GROUP GSRV1 SRV1_?
SRV1_EN_3a {
@ M1 enclosure of V1 ( four directions)>= 0um
 ((V1i NOT M1) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
SRV1_EN_5a {
@ M2 enclosure of V1 ( four directions)>= 0um
 ((V1i NOT M2) NOT OUTSIDE INST) NOT INSIDE EXCLU
}
GROUP GSRM2 SRM2_?
SRM2_S_2a1 {
@ Space between two M2s with the parallel run length>= 0.25um>= 0.1um
  X = EXT [M2] < 0.10 OPPOSITE
  Y = LENGTH X >= 0.25
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM2_S_2a2 {
@ Space between two M2s with the parallel run length>= 0.02um and < 0.25um>= 0.095um
  X = EXT [M2] < 0.095 OPPOSITE
  Y = LENGTH X >= 0.02 < 0.25
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM2_S_2a3 {
@ Space between two M2s with the parallel run length< 0.02um>= 0.09um
  X = EXT [M2] < 0.09 OPPOSITE
  Y = LENGTH X < 0.02
  (Y NOT OUTSIDE EDGE INST) NOT INSIDE EDGE EXCLU
}
SRM2_A_4 {
@ M2 area >= 0.03um2
  X = AREA (M2 OR M2DUM) < 0.03
  (X NOT OUTSIDE INST) NOT INSIDE EXCLU
}
#IFDEF Latch_Up_CHECK YES
ALL_RES = (AA ENCLOSE (AA_resistor OR NW_resistor)) OR (GT ENCLOSE GT_resistor)
LAYER MAP 999 DATATYPE 1117 4327
LAYER EMPTY5 4327
#IFDEF CONNECT_ALL_RESISTOR NO
NSD_EMPTY5 = EMPTY5 OR (NSD NOT ALL_RES)
PSD_EMPTY5 = EMPTY5 OR (PSD NOT ALL_RES)
NTAP_EMPTY5 = EMPTY5 OR (NTAP NOT ALL_RES)
PTAP_EMPTY5 = EMPTY5 OR (PTAP NOT ALL_RES)
NW_EMPTY5 = EMPTY5 OR (NW NOT ALL_RES)
GT_EMPTY5 = EMPTY5 OR (GT NOT ALL_RES)
NACT_NOT_GT_EMPTY5 = EMPTY5 OR (NACT_NOT_GT NOT ALL_RES)
PACT_NOT_GT_EMPTY5 = EMPTY5 OR (PACT_NOT_GT NOT ALL_RES)
#ENDIF
#IFDEF CONNECT_ALL_RESISTOR YES
NSD_EMPTY5 = EMPTY5 OR NSD
PSD_EMPTY5 = EMPTY5 OR PSD
NTAP_EMPTY5 = EMPTY5 OR NTAP
PTAP_EMPTY5 = EMPTY5 OR PTAP
NW_EMPTY5 = EMPTY5 OR NW
GT_EMPTY5 = EMPTY5 OR GT
NACT_NOT_GT_EMPTY5 = EMPTY5 OR NACT_NOT_GT
PACT_NOT_GT_EMPTY5 = EMPTY5 OR PACT_NOT_GT
#ENDIF
CT_EMPTY5 = EMPTY5 OR CT
RV_EMPTY5 = EMPTY5 OR RV
ALPA_EMPTY5 = EMPTY5 OR ALPA
PA_EMPTY5 = EMPTY5 OR PA
BCB1_EMPTY5 = EMPTY5 OR BCB1
RDL_EMPTY5 = EMPTY5 OR RDL
BCB2_EMPTY5 = EMPTY5 OR BCB2
PW_EMPTY5 = EMPTY5 OR PW
DNW_EMPTY5 = EMPTY5 OR DNW
M1_EMPTY5 = EMPTY5 OR M1
M2_EMPTY5 = EMPTY5 OR M2
M3_EMPTY5 = EMPTY5 OR M3
M4_EMPTY5 = EMPTY5 OR M4
M5_EMPTY5 = EMPTY5 OR M5
M6_EMPTY5 = EMPTY5 OR M6
TKM_EMPTY5 = EMPTY5 OR TKM
V1_EMPTY5 = EMPTY5 OR V1
V2_EMPTY5 = EMPTY5 OR V2
V3_EMPTY5 = EMPTY5 OR V3
V4_EMPTY5 = EMPTY5 OR V4
V5_EMPTY5 = EMPTY5 OR V5
TV2_EMPTY5 = EMPTY5 OR TV2
CONNECT M1_EMPTY5 GT_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 NTAP_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 PTAP_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 NSD_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 PSD_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 NACT_NOT_GT_EMPTY5 BY CT_EMPTY5
CONNECT M1_EMPTY5 PACT_NOT_GT_EMPTY5 BY CT_EMPTY5
CONNECT NTAP_EMPTY5 NW_EMPTY5
CONNECT NTAP_EMPTY5 PSD_EMPTY5
CONNECT PTAP_EMPTY5 NSD_EMPTY5
CONNECT PTAP_EMPTY5 PW_EMPTY5
CONNECT NW_EMPTY5 DNW_EMPTY5
CONNECT M1_EMPTY5 M2_EMPTY5 BY V1_EMPTY5
CONNECT M2_EMPTY5 M3_EMPTY5 BY V2_EMPTY5
CONNECT M3_EMPTY5 M4_EMPTY5 BY V3_EMPTY5
CONNECT M4_EMPTY5 M5_EMPTY5 BY V4_EMPTY5
CONNECT M5_EMPTY5 M6_EMPTY5 BY V5_EMPTY5
CONNECT M6_EMPTY5 TKM_EMPTY5 BY TV2_EMPTY5
CONNECT TKM_EMPTY5 RV_EMPTY5
CONNECT RV_EMPTY5 ALPA_EMPTY5
CONNECT ALPA_EMPTY5 PA_EMPTY5
CONNECT TKM_EMPTY5 RDL_EMPTY5 BY BCB1_EMPTY5
CONNECT RDL_EMPTY5 BCB2_EMPTY5
