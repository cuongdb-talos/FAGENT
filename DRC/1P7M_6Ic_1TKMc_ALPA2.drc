}
#ENDIF
#ENDIF
#IFDEF GUIXI_SPECIAL NO
M2_S_7 {
    @ Space between metal lines with one or both is 45 degree and the bending length >=0.5um (the area with 0.1um distance from bending point need not follow this rule)>= 0.115um
    X = ANGLE M2 >= 44.9 <= 45.1
    Y = LENGTH X >= 0.5
    (EXT Y < 0.115 REGION) NOT INSIDE EXCLU
    (EXT Y M2 < 0.115 REGION CORNER TO EDGE) NOT INSIDE EXCLU
}
M2_S_11 {
    @ Space (S1 or S2) at Mn line-end (W<0.12um) in a dense-line-end configuration: If Mn has parallel run length with opposite Mn (measured with E1>=-0.035um extension) along 2 adjacent edges of Mn (any one edge distance from the corner of the two edges: K1<0.12um), then one of the space (S1 or S2) needs to be at least this value (except for small jog with edge length < 0.10um). DRC waive check the INST covered region.>= 0.12um
    LINE_END = CONVEX EDGE M2 ANGLE1 == 90 LENGTH1 >= 0.10 ANGLE2 == 90 LENGTH2 >= 0.10 WITH LENGTH < 0.12
    LINE_END_SHAPE = EXPAND EDGE LINE_END INSIDE BY 0.12
    LINE_SIDE = (M2 COIN EDGE LINE_END_SHAPE ) NOT COIN EDGE LINE_END
    LINE_END_EXP = EXPAND EDGE LINE_END INSIDE BY 0.001 EXTEND BY 0.035
    LINE_SIDE_EXP = EXPAND EDGE LINE_SIDE INSIDE BY 0.001 EXTEND BY 0.035
    LINE_END_1 = LINE_END_EXP TOUCH EDGE LINE_END
    LINE_SIDE_1 = LINE_SIDE_EXP TOUCH EDGE LINE_SIDE
    E1 = EXT [LINE_END_1] M2 < 0.12 OPPOSITE PERP ALSO OBTUSE ALSO
    E2 = EXT [LINE_SIDE] < 0.12 OPPOSITE
    LINE_END_E1 = LINE_END_1 TOUCH EDGE E1
    LINE_SIDE_E2 = LINE_SIDE_1 TOUCH EDGE E2
    M2_CORNER = INT LINE_END_E1 LINE_SIDE_E2 <= 0.002 ABUT == 90 REGION
    ((LINE_END_SHAPE INTERACT M2_CORNER) OUTSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
M2_S_7a {
    @ Space between metal lines with one or both is 45 degree and the bending length >=0.5um (the area with 0.1um distance from bending point need not follow this rule)>= 0.113um
    X = ANGLE M2 >= 44.9 <= 45.1
    Y = LENGTH X >= 0.5
    (EXT Y < 0.113 REGION) NOT INSIDE EXCLU
    (EXT Y M2 < 0.113 REGION CORNER TO EDGE) NOT INSIDE EXCLU
}
#ENDIF
GROUP GM3 M3_?
M3_W_1 {
    @ Mn width >= 0.1um
    (INT M3 < 0.1 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M3_S_2a {
    @ Space between two Mns. DRC waive check 89 to 90 degree spaces in the INDMY region. (If n=2, DRC waive check the INST region)>= 0.1um
    X = EXT M3 < 0.1 ABUT<90 SINGULAR REGION
    (X NOT INDMY) NOT INSIDE EXCLU
    Y = EXT M3< 0.10 ABUT<89 SINGULAR REGION
    (Y AND INDMY) NOT INSIDE EXCLU
}
M3_S_2b {
    @ Space between two Mns when one or both Mn width or length>=1um, and the run length of two Mns is >=2um. Mn width or length direction checked by DRC is perpendicular to run length direction.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M3ALL < 1 BY INT) EDGE
    span_edge_1 = M3ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M3ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
M3_S_2c {
    @ Space between two Mns when one or both Mn width or length >=5um, and the run length of two Mns is >=2um.
    @ M1 width or length direction checked by DRC is perpendicular to run length direction.>= 0.5um
    span_edge_0 = DFM COPY (DFM SPACE M3ALL < 5 BY INT) EDGE
    span_edge_1 = M3ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M3ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M3_S_2d_R {
    @ Space between two Mns when one or both Mn width >=0.4um, and the parallel run length of two Mns is >= 0.4um.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M3ALL < 0.4 BY INT) EDGE
    span_edge_1 = M3ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M3ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.4) NOT INSIDE EDGE EXCLU
}
#ENDIF
M3_W_3 {
    @ Mn width (Exclude DUPMK1 region when Mn as TM-1 in 1 top metal option)<= 12um
    (M3 WITH WIDTH > 12)NOT INSIDE EXCLU
}
M3_A_4 {
    @ Mn area (If n=2, DRC waive check the INST region).>= 0.035 um 2
    X = AREA M3 < 0.035
    X NOT INSIDE EXCLU
}
M3_EN_5 {
    @ Enclosed area by Mn >= 0.12 um 2
    X = (HOLES M3 INNER) NOT M3
    (AREA X < 0.12) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
M3_D_6a_min {
    @ Mn density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking
    @ (Exclude DUPMK1 region when when Mn as TM-1 in 1 top metal option)>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M3ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(200.0*200.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.15 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6a_min.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6a_min.rdb"
}
M3_D_6a_max {
    @ Mn density (including dummy) in 200umX200um window with step size 100um. INDMY/MARKF/MARKG/MARKS covered areas are excluded for this rule checking
    @ (Exclude DUPMK1 region when when Mn as TM-1 in 1 top metal option)>= 0.15
    @ <= 0.8
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M3ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 200.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window1)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 200.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window2)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 200.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(200.0*200.0/4-AREA(Check_window3)))] > 0.8 WINDOW 200.0 STEP 100.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6a_max.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6a_max.rdb"
}
M3_D_6b {
    @ Mn density (including dummy) in 50umX50um window with step size 25um.(Exclude DUPMK1 when when Mn as TM-1 in 1 top metal option)<= 0.9
    Check_region = DRC:1 NOT EXCLUi
    Check_pattern = (M3ALL NOT EXCLUi) AND Check_region
    Check_window1 = Check_region with width >= 50.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window1)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 50.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window2)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 50.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(50.0*50.0/4-AREA(Check_window3)))] > 0.9 WINDOW 50.0 STEP 25.0 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6b.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6b.rdb"
}
M3_D_6c {
    @ The difference between Mn density in 200umX200um with step size 200um and those of the adjacent checking windows (including dummy). INDMY/MARKG/MARKF/MARKS covered areas are excluded for this rule checking<= 0.45
    Check_pattern = M3ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_region = DRC:1 NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    DENSITY Check_pattern Check_region [AREA(Check_pattern)/AREA(Check_region)] >= 0 WINDOW 200.0 GRADIENT > 0.45 ABSOLUTE BACKUP
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6c.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6c.rdb"
}
M3_D_6d {
    @ Mn density (including dummy) in 25umX25um window with step size 12.5um. INDMY/MARKG/MARKS covered areas are excluded for this rule checking>= 0.1
    Check_region = DRC:1 NOT (OR INDMY MARKG MARKS EXCLUi)
    Check_pattern = (M3ALL NOT (OR INDMY MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6d.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6d.rdb"
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M3_D_6e_min_R {
    @ Average density for Mn inside the dummy block area in 25umX25um window with step size 12.5um when the dummy block area ((DUMBM OR Mn(n=2-8)DUB) OR NODMF) >= 25umX25um. INDMY/MARKF/MARKG/ MARKS covered areas are excluded from this rule checking.>= 0.1
    @ <= 0.9
    X = OR DUMBM M3DUB NODMF
    Y = SIZE X BY 12.5 UNDEROVER
    Check_region = Y NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M3ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    CHIP_wilayer = BULK INTERACT Check_pattern
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window1))+(!AREA(Check_window1)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window2))+(!AREA(Check_window2)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region CHIP_wilayer [~~(25.0*25.0/4-AREA(Check_window3))+(!AREA(Check_window3)+(!AREA(CHIP_wilayer)+AREA(Check_pattern)/AREA(Check_region)))] < 0.1 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6e_min_R.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6e_min_R.rdb"
}
M3_D_6e_max_R {
    @ Average density for Mn inside the dummy block area in 25umX25um window with step size 12.5um when the dummy block area ((DUMBM OR Mn(n=2-8)DUB) OR NODMF) >= 25umX25um. INDMY/MARKF/MARKG/ MARKS covered areas are excluded from this rule checking.>= 0.1
    @ <= 0.9
    X = OR DUMBM M3DUB NODMF
    Y = SIZE X BY 12.5 UNDEROVER
    Check_region = Y NOT (OR INDMY MARKF MARKG MARKS EXCLUi)
    Check_pattern = (M3ALL NOT (OR INDMY MARKF MARKG MARKS EXCLUi)) AND Check_region
    Check_window1 = Check_region with width >= 25.0/4
    err1_TMP1 = DENSITY Check_pattern Check_window1 Check_region [!!AREA(Check_window1)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window1)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER DRC:1 BY POLYGON
    Check_window2 = (Check_region AND err1_TMP1) with width >= 25.0/4
    err1_TMP2 = DENSITY Check_pattern Check_window2 Check_region [!!AREA(Check_window2)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window2)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP1 BY POLYGON
    Check_window3 = (Check_region AND err1_TMP2) with width >= 25.0/4
    DENSITY Check_pattern Check_window3 Check_region [!!AREA(Check_window3)*AREA(Check_pattern)/AREA(Check_region)-(~~(25.0*25.0/4-AREA(Check_window3)))] > 0.9 WINDOW 25.0 STEP 12.5 BACKUP INSIDE OF LAYER err1_TMP2 BY POLYGON
    PRINT "./Process_CALDRC_logfile/density_report_M3_D_6e_max_R.log"
    RDB "./Process_CALDRC_logfile/density_report_M3_D_6e_max_R.rdb"
}
#ENDIF
#ENDIF
#IFDEF GUIXI_SPECIAL NO
M3_S_7 {
    @ Space between metal lines with one or both is 45 degree and the bending length >=0.5um (the area with 0.1um distance from bending point need not follow this rule)>= 0.115um
    X = ANGLE M3 >= 44.9 <= 45.1
    Y = LENGTH X >= 0.5
    (EXT Y < 0.115 REGION) NOT INSIDE EXCLU
    (EXT Y M3 < 0.115 REGION CORNER TO EDGE) NOT INSIDE EXCLU
}
M3_S_11 {
    @ Space (S1 or S2) at Mn line-end (W<0.12um) in a dense-line-end configuration: If Mn has parallel run length with opposite Mn (measured with E1>=-0.035um extension) along 2 adjacent edges of Mn (any one edge distance from the corner of the two edges: K1<0.12um), then one of the space (S1 or S2) needs to be at least this value (except for small jog with edge length < 0.10um). DRC waive check the INST covered region.>= 0.12um
    LINE_END = CONVEX EDGE M3 ANGLE1 == 90 LENGTH1 >= 0.10 ANGLE2 == 90 LENGTH2 >= 0.10 WITH LENGTH < 0.12
    LINE_END_SHAPE = EXPAND EDGE LINE_END INSIDE BY 0.12
    LINE_SIDE = (M3 COIN EDGE LINE_END_SHAPE ) NOT COIN EDGE LINE_END
    LINE_END_EXP = EXPAND EDGE LINE_END INSIDE BY 0.001 EXTEND BY 0.035
    LINE_SIDE_EXP = EXPAND EDGE LINE_SIDE INSIDE BY 0.001 EXTEND BY 0.035
    LINE_END_1 = LINE_END_EXP TOUCH EDGE LINE_END
    LINE_SIDE_1 = LINE_SIDE_EXP TOUCH EDGE LINE_SIDE
    E1 = EXT [LINE_END_1] M3 < 0.12 OPPOSITE PERP ALSO OBTUSE ALSO
    E2 = EXT [LINE_SIDE] < 0.12 OPPOSITE
    LINE_END_E1 = LINE_END_1 TOUCH EDGE E1
    LINE_SIDE_E2 = LINE_SIDE_1 TOUCH EDGE E2
    M3_CORNER = INT LINE_END_E1 LINE_SIDE_E2 <= 0.002 ABUT == 90 REGION
    ((LINE_END_SHAPE INTERACT M3_CORNER) OUTSIDE INST) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF GUIXI_SPECIAL YES
M3_S_7a {
    @ Space between metal lines with one or both is 45 degree and the bending length >=0.5um (the area with 0.1um distance from bending point need not follow this rule)>= 0.113um
    X = ANGLE M3 >= 44.9 <= 45.1
    Y = LENGTH X >= 0.5
    (EXT Y < 0.113 REGION) NOT INSIDE EXCLU
    (EXT Y M3 < 0.113 REGION CORNER TO EDGE) NOT INSIDE EXCLU
}
#ENDIF
GROUP GM4 M4_?
M4_W_1 {
    @ Mn width >= 0.1um
    (INT M4 < 0.1 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
M4_S_2a {
    @ Space between two Mns. DRC waive check 89 to 90 degree spaces in the INDMY region. (If n=2, DRC waive check the INST region)>= 0.1um
    X = EXT M4 < 0.1 ABUT<90 SINGULAR REGION
    (X NOT INDMY) NOT INSIDE EXCLU
    Y = EXT M4< 0.10 ABUT<89 SINGULAR REGION
    (Y AND INDMY) NOT INSIDE EXCLU
}
M4_S_2b {
    @ Space between two Mns when one or both Mn width or length>=1um, and the run length of two Mns is >=2um. Mn width or length direction checked by DRC is perpendicular to run length direction.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M4ALL < 1 BY INT) EDGE
    span_edge_1 = M4ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M4ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
M4_S_2c {
    @ Space between two Mns when one or both Mn width or length >=5um, and the run length of two Mns is >=2um.
    @ M1 width or length direction checked by DRC is perpendicular to run length direction.>= 0.5um
    span_edge_0 = DFM COPY (DFM SPACE M4ALL < 5 BY INT) EDGE
    span_edge_1 = M4ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M4ALL < 0.5 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 2) NOT INSIDE EDGE EXCLU
}
#IFDEF RECOMMENDED_CHECK_TURN_OFF YES
M4_S_2d_R {
    @ Space between two Mns when one or both Mn width >=0.4um, and the parallel run length of two Mns is >= 0.4um.>= 0.16um
    span_edge_0 = DFM COPY (DFM SPACE M4ALL < 0.4 BY INT) EDGE
    span_edge_1 = M4ALL NOT COIN EDGE span_edge_0
    span_edge = EXT [span_edge_1] M4ALL < 0.16 ABUT < 90 OPPOSITE
    (LENGTH span_edge >= 0.4) NOT INSIDE EDGE EXCLU
}
#ENDIF
M4_W_3 {
    @ Mn width (Exclude DUPMK1 region when Mn as TM-1 in 1 top metal option)<= 12um
    (M4 WITH WIDTH > 12)NOT INSIDE EXCLU
}
M4_A_4 {
    @ Mn area (If n=2, DRC waive check the INST region).>= 0.035 um 2
    X = AREA M4 < 0.035
    X NOT INSIDE EXCLU
}
M4_EN_5 {
    @ Enclosed area by Mn >= 0.12 um 2
    X = (HOLES M4 INNER) NOT M4
    (AREA X < 0.12) NOT INSIDE EXCLU
}
#IFDEF DENSITY_CHECK YES
