    @ 2.Â  The wide metal interacts with metal slot (M1SLOT, M2SLOT...)
    @ 3.Â  Metal slot (M1SLOT, M2SLOT...) size > 10*10 um are not included this rule density calculation
    @ 4.Â  DRC doesnât check metals interact with RV
    @ 5.Â  DRC individually exports result by each metal layer>= 0.15
    X = ((TKMi NOT INTERACT RV) WITH WIDTH > 30) INTERACT TKMSLOT
    Y = (TKMSLOT WITH WIDTH <=10) NOT INTERACT RV
    Z = DFM PROPERTY X Y OVERLAP [- = AREA(Y)/AREA(X)] < 0.15
    DFM RDB Z "./Process_CALDRC_logfile/density_report_DFM_D_102_TKM.log"
    (DFM COPY Z) NOT INSIDE EXDFM
}
#ENDIF
LAYER MAP 999 DATATYPE 1118 4328
LAYER EMPTY4 4328
V1_EMPTY4 = EMPTY4 OR V1i
M2_EMPTY4 = EMPTY4 OR M2
CONNECT M2_EMPTY4 V1_EMPTY4
DFM_S_103_V1 {
    @ Space between Vn and unconnected Mn+1 (n = 1,2,3,4,5,6,7)>= 0.12um
    (EXT M2_EMPTY4 V1_EMPTY4 < 0.12 ABUT<90 REGION OPPOSITE MEASURE ALL NOT CONNECTED) NOT INSIDE EXDFM
}
V2_EMPTY4 = EMPTY4 OR V2i
M3_EMPTY4 = EMPTY4 OR M3
CONNECT M3_EMPTY4 V2_EMPTY4
DFM_S_103_V2 {
    @ Space between Vn and unconnected Mn+1 (n = 1,2,3,4,5,6,7)>= 0.12um
    (EXT M3_EMPTY4 V2_EMPTY4 < 0.12 ABUT<90 REGION OPPOSITE MEASURE ALL NOT CONNECTED) NOT INSIDE EXDFM
}
V3_EMPTY4 = EMPTY4 OR V3i
M4_EMPTY4 = EMPTY4 OR M4
CONNECT M4_EMPTY4 V3_EMPTY4
DFM_S_103_V3 {
    @ Space between Vn and unconnected Mn+1 (n = 1,2,3,4,5,6,7)>= 0.12um
    (EXT M4_EMPTY4 V3_EMPTY4 < 0.12 ABUT<90 REGION OPPOSITE MEASURE ALL NOT CONNECTED) NOT INSIDE EXDFM
}
V4_EMPTY4 = EMPTY4 OR V4i
M5_EMPTY4 = EMPTY4 OR M5
CONNECT M5_EMPTY4 V4_EMPTY4
DFM_S_103_V4 {
    @ Space between Vn and unconnected Mn+1 (n = 1,2,3,4,5,6,7)>= 0.12um
    (EXT M5_EMPTY4 V4_EMPTY4 < 0.12 ABUT<90 REGION OPPOSITE MEASURE ALL NOT CONNECTED) NOT INSIDE EXDFM
}
V5_EMPTY4 = EMPTY4 OR V5i
M6_EMPTY4 = EMPTY4 OR M6
CONNECT M6_EMPTY4 V5_EMPTY4
DFM_S_103_V5 {
    @ Space between Vn and unconnected Mn+1 (n = 1,2,3,4,5,6,7)>= 0.12um
    (EXT M6_EMPTY4 V5_EMPTY4 < 0.12 ABUT<90 REGION OPPOSITE MEASURE ALL NOT CONNECTED) NOT INSIDE EXDFM
}
