NAA_POWER_PAD_M3_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_M3 > 0
PAA_POWER_PAD_M3_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_M3 > 0
NAA_POWER_PAD_M4_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_M4 > 0
PAA_POWER_PAD_M4_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_M4 > 0
NAA_POWER_PAD_M5_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_M5 > 0
PAA_POWER_PAD_M5_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_M5 > 0
NAA_POWER_PAD_M6_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_M6 > 0
PAA_POWER_PAD_M6_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_M6 > 0
NAA_POWER_PAD_TKM_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_TKM > 0
PAA_POWER_PAD_TKM_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_TKM > 0
NAA_POWER_PAD_RV_1 = NET AREA RATIO NAA_PAD1 power_pad_TXT_RV > 0
PAA_POWER_PAD_RV_1 = NET AREA RATIO PAA_PAD1 power_pad_TXT_RV > 0
NAA_POWER_PAD_M1_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M1 > 0
PAA_POWER_PAD_M1_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M1 > 0
NAA_POWER_PAD_M2_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M2 > 0
PAA_POWER_PAD_M2_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M2 > 0
NAA_POWER_PAD_M3_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M3 > 0
PAA_POWER_PAD_M3_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M3 > 0
NAA_POWER_PAD_M4_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M4 > 0
PAA_POWER_PAD_M4_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M4 > 0
NAA_POWER_PAD_M5_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M5 > 0
PAA_POWER_PAD_M5_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M5 > 0
NAA_POWER_PAD_M6_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_M6 > 0
PAA_POWER_PAD_M6_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_M6 > 0
NAA_POWER_PAD_TKM_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_TKM > 0
PAA_POWER_PAD_TKM_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_TKM > 0
NAA_POWER_PAD_RDL_2 = NET AREA RATIO NAA_PAD2 power_pad_TXT_RDL > 0
PAA_POWER_PAD_RDL_2 = NET AREA RATIO PAA_PAD2 power_pad_TXT_RDL > 0
NAA_POWER_PAD_all_1 = COPY NAA_POWER_PAD_M1_1
NAA_POWER_PAD_all_2 = NAA_POWER_PAD_all_1 OR NAA_POWER_PAD_M2_1
NAA_POWER_PAD_all_3 = NAA_POWER_PAD_all_2 OR NAA_POWER_PAD_M3_1
NAA_POWER_PAD_all_4 = NAA_POWER_PAD_all_3 OR NAA_POWER_PAD_M4_1
NAA_POWER_PAD_all_5 = NAA_POWER_PAD_all_4 OR NAA_POWER_PAD_M5_1
NAA_POWER_PAD_all_6 = NAA_POWER_PAD_all_5 OR NAA_POWER_PAD_M6_1
NAA_POWER_PAD_all_7 = NAA_POWER_PAD_all_6 OR NAA_POWER_PAD_TKM_1
NAA_POWER_PAD_all_8 = NAA_POWER_PAD_all_7 OR NAA_POWER_PAD_RV_1
PAA_POWER_PAD_all_1 = COPY PAA_POWER_PAD_M1_1
PAA_POWER_PAD_all_2 = PAA_POWER_PAD_all_1 OR PAA_POWER_PAD_M2_1
PAA_POWER_PAD_all_3 = PAA_POWER_PAD_all_2 OR PAA_POWER_PAD_M3_1
PAA_POWER_PAD_all_4 = PAA_POWER_PAD_all_3 OR PAA_POWER_PAD_M4_1
PAA_POWER_PAD_all_5 = PAA_POWER_PAD_all_4 OR PAA_POWER_PAD_M5_1
PAA_POWER_PAD_all_6 = PAA_POWER_PAD_all_5 OR PAA_POWER_PAD_M6_1
PAA_POWER_PAD_all_7 = PAA_POWER_PAD_all_6 OR PAA_POWER_PAD_TKM_1
PAA_POWER_PAD_all_8 = PAA_POWER_PAD_all_7 OR PAA_POWER_PAD_RV_1
NAA_POWER_PAD_all_1_BCB2 = COPY NAA_POWER_PAD_M1_2
NAA_POWER_PAD_all_2_BCB2 = NAA_POWER_PAD_all_1_BCB2 OR NAA_POWER_PAD_M2_2
NAA_POWER_PAD_all_3_BCB2 = NAA_POWER_PAD_all_2_BCB2 OR NAA_POWER_PAD_M3_2
NAA_POWER_PAD_all_4_BCB2 = NAA_POWER_PAD_all_3_BCB2 OR NAA_POWER_PAD_M4_2
NAA_POWER_PAD_all_5_BCB2 = NAA_POWER_PAD_all_4_BCB2 OR NAA_POWER_PAD_M5_2
NAA_POWER_PAD_all_6_BCB2 = NAA_POWER_PAD_all_5_BCB2 OR NAA_POWER_PAD_M6_2
NAA_POWER_PAD_all_7_BCB2 = NAA_POWER_PAD_all_6_BCB2 OR NAA_POWER_PAD_TKM_2
NAA_POWER_PAD_all_8_BCB2 = NAA_POWER_PAD_all_7_BCB2 OR NAA_POWER_PAD_RDL_2
PAA_POWER_PAD_all_1_BCB2 = COPY PAA_POWER_PAD_M1_2
PAA_POWER_PAD_all_2_BCB2 = PAA_POWER_PAD_all_1_BCB2 OR PAA_POWER_PAD_M2_2
PAA_POWER_PAD_all_3_BCB2 = PAA_POWER_PAD_all_2_BCB2 OR PAA_POWER_PAD_M3_2
PAA_POWER_PAD_all_4_BCB2 = PAA_POWER_PAD_all_3_BCB2 OR PAA_POWER_PAD_M4_2
PAA_POWER_PAD_all_5_BCB2 = PAA_POWER_PAD_all_4_BCB2 OR PAA_POWER_PAD_M5_2
PAA_POWER_PAD_all_6_BCB2 = PAA_POWER_PAD_all_5_BCB2 OR PAA_POWER_PAD_M6_2
PAA_POWER_PAD_all_7_BCB2 = PAA_POWER_PAD_all_6_BCB2 OR PAA_POWER_PAD_TKM_2
PAA_POWER_PAD_all_8_BCB2 = PAA_POWER_PAD_all_7_BCB2 OR PAA_POWER_PAD_RDL_2
NAA_IO_PAD1 = NAA_PAD1 NOT INTERACT NAA_POWER_PAD_all_8
NAA_IO_PAD2 = NAA_PAD2 NOT INTERACT NAA_POWER_PAD_all_8_BCB2
PAA_IO_PAD1 = PAA_PAD1 NOT INTERACT PAA_POWER_PAD_all_8
PAA_IO_PAD2 = PAA_PAD2 NOT INTERACT PAA_POWER_PAD_all_8_BCB2
NMOS_IO_PAD = NMOS_1 INTERACT (OR NAA_IO_PAD1 NAA_IO_PAD2)
PMOS_IO_PAD = PMOS_1 INTERACT (OR PAA_IO_PAD1 PAA_IO_PAD2)
#ENDIF
NAA_IO_PAD_check = (OR NAA_IO_PAD1 NAA_IO_PAD2) NOT LUWMK1
PAA_IO_PAD_check = (OR PAA_IO_PAD1 PAA_IO_PAD2) NOT LUWMK1
NMOS_IO_PAD_check = NMOS_IO_PAD NOT LUWMK1
PMOS_IO_PAD_check = PMOS_IO_PAD NOT LUWMK1
PMOS1 = PACT ENCLOSE GATE
NMOS1 = NACT ENCLOSE GATE
NGUARDRING = HOLES NTAP INNER
PGUARDRING = HOLES PTAP INNER
NGUARDHOLE_2 = (HOLES NTAP INNER) ENCLOSE PGUARDRING
PGUARDHOLE_2 = (HOLES PTAP INNER) ENCLOSE NGUARDRING
GATEMV = GATE AND DG //2.5V
GATELV = GATE NOT INSIDE DG //1.2V
GROUP GLU LU_?
LU_R_1_G {
    @ Guard ring should be used to surround AA injector or a group of AA injectors which are connected to an I/O pad.
    @ N+ injector must be surrounded by a P+ guard-ring.
    @ P+ injector must be surrounded by a N+ guard-ring.
    @ NW/PW pickups rings can be used as guard rings. DRC check the nearest guard-ring which surrounds AA injector or a group of AA injector.
    (NAA_IO_PAD_check NOT PGUARDRING) NOT INSIDE EXCLU
    (PAA_IO_PAD_check NOT NGUARDRING) NOT INSIDE EXCLU
}
LU_R_2_G {
    @ Guard-ring width for AA injector connected to an I/O pad. Guard-ring definition please refers to LU.1.>= 0.12 Âµm
    X = SIZE (NGUARDRING ENCLOSE PAA_IO_PAD_check) BY 0.12
    Y = SIZE (PGUARDRING ENCLOSE NAA_IO_PAD_check) BY 0.12
    (X NOT ((HOLES NTAP INNER) OR (DONUT NTAP))) NOT INSIDE EXCLU
    (Y NOT ((HOLES PTAP INNER) OR (DONUT PTAP))) NOT INSIDE EXCLU
}
#IFDEF LU_3_CHECK FAST
LU_S_3a_3b_G {
    @ LU_S_3a_G: LU.3b-LU.3e define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig. 7.3.10-1)
    @ LU_S_3b_G: For 1.2V N/PMOS AA connected to an I/O pad Spacing between NMOS and PMOS>= 2 Âµm
    X = NMOS_IO_PAD_check ENCLOSE GATELV
    Y = PMOS_IO_PAD_check ENCLOSE GATELV
    M = (NMOS_1 ENCLOSE GATELV) NOT LUWMK1
    N = (PMOS_1 ENCLOSE GATELV) NOT LUWMK1
    Z1 = SIZE X BY 1.036 BEVEL 3
    Z2 = SIZE N BY 1.036 BEVEL 3
    (Z1 AND Z2) NOT INSIDE EXCLU
    Z3 = SIZE M BY 1.036 BEVEL 3
    Z4 = SIZE Y BY 1.036 BEVEL 3
    (Z3 AND Z4) NOT INSIDE EXCLU
}
LU_S_3a_3d_G {
    @ LU_S_3a_G: LU.3b-LU.3e define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig. 7.3.10-1)
    @ LU_S_3d_G: For 2.5V N/PMOS AA connected to an I/O pad
    @ Spacing between 2.5V NMOS and 2.5V/1.2V PMOS and Spacing between 2.5V PMOS and 2.5V/1.2V NMOS>= 3.2 Âµm
    X = NMOS_IO_PAD_check ENCLOSE GATEMV
    Y = PMOS_IO_PAD_check ENCLOSE GATEMV
    M = (NMOS_1 ENCLOSE (GATELV OR GATEMV)) NOT LUWMK1
    N = (PMOS_1 ENCLOSE (GATELV OR GATEMV)) NOT LUWMK1
    Z1 = SIZE X BY 1.657 BEVEL 3
    Z2 = SIZE N BY 1.657 BEVEL 3
    (Z1 AND Z2) NOT INSIDE EXCLU
    Z3 = SIZE M BY 1.657 BEVEL 3
    Z4 = SIZE Y BY 1.657 BEVEL 3
    (Z3 AND Z4) NOT INSIDE EXCLU
}
#ENDIF
#IFDEF LU_3_CHECK ACCURATE
LU_S_3a_3b_G {
    @ LU_S_3a_G: LU.3b-LU.3e define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig. 7.3.10-1)
    @ LU_S_3b_G: For 1.2V N/PMOS AA connected to an I/O pad Spacing between NMOS and PMOS>= 2 Âµm
    X = NMOS_IO_PAD_check ENCLOSE GATELV
    Y = PMOS_IO_PAD_check ENCLOSE GATELV
    M = (NMOS_1 ENCLOSE GATELV) NOT LUWMK1
    N = (PMOS_1 ENCLOSE GATELV) NOT LUWMK1
    (EXT X N < 2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
    (EXT M Y < 2 ABUT<90 SINGULAR REGION) NOT INSIDE EXCLU
}
LU_S_3a_3d_G {
    @ LU_S_3a_G: LU.3b-LU.3e define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig. 7.3.10-1)
    @ LU_S_3d_G: For 2.5V N/PMOS AA connected to an I/O pad
    @ Spacing between 2.5V NMOS and 2.5V/1.2V PMOS and Spacing between 2.5V PMOS and 2.5V/1.2V NMOS>= 3.2 Âµm
    X = NMOS_IO_PAD_check ENCLOSE GATEMV
    Y = PMOS_IO_PAD_check ENCLOSE GATEMV
    M = (NMOS_1 ENCLOSE (GATELV OR GATEMV)) NOT LUWMK1
    N = (PMOS_1 ENCLOSE (GATELV OR GATEMV)) NOT LUWMK1
    (EXT M Y < 3.2 ABUT<90 SINGULAR REGION) NOT EXCLU
    (EXT X N < 3.2 ABUT<90 SINGULAR REGION) NOT EXCLU
}
#ENDIF
LU_S_4_NTAP_G {
    @ Maximum space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (Fig. 7.3.10-2)
    @ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted.<= 35 Âµm
    A = INT NTAP < 0.005 ABUT INTERSECTING ONLY REGION
    B = (NTAP INTERACT A) NOT A
    C = INT B < 0.001 ABUT INTERSECTING ONLY REGION
    D = (B INTERACT C) NOT C
    NW_MINUS_NTAP_0 = SIZE D BY 15 INSIDE OF NW STEP 0.38 TRUNCATE 0.1
    MAYBE_BAD_b = NW NOT NW_MINUS_NTAP_0
    NW_FILTER = NW INTERACT MAYBE_BAD_b
    NW_MINUS_NTAP_1 = NW_MINUS_NTAP_0 AND NW_FILTER
    NW_MINUS_NTAP = SIZE NW_MINUS_NTAP_1 BY 20 INSIDE OF NW_FILTER STEP 0.38 TRUNCATE 0.1
    X = PMOS1 AND NW_FILTER
    (OUTSIDE EDGE X NW_MINUS_NTAP) NOT INSIDE EDGE EXCLU
}
LU_S_4_PTAP_G {
    @ Maximum space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (Fig. 7.3.10-2)
    @ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted.<= 35 Âµm
    A = INT PTAP < 0.005 ABUT INTERSECTING ONLY REGION
    B = (PTAP INTERACT A) NOT A
    C = INT B < 0.001 ABUT INTERSECTING ONLY REGION
    D = (B INTERACT C) NOT C
    PW_MINUS_PTAP_0 = SIZE D BY 15 INSIDE OF PW STEP 0.38 TRUNCATE 0.1
    MAYBE_BAD_b = PW NOT PW_MINUS_PTAP_0
    PW_FILTER = PW INTERACT MAYBE_BAD_b
    PW_MINUS_PTAP_1 = PW_MINUS_PTAP_0 AND PW_FILTER
    PW_MINUS_PTAP = SIZE PW_MINUS_PTAP_1 BY 20 INSIDE OF PW_FILTER STEP 0.38 TRUNCATE 0.1
    X = NMOS1 AND PW_FILTER
    (OUTSIDE EDGE X PW_MINUS_PTAP) NOT INSIDE EDGE EXCLU
}
#ENDIF
GROUP GSRCK SRCK_?
Die_corner = INT (MARKS OR (HOLES MARKS INNER)) <= 25 ABUT == 90 REGION
SRCK_W_1a_1b {
    @ SRCK_W_1a: Fixed CT slot width = 0.09um
    @ SRCK_W_1b: 45 degree CT slot width = 0.09~0.09*â2um
    CT_V_edge = ANGLE CTS_SL == 90
    CT_H_edge = ANGLE CTS_SL == 0
    CT_D_edge = ANGLE CTS_SL > 44.9 < 45.1
    (INT CTS_SL < 0.09 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCLUi
    X_V = INT CT_V_edge < 10 ABUT < 90 OPPOSITE REGION
    X_H = INT CT_H_edge < 10 ABUT < 90 OPPOSITE REGION
    X_D = INT CT_D_edge < 10 ABUT < 90 OPPOSITE REGION
    (X_V WITH WIDTH > 0.09) NOT INSIDE EXCLUi
    (X_H WITH WIDTH > 0.09) NOT INSIDE EXCLUi
    (X_D WITH WIDTH > 0.127) NOT INSIDE EXCLUi
}
