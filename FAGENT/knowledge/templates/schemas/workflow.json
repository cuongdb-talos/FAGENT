{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task",
    "version",
    "inputs"
  ],
  "anyOf": [
    {
      "required": [
        "nodes"
      ]
    },
    {
      "required": [
        "steps"
      ]
    }
  ],
  "properties": {
    "request_builder": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*:[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "action": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "next": {
            "type": "string"
          },
          "continue": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "router": {
            "type": "string"
          },
          "routes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "next"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "routes"
                  ]
                },
                {
                  "required": [
                    "router"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "router",
              "routes"
            ],
            "not": {
              "required": [
                "next"
              ]
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "action": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "next": {
            "type": "string"
          },
          "continue": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "router": {
            "type": "string"
          },
          "routes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "next"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "routes"
                  ]
                },
                {
                  "required": [
                    "router"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "router",
              "routes"
            ],
            "not": {
              "required": [
                "next"
              ]
            }
          }
        ]
      }
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "review_prompt": {
      "type": "string",
      "minLength": 1
    },
    "review_schema": {
      "type": "string",
      "minLength": 1
    },
    "prepare": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "mock_pass": {
      "type": "boolean"
    },
    "layout_services": {
      "type": "boolean"
    },
    "knowledge_review": {
      "type": "boolean"
    },
    "entry": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
