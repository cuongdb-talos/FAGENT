{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task",
    "version",
    "inputs",
    "steps"
  ],
  "properties": {
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "next"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "string"
          },
          "continue": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "review_prompt": {
      "type": "string",
      "minLength": 1
    },
    "review_schema": {
      "type": "string",
      "minLength": 1
    },
    "prepare": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "mock_pass": {
      "type": "boolean"
    },
    "layout_services": {
      "type": "boolean"
    },
    "knowledge_review": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
