{
  "chat_backend": "openai",
  "base_url": "https://api.tokenlab.amd.com/v1",
  "agent_model_path": "DeepSeek-V4-Flash",
  "api_key_env": "TOKENLAB_API_KEY",
  "embedding_model_path": "<path-to-local-embedding-model.gguf>",
  "embedding_n_ctx": 8192,
  "embedding_n_threads": null,
  "embedding_n_gpu_layers": 0,
  "embedding_batch_size": 16,
  "max_iterations": 20,
  "rag_limit": 5,
  "rag_context_chars": 8000,
  "system_prompt_file": "knowledge/templates/prompts/drc_site.md"
}
